{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev:api"],
      "port": 4000
    },
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev:web"],
      "port": 3000
    },
    {
      "name": "engine",
      "runtimeExecutable": "sh",
      "runtimeArgs": ["-c", "cd optimization-engine && .venv/bin/uvicorn app.main:app --reload --port 8000"],
      "port": 8000
    },
    {
      "name": "mobile",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev:mobile"],
      "port": 8081
    }
  ]
}
