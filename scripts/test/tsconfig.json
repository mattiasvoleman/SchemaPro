{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "incremental": false,
    "declaration": false,
    "sourceMap": false,
    "types": ["node"],
    // The probes are scripts that import the gateway's own services and run them against a
    // database. What this typecheck is for is a renamed export or a changed signature, which
    // otherwise first shows up as a TypeError in the Database job; an unused local in a
    // throwaway probe is not worth a red build.
    "noUnusedLocals": false,
    "noUnusedParameters": false
  },
  // The demo school's seed and its reset, and the högstadium seed, are scripts the probes import and operators run (ts-node --transpile-only): without this a renamed
  // import or a changed signature in them is a TypeError on the day somebody resets, not a red build.
  "include": ["./**/*.ts", "../../prisma/seed.ts", "../../prisma/seed-hogstadium.ts", "../../prisma/demo-school.ts", "../../prisma/demo-reset.ts"],
  // An `exclude` is inherited whole, and the root's leaves out `test` and the specs the
  // probes may import; nothing the includes reach needs leaving out.
  "exclude": []
}
