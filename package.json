{
  "name": "schemapro-api",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0",
    "npm": "^11"
  },
  "description": "Secure API layer & masking proxy (NestJS) for the AI-driven school scheduling & attendance system. Multi-tenant, RLS-aware Prisma gateway between clients and the Python AI engine.",
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main.js",
    "lint": "eslint \"{src,test}/**/*.ts\" --max-warnings=0",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "typecheck:test": "tsc --noEmit -p test/tsconfig.json",
    "test": "TZ=UTC jest",
    "test:unit": "TZ=UTC jest --selectProjects unit",
    "test:watch": "TZ=UTC jest --selectProjects unit --watch",
    "test:cov": "TZ=UTC jest --coverage --runInBand",
    "test:mutation": "npm install --no-save --no-audit --no-fund @stryker-mutator/core@^9 @stryker-mutator/jest-runner@^9 && stryker run",
    "test:e2e": "TZ=UTC jest --selectProjects e2e --runInBand",
    "prisma:generate": "prisma generate",
    "prisma:format": "prisma format",
    "prisma:validate": "prisma validate",
    "migrate:dev": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "migrate:status": "prisma migrate status",
    "db:seed": "ts-node --transpile-only prisma/seed.ts",
    "studio": "prisma studio",
    "dev:api": "npm run start:dev",
    "dev:web": "npm run dev --prefix web",
    "dev:mobile": "npm run start --prefix mobile",
    "dev:engine": "cd optimization-engine && uvicorn app.main:app --reload --port 8000",
    "test:web": "npm run test --prefix web",
    "test:mobile": "npm run test --prefix mobile",
    "test:mobile:cov": "npm run test:cov --prefix mobile",
    "test:a11y": "npx --prefix web playwright test --project=a11y",
    "test:visual": "npx --prefix web playwright test --project=visual --project=visual-mobile",
    "test:visual:update": "npx --prefix web playwright test --project=visual --project=visual-mobile --update-snapshots",
    "test:engine": "cd optimization-engine && python -m pytest",
    "test:engine:cov": "cd optimization-engine && python -m pytest --cov=app --cov-report=term-missing",
    "bench:bundle": "node scripts/bench/bundle-size.mjs",
    "bench:bundle:flat": "node scripts/bench/bundle-size.mjs --max-kb 150",
    "bench:latency": "npm install --no-save --no-audit --no-fund autocannon@^8 && node scripts/bench/api-latency.mjs",
    "bench:solver": "cd optimization-engine && PYTHONPATH=. python benchmarks/solve_2000_students.py --students 2000 --assert-under 10",
    "bench:lighthouse": "npm exec --prefix web --yes -- @lhci/cli@^0.14 autorun --config=web/lighthouserc.json",
    "verify": "npm run typecheck && npm run typecheck:test && npm run test:cov"
  },
  "dependencies": {
    "@nestjs/axios": "^4.0.1",
    "@nestjs/common": "^11.1.12",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.12",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.12",
    "@nestjs/platform-socket.io": "^11.1.12",
    "@nestjs/throttler": "^6.4.0",
    "@nestjs/websockets": "^11.1.12",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@supabase/supabase-js": "^2.110.1",
    "axios": "^1.20.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "jwks-rsa": "^4.1.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.3",
    "uuid": "^14.0.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.1.12",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.16.10",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^6.0.3",
    "@types/uuid": "^10.0.0",
    "jest": "^29.7.0",
    "prisma": "7.10.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.11",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.6.2"
  },
  "overrides": {
    "brace-expansion@^1.0.0": "1.1.21",
    "brace-expansion@^5.0.0": "5.0.12",
    "deepmerge-ts": "8.0.2",
    "engine.io": "6.6.11",
    "fast-uri": "3.1.8",
    "multer": "2.4.0",
    "mysql2": "3.24.4"
  }
}
