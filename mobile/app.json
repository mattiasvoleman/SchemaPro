{
  "expo": {
    "name": "Rastra",
    "slug": "rastra",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "rastra",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/images/icon.png",
    "backgroundColor": "#0f0f1a",
    "locales": {
      "sv": "./locales/sv.json",
      "en": "./locales/en.json"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "defaultChannel": "default",
          "color": "#6366f1"
        }
      ],
      "expo-local-authentication",
      [
        "expo-sqlite",
        {
          "enableFTS": true,
          "useSQLCipher": true
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 128,
          "resizeMode": "contain",
          "backgroundColor": "#f4f4f5",
          "dark": {
            "backgroundColor": "#0f0f1a"
          }
        }
      ],
      [
        "./plugins/withNightWindowBackground",
        {
          "light": "#f4f4f5",
          "dark": "#0f0f1a"
        }
      ]
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "se.rastra.app",
      "icon": {
        "light": "./assets/images/icon.png",
        "dark": "./assets/images/icon-dark.png",
        "tinted": "./assets/images/icon-tinted.png"
      },
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "CFBundleDevelopmentRegion": "sv",
        "CFBundleLocalizations": [
          "sv",
          "en"
        ],
        "CFBundleAllowMixedLocalizations": true,
        "NSFaceIDUsageDescription": "Rastra ber om Face ID innan närvaron skickas, så att den inte kan skickas från en olåst enhet som ligger framme. Appen får bara veta om det lyckades."
      }
    },
    "android": {
      "package": "se.rastra.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "monochromeImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#5048e5"
      },
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "com.google.android.gms.permission.AD_ID"
      ]
    },
    "experiments": {
      "typedRoutes": true
    }
  }
}
