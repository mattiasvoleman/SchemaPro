# Every install of this package resolves peers the way CI does (npm ci
# --legacy-peer-deps). react-native-drawer-layout, which expo-router depends
# on, requires react-native-gesture-handler and react-native-reanimated as
# peers, and the app uses neither. Without this file npm would install their
# latest versions (not the SDK's) and Expo would autolink them, and `npm ci`
# refuses this lockfile. EAS Build runs a plain `npm ci`, which reads this file.
legacy-peer-deps=true

# A version published less than seven days ago is not resolved (npm 11.10 and
# later; older npm ignores the key). A hijacked package is usually caught and
# pulled within days, and the app's dependencies are only ever added or
# upgraded on purpose, so waiting costs nothing. `npm ci` installs the
# lockfile as it is and is not affected. `npx <package>@<version>` run in
# mobile/ is, and so is eas-cli's own npx of its local build plugin. So
# install a CLI globally, where this file does not apply, and run `eas build
# --local` with NPM_CONFIG_MIN_RELEASE_AGE=0 (docs/DEPLOYMENT.md §12.2).
min-release-age=7
