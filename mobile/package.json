{
  "name": "schemapro-mobile",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "APP=rastra APP_VARIANT=development expo start",
    "start:vardnadshavare": "APP=vardnadshavare APP_VARIANT=development expo start --scheme rastra-vardnadshavare-dev",
    "android": "APP=rastra APP_VARIANT=development expo run:android",
    "android:vardnadshavare": "APP=vardnadshavare APP_VARIANT=development expo run:android",
    "ios": "APP=rastra APP_VARIANT=development expo run:ios",
    "ios:vardnadshavare": "APP=vardnadshavare APP_VARIANT=development expo run:ios",
    "typecheck": "tsc --noEmit",
    "test": "TZ=UTC jest",
    "test:cov": "TZ=UTC jest --coverage",
    "eas-build-pre-install": "[ \"$EAS_BUILD_RUNNER\" != eas-build ] || npm install -g npm@11"
  },
  "dependencies": {
    "@shopify/flash-list": "2.0.2",
    "@supabase/supabase-js": "^2.110.1",
    "decode-uri-component": "file:vendor/decode-uri-component",
    "expo": "~57.0.30",
    "expo-constants": "~57.0.22",
    "expo-crypto": "~57.0.4",
    "expo-dev-client": "~57.0.20",
    "expo-linking": "~57.0.13",
    "expo-local-authentication": "~57.0.3",
    "expo-network": "~57.0.2",
    "expo-notifications": "~57.0.23",
    "expo-router": "~57.0.28",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.10",
    "expo-sqlite": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "expo-web-browser": "~57.0.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-url-polyfill": "^3.0.0",
    "socket.io-client": "^4.7.5"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@react-native/jest-preset": "0.86.3",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.20.5",
    "@types/react": "~19.2.4",
    "@types/react-test-renderer": "19.1.0",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.6",
    "react-test-renderer": "19.2.3",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "brace-expansion@^1.0.0": "1.1.21",
    "brace-expansion@^2.0.0": "2.1.7",
    "brace-expansion@^5.0.0": "5.0.12",
    "compression": "1.8.2",
    "decode-uri-component": "$decode-uri-component",
    "shell-quote": "1.11.0",
    "source-map-js": "1.2.2",
    "xcode": {
      "uuid": "^14.0.1"
    }
