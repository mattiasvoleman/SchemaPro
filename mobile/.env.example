# ─────────────────────────────────────────────────────────────
# SchemaPro Mobile — Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.
#
# For local development (expo start) only. Preview and production builds
# take their EXPO_PUBLIC_* values from the EAS environment of the same name;
# `eas env:pull --environment development` writes a .env.local for local
# work. APP_VARIANT picks the build variant (see app.config.ts).
# ─────────────────────────────────────────────────────────────

# Base URL of the NestJS gateway (no trailing slash)
# Example: https://api.schemapro.internal
EXPO_PUBLIC_API_BASE_URL=

# WebSocket server URL for real-time schedule events
# Example: wss://api.schemapro.internal
EXPO_PUBLIC_WS_BASE_URL=

# Supabase project (public values — auth + RLS reads)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Push needs no variable here. The EAS project id lives in app.json, written
# by `eas init`; push needs the native credentials in docs/DEPLOYMENT.md §12.

# "Logga in med skolkonto": "on" shows the button in this build. Build with it
# on once the access-token hook and the providers are set up, and publish the
# build before the API's SCHOOL_ACCOUNTS is turned on (docs/DEPLOYMENT.md
# §11.1). schemapro://auth/callback must be in Supabase's redirect URLs.
EXPO_PUBLIC_SCHOOL_ACCOUNTS=
