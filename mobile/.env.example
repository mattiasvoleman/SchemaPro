# ─────────────────────────────────────────────────────────────
# SchemaPro Mobile — Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.
# ─────────────────────────────────────────────────────────────

# Base URL of the NestJS gateway (no trailing slash)
# Example: https://api.schemapro.internal
EXPO_PUBLIC_API_BASE_URL=

# WebSocket server URL for real-time schedule events
# Example: wss://api.schemapro.internal
EXPO_PUBLIC_WS_BASE_URL=

# Supabase project (public values — auth + RLS reads)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# EAS project id, for push notifications (expo-notifications asks Expo for
# this install's push token with it). Empty: the app runs as before and
# Settings says this build cannot receive push. Push also needs the gateway's
# PUSH_NOTIFICATIONS=expo and a native build with FCM V1 / APNs credentials —
# see docs/DEPLOYMENT.md §8.1.
EXPO_PUBLIC_EAS_PROJECT_ID=
