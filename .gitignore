coverage/
reports/
.stryker-tmp/
optimization-engine/.coverage
optimization-engine/coverage.xml

# Agent worktrees (full repo checkouts — 2.3G here) and machine-local settings.
.claude/worktrees/
.claude/settings.local.json

# OS / editor
.DS_Store
*.log

# Python optimization engine
optimization-engine/.venv/
optimization-engine/__pycache__/
optimization-engine/**/__pycache__/
optimization-engine/.pytest_cache/
optimization-engine/.env
