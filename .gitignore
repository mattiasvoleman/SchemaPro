node_modules/
dist/
build/

# Secrets — never commit real credentials
.env
.env.*
!.env.example

# Prisma
/prisma/*.db
/prisma/*.db-journal

# Verification harness output — regenerated by `npm run test:cov`,
# `npm run test:mutation` and the benchmark scripts. Never committed; the
# numbers that matter are recorded in docs/verification-baseline.md.
coverage/
reports/
# …but not the admin's Rapporter page, which is source: a file added beside
# its page.tsx was silently left out of a commit (staffing Fas 3, 2026-10-09).
!/web/app/**/admin/reports/
.stryker-tmp/
optimization-engine/.coverage
optimization-engine/coverage.xml

# Agent worktrees (full repo checkouts — 2.3G here) and machine-local settings.
.claude/worktrees/
.claude/settings.local.json

# iCloud Drive conflict copies ("migration 2.sql", "pdf 3.ts").
#
# This repo currently lives under ~/Desktop, which iCloud syncs. During heavy
# file churn iCloud duplicates files with a " N" suffix; four of them reached
# committed history once, including one inside a Prisma migration directory.
# It has also corrupted .git/refs, which breaks GitHub Desktop.
#
# The real fix is to move the repo out of the synced folder. Until then this
# keeps the copies out of commits. Verified against the tree: no legitimate
# file matches this pattern.
* [0-9].*
* [0-9]

# OS / editor
.DS_Store
*.log

# Python optimization engine
optimization-engine/.venv/
optimization-engine/__pycache__/
optimization-engine/**/__pycache__/
optimization-engine/.pytest_cache/
optimization-engine/.env
