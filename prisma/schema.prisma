// =============================================================================
// SchemaPro — AI-driven school scheduling & attendance system
// PostgreSQL data layer (Prisma ORM)
//
// Design principles (see .cursorrules):
//   * Privacy by Design: every primary/foreign key is an anonymized UUIDv4 so
//     that only opaque identifiers ever reach the Python AI engine. PII lives
//     exclusively on the `Users` table and is masked at the NestJS gateway.
//   * Multi-tenancy: every table carries `schoolId` so PostgreSQL Row-Level
//     Security can partition data per school cheaply (see migration.sql).
//   * Performance: indexes are tuned for date/time range scans of the calendar.
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// -----------------------------------------------------------------------------
// Enums
// -----------------------------------------------------------------------------

enum UserRole {
  STUDENT
  TEACHER
  SCHOOL_ADMIN
  GUARDIAN
}

enum AbsenceReportType {
  SICK
  APPOINTMENT
  OTHER
}

enum LeaveRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum NotificationType {
  ABSENCE_UNREPORTED
  LEAVE_DECIDED
  LESSON_CANCELLED
  LESSON_SUBSTITUTE
  LESSON_ROOM_CHANGED
  SCHEDULE_CHANGED
  ROOM_BOOKING_DECIDED
}

enum RoomBookingStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum LessonStatus {
  SCHEDULED
  CANCELLED
  COMPLETED
  RESCHEDULED
}

enum AttendanceStatus {
  UNKNOWN
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum TeacherAssignmentRole {
  LEAD
  ASSISTANT
  SUBSTITUTE
}

enum ConstraintResource {
  TEACHER
  ROOM
  STUDENT_GROUP
  /// Not a row anywhere: a year is a property of a group's members, so a
  /// GRADE_LEVEL constraint points at no resource at all and carries
  /// `minGradeLevel`/`maxGradeLevel` instead.
  GRADE_LEVEL
}

enum ConstraintType {
  UNAVAILABLE
  PREFERRED_FREE
  PREFERRED_BUSY
}

enum ScheduleChangeAction {
  CREATE
  UPDATE
  DELETE
  REGENERATE
  RESTORE
}

enum OptimizationJobStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
}

// -----------------------------------------------------------------------------
// Tenant root
// -----------------------------------------------------------------------------

model School {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  slug      String   @unique
  timezone  String   @default("Europe/Stockholm")
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  users                   User[]
  rooms                   Room[]
  roomTypes               RoomType[]
  subjects                Subject[]
  academicYears           AcademicYear[]
  studentGroups           StudentGroup[]
  teachingRequirements    TeachingRequirement[]
  masterLessons           MasterLesson[]
  calendarLessons         CalendarLesson[]
  calendarLessonTeachers  CalendarLessonTeacher[]
  attendanceRecords       AttendanceRecord[]
  availabilityConstraints AvailabilityConstraint[]
  schoolBreaks            SchoolBreak[]
  frameTimes              FrameTime[]
  rasts                   Rast[]
  lunchServings           LunchServing[]
  lunchSittings           LunchSitting[]
  calendarLunches         CalendarLunch[]
  calendarRasts           CalendarRast[]
  scheduleChangeLogs      ScheduleChangeLog[]
  scheduleVersions        ScheduleVersion[]
  optimizationJobs        OptimizationJob[]
  guardianStudents        GuardianStudent[]
  absenceReports          AbsenceReport[]
  leaveRequests           LeaveRequest[]
  notifications           Notification[]
  integrationApiKeys      IntegrationApiKey[]
  roomBookings            RoomBooking[]
  roomPreferences         RoomPreference[]
  teacherWorkRules        TeacherWorkRule[]
  lunchSetting            LunchSetting?

  @@map("Schools")
}

// -----------------------------------------------------------------------------
// Users (the ONLY table that stores PII)
// -----------------------------------------------------------------------------

model User {
  id       String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId String   @db.Uuid
  // `authId` is the Supabase Auth user id (auth.users.id == JWT sub == auth.uid()).
  authId   String   @unique @db.Uuid
  role     UserRole

  // --- PII (masked at the NestJS gateway, never sent to the AI engine) ---
  firstName String
  lastName  String
  email     String
  phone     String?
  // ----------------------------------------------------------------------

  isActive  Boolean   @default(true)
  // When the invitation email was last sent. NULL means the person exists in
  // the school's catalog but has never been contacted — `authId` is then a
  // placeholder that matches no Supabase identity, so they cannot sign in
  // until an admin chooses to invite them.
  invitedAt DateTime? @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)

  school         School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  // A student's primary group (null for teachers/admins).
  //
  // Not visible here, and load-bearing: a CHECK refuses a group on any other
  // role, because app.current_user_group_id() hands whoever holds one the
  // pupils' read path. Prisma cannot express it — see migration
  // 20260914120000_bara_en_elev_har_en_klass.
  studentGroupId String?       @db.Uuid
  studentGroup   StudentGroup? @relation("StudentGroupMembers", fields: [studentGroupId], references: [id], onDelete: SetNull)

  // Relations where this user acts as a teacher.
  teachingRequirements    TeachingRequirement[]    @relation("RequirementTeacher")
  coTeachingRequirements  TeachingRequirement[]    @relation("RequirementCoTeacher")
  masterLessons           MasterLesson[]           @relation("MasterLessonTeacher")
  coMasterLessons         MasterLesson[]           @relation("MasterLessonCoTeacher")
  calendarLessonTeachers  CalendarLessonTeacher[]  @relation("AssignedTeacher")
  recordedAttendance      AttendanceRecord[]       @relation("AttendanceRecorder")
  availabilityConstraints AvailabilityConstraint[] @relation("ConstraintTeacher")
  /// At most one row, which the database enforces with @@unique([userId]) on
  /// the other side. A list rather than an optional single relation because the
  /// key is composite — (userId, schoolId), like every other reference here —
  /// and Prisma reads a one-to-one off the key's own uniqueness, which a unique
  /// on one of its two columns does not give it.
  workRules               TeacherWorkRule[]        @relation("WorkRuleTeacher")

  // Relations where this user is the student.
  attendanceRecords   AttendanceRecord[]      @relation("AttendanceStudent")
  masterLessonJoins   MasterLessonStudent[]   @relation("MasterLessonParticipant")
  groupMemberships    StudentGroupMember[]    @relation("TeachingGroupStudent")
  calendarLessonJoins CalendarLessonStudent[] @relation("CalendarLessonParticipant")

  // Guardian <-> student relations.
  guardianLinks       GuardianStudent[] @relation("GuardianSide")
  studentLinks        GuardianStudent[] @relation("StudentSide")
  absenceReports      AbsenceReport[]   @relation("AbsenceStudent")
  reportedAbsences    AbsenceReport[]   @relation("AbsenceReporter")
  leaveRequests       LeaveRequest[]    @relation("LeaveStudent")
  requestedLeaves     LeaveRequest[]    @relation("LeaveRequester")
  decidedLeaves       LeaveRequest[]    @relation("LeaveDecider")
  notifications       Notification[]    @relation("NotificationRecipient")
  roomBookings        RoomBooking[]     @relation("RoomBookingBooker")
  decidedRoomBookings RoomBooking[]     @relation("RoomBookingDecider")

  @@unique([schoolId, email])
  /// The target a tenant-scoped composite foreign key needs. Redundant as an
  /// index — id is already the primary key — and load-bearing as a constraint:
  /// without it no other table can reference (id, schoolId) at all.
  @@unique([id, schoolId])
  @@index([schoolId])
  @@index([schoolId, role])
  @@index([studentGroupId])
  @@map("Users")
}

// -----------------------------------------------------------------------------
// Physical resources
// -----------------------------------------------------------------------------

/// Room types a school defines for itself. The scheduler matches a subject's
/// required type against a room's type by identity, so these are rows rather
/// than free text: a typo cannot make a subject unschedulable.
model RoomType {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId  String   @db.Uuid
  name      String
  /// Stable identity for the six values that were enum members before the
  /// school-owned model; null for types a school created itself.
  legacyKey String?
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  school          School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  rooms           Room[]
  subjects        Subject[]
  roomPreferences RoomPreference[]

  @@unique([schoolId, name])
  @@index([schoolId])
  @@map("RoomTypes")
}

model Room {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId         String   @db.Uuid
  name             String
  code             String?
  capacity         Int?
  /// School-owned type (Klassrum, Hemkunskapssal, Trä- och metallslöjd …).
  /// Null means "unspecified", which every requirement accepts.
  roomTypeId       String?  @db.Uuid
  /// Lowest and highest year group allowed in this room, inclusive. Both null
  /// means every year may use it. A school uses these to keep a stage's rooms
  /// to that stage: lågstadiet 0–3, mellanstadiet 4–6, högstadiet 7–9.
  ///
  /// A group's own years are derived from its students' home classes, so a
  /// teaching group carrying no gradeLevel of its own is still held to the
  /// years its members actually belong to.
  minGradeLevel    Int?
  maxGradeLevel    Int?
  /// Where the room is, for the room optimisation: a teacher who walks from
  /// one lesson to the next pays for changing room, more for changing floor
  /// and most for changing building. Both optional, and a school that fills in
  /// neither still has its room changes counted.
  ///
  /// A null building is a building of its own, not a wildcard: a school that
  /// names only its annex means every unnamed room is in the main house, and
  /// the annex is a walk away from all of them. A null floor is unknown and
  /// is never counted as a floor change — guessing would charge a walk the
  /// school never described. The database holds the floor to -5..50 and a
  /// building name to 1..60 characters after trimming.
  building         String?
  floor            Int?
  /// "Special" rooms (labs, gyms, auditoria) whose self-service bookings need
  /// admin approval before they're confirmed. Ordinary rooms auto-approve.
  requiresApproval Boolean  @default(false)
  createdAt        DateTime @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @db.Timestamptz(6)

  school                  School                   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  roomType                RoomType?                @relation(fields: [roomTypeId], references: [id], onDelete: Restrict)
  masterLessons           MasterLesson[]
  calendarLessons         CalendarLesson[]
  availabilityConstraints AvailabilityConstraint[]
  roomBookings            RoomBooking[]
  preferenceRooms         RoomPreferenceRoom[]

  @@unique([schoolId, name])
  /// The target a tenant-scoped composite foreign key needs; see User.
  @@unique([id, schoolId])
  @@index([schoolId])
  @@index([roomTypeId])
  @@map("Rooms")
}

model Subject {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId           String   @db.Uuid
  name               String
  code               String?
  color              String?
  /// When set, the optimizer only places this subject in rooms of this type.
  requiredRoomTypeId String?  @db.Uuid
  /// Which cell of the national timplan this school subject feeds — 'MA',
  /// 'SV_SVA' (one cell for Svenska and SvA alike), 'BI' under NO. Null means
  /// "outside the national timplan": mentorstid, a local profile. A school
  /// names its subjects freely ("Matte 7-9") and may split one national cell
  /// across several rows, so the mapping is a column here and the DB enforces
  /// only that the code is a known one (FK to NationalSubject).
  nationalCode       String?
  /// False for the subjects a school schedules that are not undervisning in
  /// the statute's sense — Resurs, Studiehandledning — so they never pollute a
  /// timplan sum. Default true: an existing school sees no change.
  countsTowardTimplan Boolean @default(true)
  createdAt          DateTime @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime @updatedAt @db.Timestamptz(6)

  school               School                @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  requiredRoomType     RoomType?             @relation(fields: [requiredRoomTypeId], references: [id], onDelete: Restrict)
  nationalSubject      NationalSubject?      @relation(fields: [nationalCode], references: [code], onDelete: Restrict)
  teachingRequirements TeachingRequirement[]
  masterLessons        MasterLesson[]
  calendarLessons      CalendarLesson[]
  roomPreferences      RoomPreference[]

  @@unique([schoolId, code])
  /// The target a tenant-scoped composite foreign key needs; see User.
  @@unique([id, schoolId])
  @@index([schoolId])
  @@map("Subjects")
}

// -----------------------------------------------------------------------------
// The national timplan — reference data, NO schoolId
//
// Skolförordningen (2011:185) bilaga 1–4 as rows: one version per bilaga per
// lydelse, one subject per ämne the bilagor name, one entry per printed cell.
// These are the only tables here without `schoolId`, and on purpose: the rows
// belong to nobody, they are the law, identical for every tenant and written
// only by a migration (which also re-adds the statute's printed totals and
// refuses the deploy on a mismatch). RLS: SELECT for every authenticated role,
// no write policy and no write grant for any API role — the posture of
// `_prisma_migrations`, turned the other way. See the migration
// 20261006090000 for the shape of a cell and every argued decision.
// -----------------------------------------------------------------------------

/// Which bilaga a version is. The statute keeps five timplaner: grundskolan
/// (bilaga 1), anpassade grundskolan twice (bilaga 2: ämnen and ämnesområden),
/// specialskolan (3) and sameskolan (4).
enum SchoolForm {
  GRUNDSKOLA
  ANPASSAD_GRUNDSKOLA_AMNEN
  ANPASSAD_GRUNDSKOLA_AMNESOMRADEN
  SPECIALSKOLA
  SAMESKOLA
}

/// The stadium a cell is printed under. LAG_MELLAN is the merged "Låg- och
/// mellanstadiet" column hem- och konsumentkunskap is printed in: one cell in
/// the statute, so one row here, and never beside a LAG or MELLAN row for the
/// same ämne.
enum TimplanStage {
  LAG
  MELLAN
  HOG
  LAG_MELLAN
}

model NationalTimplanVersion {
  id                    String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// 'SFS2023:945/B1': the författning the figures are the lydelse of, and the
  /// bilaga — three bilagor share SFS 2023:945, so the SFS alone is no key.
  code                  String     @unique
  sfs                   String
  title                 String
  schoolForm            SchoolForm
  /// "Totalt garanterat antal timmar" — 6 890, 6 665, 8 070, 4 473; 7 424 for
  /// the 2028 law.
  totalHours            Int
  /// "Därav skolans val". Null where the bilaga prints no such row.
  skolansValHours       Int?
  /// "minskas med högst 20 procent" — 15 in sameskolan; null where the
  /// statute states no percentage (anpassade grundskolan, the 2028 law).
  reductionCapPercent   Int?
  /// 'HT2024': the term from which utbildning som påbörjas falls under this
  /// lydelse. Cohort-scoped, not calendar-scoped: åk 7–9 in 2024/25 still read
  /// the older bilaga 1.
  appliesFromCohortTerm String
  supersededByCode      String?
  createdAt             DateTime   @default(now()) @db.Timestamptz(6)

  supersededBy NationalTimplanVersion?  @relation("TimplanSupersession", fields: [supersededByCode], references: [code], onDelete: Restrict)
  supersedes   NationalTimplanVersion[] @relation("TimplanSupersession")
  entries      NationalTimplanEntry[]

  @@map("NationalTimplanVersions")
}

/// An ämne the bilagor name. NO and SO are ämnesgrupper (`isGroup`) with
/// biologi/fysik/kemi and geografi/historia/religionskunskap/samhällskunskap
/// as children; "svenska eller svenska som andraspråk" is ONE row, SV_SVA,
/// because it is one cell.
model NationalSubject {
  code       String  @id
  name       String
  parentCode String?
  isGroup    Boolean @default(false)

  parent   NationalSubject?  @relation("NationalSubjectGroup", fields: [parentCode], references: [code], onDelete: Restrict)
  children NationalSubject[] @relation("NationalSubjectGroup")
  entries  NationalTimplanEntry[]
  subjects Subject[]

  @@map("NationalSubjects")
}

/// One printed cell. On a top-level ämne `hours` is the guaranteed figure; on
/// a child of an ämnesgrupp it is the minimum printed on that child's own line,
/// and the group's hours minus its children's is the "resterande N timmar får
/// fördelas fritt" — so children are never added to a total.
model NationalTimplanEntry {
  id                     String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  versionId              String       @db.Uuid
  subjectCode            String
  stage                  TimplanStage
  hours                  Int
  /// The uniform per-child minimum the prose states for an ämnesgrupp cell
  /// ("en minsta undervisningstid om 60 timmar i respektive ämne"); null where
  /// the minima differ per child (every SO cell) and on every leaf.
  minimumHoursPerChild   Int?
  /// "Antalet timmar för ... får dock inte minskas": svenska/SvA, engelska,
  /// matematik and språkval, plus samiska in sameskolan.
  protectedFromReduction Boolean      @default(false)

  version NationalTimplanVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  subject NationalSubject        @relation(fields: [subjectCode], references: [code], onDelete: Restrict)

  @@unique([versionId, subjectCode, stage])
  @@map("NationalTimplanEntries")
}

model AcademicYear {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId  String   @db.Uuid
  name      String
  startDate DateTime @db.Date
  endDate   DateTime @db.Date
  isActive  Boolean  @default(false)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  school               School                @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  studentGroups        StudentGroup[]
  teachingRequirements TeachingRequirement[]
  masterLessons        MasterLesson[]
  schoolBreaks         SchoolBreak[]
  lunchSittings        LunchSitting[]

  @@unique([schoolId, name])
  /// The target a tenant-scoped composite foreign key needs; see User.
  @@unique([id, schoolId])
  @@index([schoolId])
  @@index([schoolId, startDate, endDate])
  // Not stated here, because schema.prisma cannot state a partial index: the
  // unique index AcademicYears_one_active_per_school on (schoolId) WHERE
  // isActive, from migration 20260914090000. It is what keeps a school to one
  // active year. Prisma's differ skips it, so a migration generated from this
  // file will never mention it, whether it is there or not.
  @@map("AcademicYears")
}

/// What a group IS, rather than what it happens to contain right now.
///
/// The two were previously told apart by guesswork — "no gradeLevel, so
/// probably a teaching group" — which misfiles a nivågrupp that does carry a
/// year, and files every freshly created teaching group under classes until
/// somebody adds its first member.
enum StudentGroupKind {
  /// A home class: every member follows all of its lessons (7A, 8B).
  CLASS
  /// A teaching group cutting across classes (Ma71, språkval En74).
  TEACHING_GROUP
}

model StudentGroup {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId       String           @db.Uuid
  academicYearId String           @db.Uuid
  name           String
  kind           StudentGroupKind @default(CLASS)
  gradeLevel     Int?
  createdAt      DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime         @updatedAt @db.Timestamptz(6)

  school       School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)

  // Home-class members (User.studentGroupId points here).
  members                 User[]                   @relation("StudentGroupMembers")
  // Teaching-group members: students whose HOME class is another group but who
  // take this group's subject lessons (nivågrupper, språkval). A group used as
  // a plain class has none of these.
  teachingMembers         StudentGroupMember[]     @relation("TeachingGroupGroup")
  teachingRequirements    TeachingRequirement[]
  masterLessons           MasterLesson[]
  calendarLessons         CalendarLesson[]
  availabilityConstraints AvailabilityConstraint[] @relation("ConstraintGroup")
  extraMasterLessons      MasterLessonGroup[]      @relation("MasterLessonExtraGroup")
  extraCalendarLessons    CalendarLessonGroup[]    @relation("CalendarLessonExtraGroup")
  lunchSittings           LunchSitting[]
  calendarRasts           CalendarRast[]
  calendarLunches         CalendarLunch[]

  @@unique([schoolId, academicYearId, name])
  /// The target a tenant-scoped composite foreign key needs; see User.
  @@unique([id, schoolId])
  @@index([schoolId])
  @@index([academicYearId])
  @@map("StudentGroups")
}

// -----------------------------------------------------------------------------
// Curriculum / scheduling demand
// -----------------------------------------------------------------------------

model TeachingRequirement {
  id               String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId         String  @db.Uuid
  academicYearId   String  @db.Uuid
  subjectId        String  @db.Uuid
  studentGroupId   String  @db.Uuid
  teacherId        String? @db.Uuid
  /// Optional second teacher — both are scheduled together (co-teaching).
  coTeacherId      String? @db.Uuid
  lessonsPerWeek   Int     @default(1)
  minutesPerLesson Int     @default(60)

  /// Minutes the PUPILS are occupied on either side of the lesson: ombyte
  /// before idrotten, dusch and ombyte after it.
  ///
  /// OUTSIDE THE LESSON. A 60-minute lesson with 10 before and 20 after still
  /// teaches 60 — `minutesPerLesson` is untouched and the timplan still counts
  /// 60 — while the class is unavailable for 90. The numbers do not shorten the
  /// teaching, they say what surrounds it.
  ///
  /// SAID PER REQUIREMENT, which is to say per (class, subject). Not on the
  /// subject, because ombyte is a property of what THIS class does in this
  /// subject: 4.1 walks from the far corridor and 4.2 from the hall next door,
  /// and the same idrott needs different margins for the two. Not per stage
  /// either, for the same reason — the walk is the class's, not the årskurs's.
  ///
  /// ONLY THE PUPILS ARE BLOCKED. Not the teacher, who does not shower with the
  /// class and may teach the slot on either side. Not the room, which stands
  /// empty through both windows — the class is in the omklädningsrummet, not in
  /// the gymnastiksal.
  ///
  /// WHY THIS IS NOT THE CHANGEOVER CORRIDOR (FrameTimes.changeoverMinutes).
  /// That one is a FLOOR ON THE GAP between any two lessons of a stage, and the
  /// solver argues itself down to one end of it: padding both sides turns a
  /// ten-minute rule into a silent twenty, and padding the front makes 08:00 an
  /// illegal start for the first lesson of the day (scheduler_solver.py:103-105,
  /// padded_of). It declines to pad the room at all, because a room needs no
  /// time to become itself again (:3834-3838).
  ///
  /// Neither argument reaches these two columns. A pupil buffer is not one rule
  /// counted twice: ombyte before and dusch after are two different things the
  /// children actually do, each named on its own, so 10 + 20 is thirty minutes
  /// of real occupancy and not a doubled ten. Nor is it a gap the schema may
  /// quietly shrink — 08:00 idrott genuinely means the class is changing at
  /// 07:50, which is the school's answer and not an artefact of the encoding.
  /// The room is left alone here for precisely the reason the solver gives for
  /// its own room arm: nobody is in it.
  ///
  /// 0..60 on each, as CHECK constraints mirroring the DTO's bounds. Default 0,
  /// so nothing changes for any school until somebody writes a number, and the
  /// whole mechanism costs a school that never does exactly nothing.
  minutesBefore Int @default(0)
  minutesAfter  Int @default(0)

  /// Which weeks the requirement is read over, inherited by every lesson the
  /// optimizer generates for it. `lessonsPerWeek` counts weeks the requirement
  /// actually runs, so 2 lessons a week over a spring-only window is two a week
  /// that spring — not two averaged across the year.
  ///
  /// The engine has no concept of weeks (optimization-proxy.service.ts), so it
  /// still packs a windowed requirement as if it ran all year: the window is
  /// stamped on the resulting lessons afterwards. That over-provisions — two
  /// half-year subjects get separate slots where they could have shared one —
  /// which costs packing room and not correctness, and is visible on the
  /// timetable rather than hidden.
  recurrence LessonRecurrence @default(ALL_WEEKS)
  /// First date the requirement is read; null means "from the start of the
  /// year". With endDate this expresses a subject read for one term only.
  startDate  DateTime?        @db.Date
  /// Last date the requirement is read; null means "until the year ends".
  endDate    DateTime?        @db.Date
  createdAt  DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime         @updatedAt @db.Timestamptz(6)

  school       School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  /// Every reference carries `schoolId`, because create() copies all five ids
  /// out of the request and checks none of them, and a foreign-key check runs
  /// as the referenced table's owner with row security off — so an id the
  /// caller cannot even SELECT still validates. The composite keys are what
  /// make a requirement's school the school of its year, subject, group and
  /// teachers.
  academicYear AcademicYear @relation(fields: [academicYearId, schoolId], references: [id, schoolId], onDelete: Cascade)
  subject      Subject      @relation(fields: [subjectId, schoolId], references: [id, schoolId], onDelete: Cascade)
  studentGroup StudentGroup @relation(fields: [studentGroupId, schoolId], references: [id, schoolId], onDelete: Cascade)
  teacher      User?        @relation("RequirementTeacher", fields: [teacherId, schoolId], references: [id, schoolId], onDelete: SetNull)
  coTeacher    User?        @relation("RequirementCoTeacher", fields: [coTeacherId, schoolId], references: [id, schoolId], onDelete: SetNull)

  /// `schoolId` leads the key so the slot a school occupies is its own. Without
  /// it one school's forged row took the (year, group, subject) slot of
  /// another, whose admin then got a 409 creating their real requirement while
  /// seeing no row anywhere that explained it.
  @@unique([schoolId, academicYearId, studentGroupId, subjectId])
  @@index([schoolId])
  @@index([teacherId])
  @@map("TeachingRequirements")
}

// -----------------------------------------------------------------------------
// Master timetable (recurring weekly template the AI engine produces)
// -----------------------------------------------------------------------------

/// Which weeks a lesson actually runs.
///
/// Anchored to ISO week numbers rather than counted from a start date, because
/// that is what a Swedish school says out loud — "slöjd udda veckor" — and it
/// means the same thing whenever anyone looks. A count from the start date
/// would leave nobody able to tell, from a week number alone, whether a given
/// week is an "on" week.
enum LessonRecurrence {
  /// Every week the lesson's period covers.
  ALL_WEEKS
  /// Odd ISO week numbers only.
  ODD_WEEKS
  /// Even ISO week numbers only.
  EVEN_WEEKS
}

model MasterLesson {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId       String   @db.Uuid
  academicYearId String   @db.Uuid
  subjectId      String   @db.Uuid
  studentGroupId String   @db.Uuid
  teacherId      String?  @db.Uuid
  /// Optional second teacher (co-teaching); published as an ASSISTANT assignment.
  coTeacherId    String?  @db.Uuid
  roomId         String?  @db.Uuid
  // ISO weekday: 1 = Monday ... 7 = Sunday.
  dayOfWeek      Int
  startTime      DateTime @db.Time(0)
  endTime        DateTime @db.Time(0)

  recurrence LessonRecurrence @default(ALL_WEEKS)
  /// First date the lesson runs; null means "from the start of the year".
  /// With endDate this expresses a subject read for half a term.
  startDate  DateTime?        @db.Date
  /// Last date the lesson runs; null means "until the year ends".
  endDate    DateTime?        @db.Date

  // Locked lessons survive regeneration untouched: the optimizer treats them
  // as fixed placements and schedules the remaining demand around them.
  isLocked    Boolean  @default(false)
  /// Set aside on the grid's tray. A parked lesson OCCUPIES NOTHING: it is
  /// excluded from every clash check, from publish, from the solver's fixed
  /// placements and from the SS12000 feed. Its day and time survive only as a
  /// memory of where it was, so it can be put back. See the migration.
  isParked    Boolean  @default(false)
  /// True only for lessons the optimizer itself produced, and the one thing
  /// regeneration is allowed to replace.
  ///
  /// Ownership used to be inferred from the lesson looking untouched — default
  /// recurrence, no dates. That held only while nothing but a human ever set
  /// those. Now a generated lesson inherits its requirement's window, so an
  /// inferred rule would read the optimizer's own output as handmade: it would
  /// be preserved, the requirement would still count as unmet, and the next
  /// regeneration would stack another copy on top of it every time.
  ///
  /// Defaults to false so a creation path that forgets to say is treated as
  /// handmade and survives. Only the optimizer sets it true.
  isGenerated Boolean  @default(false)
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @db.Timestamptz(6)

  school       School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  /// Tenant-scoped for the same reason as TeachingRequirement's: create() takes
  /// subjectId, studentGroupId, teacherId, coTeacherId and roomId from the
  /// request and only ever validates the academic year. `academicYearId` is on
  /// the list too — the service does derive `schoolId` from that very row, but
  /// that is a property of three TypeScript call sites, and a direct PostgREST
  /// write meets no TypeScript at all.
  academicYear AcademicYear @relation(fields: [academicYearId, schoolId], references: [id, schoolId], onDelete: Cascade)
  subject      Subject      @relation(fields: [subjectId, schoolId], references: [id, schoolId], onDelete: Cascade)
  studentGroup StudentGroup @relation(fields: [studentGroupId, schoolId], references: [id, schoolId], onDelete: Cascade)
  teacher      User?        @relation("MasterLessonTeacher", fields: [teacherId, schoolId], references: [id, schoolId], onDelete: SetNull)
  coTeacher    User?        @relation("MasterLessonCoTeacher", fields: [coTeacherId, schoolId], references: [id, schoolId], onDelete: SetNull)
  room         Room?        @relation(fields: [roomId, schoolId], references: [id, schoolId], onDelete: SetNull)

  calendarLessons CalendarLesson[]
  /// Additional classes attending this lesson (beyond the primary group).
  extraGroups     MasterLessonGroup[]
  /// Individual students attending (electives across classes).
  participants    MasterLessonStudent[]

  @@index([schoolId, dayOfWeek, startTime])
  @@index([studentGroupId, dayOfWeek])
  @@index([teacherId, dayOfWeek])
  @@index([roomId, dayOfWeek])
  @@map("MasterLessons")
}

// -----------------------------------------------------------------------------
// Concrete calendar (materialized instances for a specific date)
// -----------------------------------------------------------------------------

model CalendarLesson {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId       String       @db.Uuid
  masterLessonId String?      @db.Uuid
  subjectId      String       @db.Uuid
  studentGroupId String       @db.Uuid
  roomId         String?      @db.Uuid
  date           DateTime     @db.Date
  startsAt       DateTime     @db.Timestamptz(6)
  endsAt         DateTime     @db.Timestamptz(6)
  status         LessonStatus @default(SCHEDULED)
  note           String?
  createdAt      DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @db.Timestamptz(6)

  school       School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  masterLesson MasterLesson? @relation(fields: [masterLessonId], references: [id], onDelete: SetNull)
  subject      Subject       @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  studentGroup StudentGroup  @relation(fields: [studentGroupId], references: [id], onDelete: Cascade)
  room         Room?         @relation(fields: [roomId], references: [id], onDelete: SetNull)

  teachers          CalendarLessonTeacher[]
  attendanceRecords AttendanceRecord[]
  extraGroups       CalendarLessonGroup[]
  participants      CalendarLessonStudent[]

  // Not visible here, and load-bearing: an EXCLUDE constraint on
  // (roomId, tstzrange(startsAt, endsAt)) refuses a second SCHEDULED lesson in
  // a room already taken, and a BEFORE trigger takes an advisory lock on the
  // room so the cross-table checks against RoomBookings hold too. Prisma
  // cannot express either — see migration
  // 20260822131500_a_room_holds_one_thing_at_a_time.

  // Indexes optimized for fast date/time range scans.
  @@index([schoolId, date])
  @@index([schoolId, startsAt, endsAt])
  @@index([studentGroupId, date])
  @@index([studentGroupId, startsAt])
  @@index([roomId, startsAt])
  @@index([masterLessonId])
  @@index([date])
  @@index([startsAt])
  @@map("CalendarLessons")
}

// -----------------------------------------------------------------------------
// Lesson participants: a lesson can span multiple classes and/or individual
// students from different classes (joint activities, electives, support).
// -----------------------------------------------------------------------------

model MasterLessonGroup {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId       String   @db.Uuid
  masterLessonId String   @db.Uuid
  studentGroupId String   @db.Uuid
  createdAt      DateTime @default(now()) @db.Timestamptz(6)

  masterLesson MasterLesson @relation(fields: [masterLessonId], references: [id], onDelete: Cascade)
  /// The extra classes come straight from the request, so this reference is
  /// tenant-scoped like the lesson's own. `masterLessonId` is deliberately
  /// left plain: the row's school is already pinned to the group's by this
  /// key, and nothing reads a lesson through this link without asking the
  /// lesson's own school first.
  studentGroup StudentGroup @relation("MasterLessonExtraGroup", fields: [studentGroupId, schoolId], references: [id, schoolId], onDelete: Cascade)

  @@unique([masterLessonId, studentGroupId])
  @@index([schoolId])
  @@index([studentGroupId])
  @@map("MasterLessonGroups")
}

model MasterLessonStudent {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId       String   @db.Uuid
  masterLessonId String   @db.Uuid
  studentId      String   @db.Uuid
  createdAt      DateTime @default(now()) @db.Timestamptz(6)

  masterLesson MasterLesson @relation(fields: [masterLessonId], references: [id], onDelete: Cascade)
  /// The one reference here that a pupil's own read policy trusts:
  /// `master_lesson_students_self_select` asks only "is this row about me?".
  /// Pinning the school to the pupil is what makes a row that answers yes
  /// necessarily a row from the pupil's own school.
  student      User         @relation("MasterLessonParticipant", fields: [studentId, schoolId], references: [id, schoolId], onDelete: Cascade)

  @@unique([masterLessonId, studentId])
  @@index([schoolId])
  @@index([studentId])
  @@map("MasterLessonStudents")
}

model StudentGroupMember {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId       String   @db.Uuid
  studentGroupId String   @db.Uuid
  studentId      String   @db.Uuid
  createdAt      DateTime @default(now()) @db.Timestamptz(6)

  studentGroup StudentGroup @relation("TeachingGroupGroup", fields: [studentGroupId], references: [id], onDelete: Cascade)
  student      User         @relation("TeachingGroupStudent", fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentGroupId, studentId])
  @@index([schoolId])
  @@index([studentId])
  @@map("StudentGroupMembers")
}

model CalendarLessonGroup {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId         String   @db.Uuid
  calendarLessonId String   @db.Uuid
  studentGroupId   String   @db.Uuid
  createdAt        DateTime @default(now()) @db.Timestamptz(6)

  calendarLesson CalendarLesson @relation(fields: [calendarLessonId], references: [id], onDelete: Cascade)
  studentGroup   StudentGroup   @relation("CalendarLessonExtraGroup", fields: [studentGroupId], references: [id], onDelete: Cascade)

  @@unique([calendarLessonId, studentGroupId])
  @@index([schoolId])
  @@index([studentGroupId])
  @@map("CalendarLessonGroups")
}

model CalendarLessonStudent {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId         String   @db.Uuid
  calendarLessonId String   @db.Uuid
  studentId        String   @db.Uuid
  createdAt        DateTime @default(now()) @db.Timestamptz(6)

  calendarLesson CalendarLesson @relation(fields: [calendarLessonId], references: [id], onDelete: Cascade)
  student        User           @relation("CalendarLessonParticipant", fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([calendarLessonId, studentId])
  @@index([schoolId])
  @@index([studentId])
  @@map("CalendarLessonStudents")
}

// -----------------------------------------------------------------------------
// Teacher <-> CalendarLesson assignment (supports co-teaching / substitutes)
// -----------------------------------------------------------------------------

model CalendarLessonTeacher {
  id               String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId         String                @db.Uuid
  calendarLessonId String                @db.Uuid
  teacherId        String                @db.Uuid
  role             TeacherAssignmentRole @default(LEAD)
  createdAt        DateTime              @default(now()) @db.Timestamptz(6)

  school         School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  calendarLesson CalendarLesson @relation(fields: [calendarLessonId], references: [id], onDelete: Cascade)
  teacher        User           @relation("AssignedTeacher", fields: [teacherId], references: [id], onDelete: Cascade)

  @@unique([calendarLessonId, teacherId])
  @@index([schoolId])
  @@index([teacherId])
  @@map("CalendarLessonTeachers")
}

// -----------------------------------------------------------------------------
// Attendance
// -----------------------------------------------------------------------------

model AttendanceRecord {
  id               String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId         String           @db.Uuid
  calendarLessonId String           @db.Uuid
  studentId        String           @db.Uuid
  status           AttendanceStatus @default(UNKNOWN)
  recordedById     String?          @db.Uuid
  recordedAt       DateTime?        @db.Timestamptz(6)
  note             String?
  createdAt        DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime         @updatedAt @db.Timestamptz(6)

  school         School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  calendarLesson CalendarLesson @relation(fields: [calendarLessonId], references: [id], onDelete: Cascade)
  student        User           @relation("AttendanceStudent", fields: [studentId], references: [id], onDelete: Cascade)
  recordedBy     User?          @relation("AttendanceRecorder", fields: [recordedById], references: [id], onDelete: SetNull)

  @@unique([calendarLessonId, studentId])
  @@index([schoolId, recordedAt])
  @@index([studentId, recordedAt])
  @@index([calendarLessonId])
  @@map("AttendanceRecords")
}

// -----------------------------------------------------------------------------
// Schedule change audit trail (manual timetable edits + regenerations)
// -----------------------------------------------------------------------------

model ScheduleChangeLog {
  id             String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId       String               @db.Uuid
  academicYearId String               @db.Uuid
  // Scalar reference on purpose (no FK): log rows must outlive deleted lessons.
  masterLessonId String?              @db.Uuid
  actorId        String?              @db.Uuid
  action         ScheduleChangeAction
  before         Json?
  after          Json?
  createdAt      DateTime             @default(now()) @db.Timestamptz(6)

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId, academicYearId, createdAt])
  @@index([masterLessonId])
  @@map("ScheduleChangeLogs")
}

// -----------------------------------------------------------------------------
// Named snapshots of the master timetable (save / compare / restore)
// -----------------------------------------------------------------------------

model ScheduleVersion {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId       String   @db.Uuid
  academicYearId String   @db.Uuid
  name           String
  createdById    String?  @db.Uuid
  /// Full master-lesson snapshot (array of lesson records).
  lessons        Json
  lessonCount    Int
  createdAt      DateTime @default(now()) @db.Timestamptz(6)

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId, academicYearId, createdAt])
  @@map("ScheduleVersions")
}

// -----------------------------------------------------------------------------
// Optimization run history (durable job store, replaces the in-memory queue)
// -----------------------------------------------------------------------------

model OptimizationJob {
  id                    String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId              String                @db.Uuid
  academicYearId        String                @db.Uuid
  actorId               String?               @db.Uuid
  status                OptimizationJobStatus @default(PENDING)
  solverStatus          String?
  lessonsGenerated      Int                   @default(0)
  conflictSummary       String?
  /// The summary's message code and values, so the screen can say it in the
  /// reader's language; the string above is the engine's own English, and it
  /// is what a row written before the codes — or a sentence the web has not
  /// translated yet — still shows. See optimization-engine/app/messages.py.
  conflictSummaryCode   String?
  conflictSummaryParams Json?
  conflicts             Json?
  error                 String?
  /// The same for a refused payload: the engine's 400 names its reason.
  errorCode             String?
  errorParams           Json?
  /// Objective weights used for this run (null = server defaults).
  weights               Json?
  /// Effective schedule rules used for this run — the lunch window, the dining
  /// hall's seat count and the daily lesson cap, after the stored settings and
  /// any per-run override were merged. Snapshotted for the same reason
  /// `weights` is, and it became necessary the moment lunch stopped being a
  /// per-request blob: the settings row is edited in place, so without this a
  /// timetable generated in September cannot be explained in November.
  rules                 Json?
  createdAt             DateTime              @default(now()) @db.Timestamptz(6)
  finishedAt            DateTime?             @db.Timestamptz(6)

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId, academicYearId, createdAt])
  @@map("OptimizationJobs")
}

// -----------------------------------------------------------------------------
// Guardians, absence reporting and leave requests (Frånvaro parity)
// -----------------------------------------------------------------------------

model GuardianStudent {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId   String   @db.Uuid
  guardianId String   @db.Uuid
  studentId  String   @db.Uuid
  createdAt  DateTime @default(now()) @db.Timestamptz(6)

  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  /// Composite keys, both of them, and that is the tenancy boundary rather than
  /// a policy: a link may only name users of its own school, and the database
  /// says so for every writer including a future migration. A plain reference to
  /// Users(id) let a school admin file another school's pupil as their own
  /// child, which unlocked that child's profile, health notes and leave reasons
  /// through six policies that trusted the link without checking its school.
  guardian User   @relation("GuardianSide", fields: [guardianId, schoolId], references: [id, schoolId], onDelete: Cascade)
  student  User   @relation("StudentSide", fields: [studentId, schoolId], references: [id, schoolId], onDelete: Cascade)

  @@unique([guardianId, studentId])
  @@index([schoolId])
  @@index([studentId])
  @@map("GuardianStudents")
}

/// A guardian- (or adult-student-) reported absence for a date; startTime/
/// endTime null = full day. Pre-fills the teacher's attendance view.
model AbsenceReport {
  id           String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId     String            @db.Uuid
  studentId    String            @db.Uuid
  reportedById String            @db.Uuid
  date         DateTime          @db.Date
  startTime    DateTime?         @db.Time(0)
  endTime      DateTime?         @db.Time(0)
  type         AbsenceReportType @default(SICK)
  note         String?
  createdAt    DateTime          @default(now()) @db.Timestamptz(6)

  school     School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student    User   @relation("AbsenceStudent", fields: [studentId], references: [id], onDelete: Cascade)
  reportedBy User   @relation("AbsenceReporter", fields: [reportedById], references: [id], onDelete: Cascade)

  @@index([schoolId, date])
  @@index([studentId, date])
  @@map("AbsenceReports")
}

model LeaveRequest {
  id            String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId      String             @db.Uuid
  studentId     String             @db.Uuid
  requestedById String             @db.Uuid
  startDate     DateTime           @db.Date
  endDate       DateTime           @db.Date
  reason        String
  status        LeaveRequestStatus @default(PENDING)
  decidedById   String?            @db.Uuid
  decidedAt     DateTime?          @db.Timestamptz(6)
  decisionNote  String?
  createdAt     DateTime           @default(now()) @db.Timestamptz(6)

  school      School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student     User   @relation("LeaveStudent", fields: [studentId], references: [id], onDelete: Cascade)
  requestedBy User   @relation("LeaveRequester", fields: [requestedById], references: [id], onDelete: Cascade)
  decidedBy   User?  @relation("LeaveDecider", fields: [decidedById], references: [id], onDelete: SetNull)

  @@index([schoolId, status, createdAt])
  @@index([studentId, startDate])
  @@map("LeaveRequests")
}

// -----------------------------------------------------------------------------
// Self-service room bookings (Skola24 Lokal parity). Teachers reserve free
// rooms themselves; these bookings coexist with lessons in conflict checking.
// Bookings on "special" rooms (requiresApproval) start PENDING until an admin
// decides; ordinary rooms auto-approve.
// -----------------------------------------------------------------------------

model RoomBooking {
  id           String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId     String            @db.Uuid
  roomId       String            @db.Uuid
  bookedById   String            @db.Uuid
  title        String
  startsAt     DateTime          @db.Timestamptz(6)
  endsAt       DateTime          @db.Timestamptz(6)
  status       RoomBookingStatus @default(APPROVED)
  decidedById  String?           @db.Uuid
  decidedAt    DateTime?         @db.Timestamptz(6)
  decisionNote String?
  createdAt    DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime          @updatedAt @db.Timestamptz(6)

  school    School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  room      Room   @relation(fields: [roomId], references: [id], onDelete: Cascade)
  bookedBy  User   @relation("RoomBookingBooker", fields: [bookedById], references: [id], onDelete: Cascade)
  decidedBy User?  @relation("RoomBookingDecider", fields: [decidedById], references: [id], onDelete: SetNull)

  // Not visible here, and load-bearing: an EXCLUDE constraint on
  // (roomId, tstzrange(startsAt, endsAt)), limited to PENDING and APPROVED
  // rows, is what stops two people holding one room at one hour. Prisma cannot
  // express it — see migration 20260822131500_a_room_holds_one_thing_at_a_time.
  @@index([schoolId, startsAt])
  @@index([roomId, startsAt])
  @@index([bookedById, startsAt])
  @@index([schoolId, status, createdAt])
  @@map("RoomBookings")
}

// -----------------------------------------------------------------------------
// Integration API keys (SS12000-style external access; hashed at rest)
// -----------------------------------------------------------------------------

model IntegrationApiKey {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId    String    @db.Uuid
  name        String
  /// SHA-256 hex of the key — the plaintext is shown exactly once on create.
  keyHash     String    @unique
  createdById String?   @db.Uuid
  lastUsedAt  DateTime? @db.Timestamptz(6)
  revokedAt   DateTime? @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@map("IntegrationApiKeys")
}

// -----------------------------------------------------------------------------
// Notifications (in-app inbox; optionally mirrored to email)
// -----------------------------------------------------------------------------

model Notification {
  id        String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId  String           @db.Uuid
  userId    String           @db.Uuid
  type      NotificationType
  /// Render payload (dates, names, status) — the client localizes per type.
  meta      Json?
  readAt    DateTime?        @db.Timestamptz(6)
  emailedAt DateTime?        @db.Timestamptz(6)
  createdAt DateTime         @default(now()) @db.Timestamptz(6)

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user   User   @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([schoolId])
  @@map("Notifications")
}

// -----------------------------------------------------------------------------
// Availability / scheduling constraints (consumed by the OR-Tools engine)
// -----------------------------------------------------------------------------

model AvailabilityConstraint {
  id             String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId       String             @db.Uuid
  resourceType   ConstraintResource
  userId         String?            @db.Uuid
  roomId         String?            @db.Uuid
  studentGroupId String?            @db.Uuid
  // A GRADE_LEVEL constraint has none of the three ids above and this range
  // instead — "håll åk 4-6 fria 11:30-12:15" is a rule about every group whose
  // members sit in those years, and there is no row to point at. Both bounds
  // are 0-12 and ordered; the DB enforces that, plus that they are set for
  // GRADE_LEVEL rows and only for those (see the migration).
  minGradeLevel  Int?
  maxGradeLevel  Int?
  // Either a recurring weekday (1-7) or a one-off `date` may be set.
  dayOfWeek      Int?
  date           DateTime?          @db.Date
  startTime      DateTime           @db.Time(0)
  endTime        DateTime           @db.Time(0)
  type           ConstraintType     @default(UNAVAILABLE)
  reason         String?
  createdAt      DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime           @updatedAt @db.Timestamptz(6)

  school       School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user         User?         @relation("ConstraintTeacher", fields: [userId], references: [id], onDelete: Cascade)
  room         Room?         @relation(fields: [roomId], references: [id], onDelete: Cascade)
  studentGroup StudentGroup? @relation("ConstraintGroup", fields: [studentGroupId], references: [id], onDelete: Cascade)

  @@index([schoolId, dayOfWeek])
  @@index([userId, dayOfWeek])
  @@index([roomId, dayOfWeek])
  @@index([studentGroupId, dayOfWeek])
  @@index([date])
  @@map("AvailabilityConstraints")
}

/// En lärares arbetstid: the lunch a teacher is owed, and the rest between two
/// of their days.
///
/// The counterpart of the table above, and the thing it cannot say. An
/// AvailabilityConstraint with resourceType TEACHER is a teacher CLOSING hours —
/// "jag är ledig på fredagar" — a subtraction from the week the solver may not
/// place anything in. It is the only per-teacher row in the schema, and nothing
/// anywhere says a teacher is OWED something: the model protects pupils with a
/// lunch window per class and a rast per stage, and leaves the adult who walks
/// them there with no meal, no break and no evening.
///
/// HARD RULES, EVERY ONE OF THEM. A week that cannot honour a row here is
/// refused, and the refusal names the row. That is why the table exists instead
/// of a weight: a lunch the solver may trade against a fuller Tuesday is not a
/// lunch, it is a preference, and a school reading "schemat är klart" has no way
/// to discover which teacher paid for it.
///
/// EVERY RULE IS OPTIONAL, AND NULL MEANS IT DOES NOT APPLY. A school that has
/// filled in nobody is refused nothing, which is what makes this safe to deploy
/// into every existing database: no row exists, so no week changes. Null is not
/// "zero minutes" and not "the default": there is deliberately no default, since
/// a number nobody chose would start refusing weeks that used to solve.
///
/// ITS OWN TABLE, NOT COLUMNS ON `User`. Two reasons, and either alone decides
/// it. `Users` is the PII table — the fenced block of firstName/lastName/email/
/// phone, masked at the gateway and never sent to the engine — and a scheduling
/// rule the solver reads has no business behind that fence, where every reader
/// has to be trusted with the name beside it. And every other scheduling rule in
/// this schema is already a table of its own: FrameTimes, LunchServings, Rasts,
/// RoomPreferences. A rule on `User` would be the one a developer looking for
/// the rules does not find.
model TeacherWorkRule {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId String @db.Uuid
  /// The teacher. Reached through a composite (id, schoolId) key like every
  /// other reference here, because a foreign-key check runs as the referenced
  /// table's owner with row security OFF — so a userId the caller cannot even
  /// SELECT would still validate, and one school could write a rule about
  /// another school's teacher.
  userId   String @db.Uuid

  /// Minutes of lunch the teacher must get, somewhere inside the window below.
  ///
  /// The trio is all-or-nothing: all three set, or all three null. Half a rule
  /// cannot be read — 30 minutes with no window is a lunch the solver may place
  /// at 07:00, and a window with no length is a window nothing has to happen in.
  /// The DB enforces it, and so does the DTO; see the migration.
  ///
  /// 5..240 and a multiple of 5, because the solver's grid is five minutes wide
  /// and a rule it cannot express is a week that fails forever rather than a bad
  /// request once.
  lunchMinutes        Int?
  /// The earliest the lunch may start and the latest it may end. The window is
  /// at least `lunchMinutes` wide, which the DB checks: a 30-minute lunch inside
  /// a 20-minute window is arithmetic nobody can satisfy, and it would be
  /// refused on every run from then on rather than at the moment it was typed.
  lunchStartTime      DateTime? @db.Time(0)
  lunchEndTime        DateTime? @db.Time(0)

  /// Minutes between the END of the teacher's last lesson one day and the START
  /// of their first the next.
  ///
  /// 60..1320 — an hour at the bottom, twenty-two hours at the top. Null means
  /// the rule does not apply. The bound at the top is what keeps a typo from
  /// being a proof: 1440 minutes of rest is a teacher who can never teach two
  /// days running, and the engine would have to refuse the week to say so.
  minDailyRestMinutes Int?

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user   User   @relation("WorkRuleTeacher", fields: [userId, schoolId], references: [id, schoolId], onDelete: Cascade)

  /// One row per teacher. Not per läsår and not per weekday: a person's meal and
  /// a person's night belong to the person, not to the curriculum, and a rule
  /// keyed per year would be missing every August — at exactly the moment a new
  /// timetable is being generated.
  @@unique([userId])
  @@index([schoolId])
  @@map("TeacherWorkRules")
}

/// Ramtider: the hours of the day a stage of the school may be taught in.
///
/// The positive twin of an UNAVAILABLE constraint. "Åk 4 does not go on until
/// 17:00" was expressible before only as the holes around the day, two or three
/// rows per weekday per stage, none of which read back as the sentence meant.
///
/// Matching is OVERLAP and every match applies, so a group is bound by the
/// intersection of the frames its years touch. That is what lets a weekday row
/// and an every-day row compose without a precedence rule: "08:00-15:00 always,
/// 08:00-13:00 on Friday" needs no further sentence. dayOfWeek null is every
/// teaching day, as on a constraint. See the migration for the rest.
model FrameTime {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId      String   @db.Uuid
  /// Inclusive, 0-12, both required and ordered — the DB enforces all three.
  minGradeLevel Int
  maxGradeLevel Int
  /// ISO weekday 1-7, or null for every teaching day.
  dayOfWeek     Int?
  startTime     DateTime @db.Time(0)
  endTime       DateTime @db.Time(0)
  /// Minutes a body needs between two lessons: the corridor, not the yard.
  ///
  /// Composes as MAX over matching frames — the opposite of the window, which
  /// intersects — because a changeover is a floor and the widest floor wins.
  /// Zero for every school until somebody writes a number, and the engine skips
  /// the whole mechanism while every matching frame reads zero.
  changeoverMinutes Int   @default(0)
  createdAt     DateTime @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @db.Timestamptz(6)

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, minGradeLevel, maxGradeLevel, dayOfWeek], map: "FrameTimes_schoolId_span_dayOfWeek_key")
  @@index([schoolId, dayOfWeek])
  @@map("FrameTimes")
}

/// Lunchsittningar: the window each stage of the school may eat in.
///
/// The declaration half of the lunch flow. The school states when a stage may
/// eat; the solver decides which class goes when inside that window, splitting
/// a stage too big for the hall into waves through the seat cumulative.
///
/// Windows UNION across spans — the opposite of FrameTime, which intersects —
/// because a serving grants permission where a frame imposes a bound. A
/// day-specific row REPLACES the every-day row for that day, so "alla dagar
/// 12:20-13:00" plus "fredag 11:40-12:20" means Friday is different rather than
/// wider. No unique key: two rows for one stage on one day are two hand-written
/// waves. See the migration for the rest.
model LunchServing {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId      String   @db.Uuid
  /// Inclusive, 0-12, both required and ordered — the DB enforces all three.
  minGradeLevel Int
  maxGradeLevel Int
  /// ISO weekday 1-7, or null for every teaching day.
  dayOfWeek     Int?
  startTime     DateTime @db.Time(0)
  endTime       DateTime @db.Time(0)
  /// Chairs for THIS sitting; null means the hall's own diningSeats.
  seats         Int?
  createdAt     DateTime @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @db.Timestamptz(6)

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId, dayOfWeek])
  @@map("LunchServings")
}

/// Raster: the minutes of a day a stage of the school is NOT taught.
///
/// The declaration, and the whole of it — unlike the meal, which needs a second
/// table because the solver CHOOSES when each class eats. Nothing about a rast
/// is chosen: the school states it, the engine subtracts it from every matching
/// lesson's start domain, and publish dates it. A middle table would store what
/// this row already says, and two copies of "when does åk 4-6 have rast" are two
/// things to disagree.
///
/// Windows UNION across spans and every matching row applies, but the union
/// means the OPPOSITE of a LunchServing's: a serving that matches GRANTS
/// permission, a rast that matches IMPOSES an obligation. A day-specific row
/// shadows only the every-day rows whose window it OVERLAPS — narrower than the
/// serving rule, because several rasts a day are normal and replacing all of
/// them would silently delete a stage's other Friday breaks. No unique key, for
/// the same reason. See the migration for the rest.
model Rast {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId      String   @db.Uuid
  /// What the school calls it, printed on the pupil's band.
  name          String
  /// Inclusive, 0-12, both required and ordered — the DB enforces all three.
  minGradeLevel Int
  maxGradeLevel Int
  /// ISO weekday 1-7, or null for every teaching day.
  dayOfWeek     Int?
  startTime     DateTime @db.Time(0)
  endTime       DateTime @db.Time(0)
  /// Whether the stretch ending at this rast must hold a lesson.
  ///
  /// A rast is otherwise only a hole, and a class whose Monday starts at the
  /// morning break has broken no rule. Counted from the previous break — the
  /// rast before it, or the class's own lunch. See the migration.
  requiresLessonBefore Boolean @default(false)
  createdAt     DateTime @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @db.Timestamptz(6)

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId, dayOfWeek])
  @@map("Rasts")
}

/// A rast as published: one class, one day, one break.
///
/// The dated half of Rast, and the only thing a pupil, guardian or teacher ever
/// reads. Dated rather than derived in the client because a published week has
/// to be a record of that week: a lov makes a Monday differ from the rule, and
/// an admin editing a declaration in March must not rewrite February.
///
/// The name is COPIED, not referenced, for the same reason a CalendarLesson
/// carries its own times rather than reading its template's.
model CalendarRast {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId       String   @db.Uuid
  studentGroupId String   @db.Uuid
  name           String
  date           DateTime @db.Date
  startsAt       DateTime @db.Timestamptz(6)
  endsAt         DateTime @db.Timestamptz(6)
  createdAt      DateTime @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @db.Timestamptz(6)

  school       School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  studentGroup StudentGroup @relation(fields: [studentGroupId, schoolId], references: [id, schoolId], onDelete: Cascade)

  @@unique([studentGroupId, date, startsAt])
  @@index([schoolId, date])
  @@index([studentGroupId, date])
  @@map("CalendarRasts")
}

/// The lunch one class has on one weekday — the solver's choice, or the school's.
///
/// The meal's half of the MasterLesson -> CalendarLesson path. A run replaces
/// the rows the SOLVER wrote (isGenerated) and leaves the ones the school
/// placed by hand; a failed run leaves them all alone. A hand-placed row is
/// sent to the engine as a PIN on the lunch variable it already builds — one
/// reservation, not the fixed lesson beside a live variable that the migration
/// creating this table refused. See 20260911090000.
model LunchSitting {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId       String   @db.Uuid
  academicYearId String   @db.Uuid
  studentGroupId String   @db.Uuid
  /// ISO weekday 1-7. Never null: this is a placement, not a rule.
  dayOfWeek      Int
  startTime      DateTime @db.Time(0)
  endTime        DateTime @db.Time(0)
  /// Children seated, as the engine was told. Kept so the kitchen's list does
  /// not have to re-derive a roster that may have changed since the run.
  headcount      Int      @default(0)
  /// Whether the SOLVER wrote this row. The one thing regeneration may replace,
  /// spelled as MasterLesson spells it, and defaulting false for the same
  /// reason: a creation path that forgets to say is treated as handmade and
  /// survives, which is the error a school can see and undo.
  isGenerated    Boolean  @default(false)
  createdAt      DateTime @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @db.Timestamptz(6)

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  /// Composite, like every other reference here: a foreign-key check runs as
  /// the referenced table's owner with row security OFF, so an id the caller
  /// cannot even SELECT would still validate. The key is what makes a sitting's
  /// group the group of its school.
  academicYear AcademicYear @relation(fields: [academicYearId, schoolId], references: [id, schoolId], onDelete: Cascade)
  studentGroup StudentGroup @relation(fields: [studentGroupId, schoolId], references: [id, schoolId], onDelete: Cascade)

  @@unique([academicYearId, studentGroupId, dayOfWeek], map: "LunchSittings_group_day_key")
  @@index([schoolId, academicYearId])
  @@map("LunchSittings")
}

/// A dated meal, as publish materialises it.
///
/// Its own table rather than a CalendarLesson, because everything downstream of
/// that one assumes teaching: SS12000 would report lunch to the kommun as
/// undervisning, and the absence notice would tell a guardian their child was
/// away from "Lunch". Both are read straight from the browser through PostgREST
/// with no server DTO to filter at, so separation is the only guard that holds.
model CalendarLunch {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId       String   @db.Uuid
  studentGroupId String   @db.Uuid
  date           DateTime @db.Date
  startsAt       DateTime @db.Timestamptz(6)
  endsAt         DateTime @db.Timestamptz(6)
  createdAt      DateTime @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @db.Timestamptz(6)

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  /// Composite, for the same reason as everywhere else in this schema.
  studentGroup StudentGroup @relation(fields: [studentGroupId, schoolId], references: [id, schoolId], onDelete: Cascade)

  @@unique([studentGroupId, date], map: "CalendarLunches_group_date_key")
  @@index([schoolId, date])
  @@index([studentGroupId, date])
  @@map("CalendarLunches")
}

/// Lov och studiedagar: whole days a school does not teach.
///
/// A dated `UNAVAILABLE` constraint could already say "this group cannot be
/// taught on this date", and publish honoured it. What it could not say is
/// "the school is closed all of week 9": a constraint names ONE resource on
/// ONE date, so a sportlov meant a row per day per group, and a läsår's lov
/// and studiedagar together ran past a thousand rows entered by hand. Nothing
/// in `ConstraintResource` means "everybody" either.
///
/// So this is a named RANGE that belongs to the school rather than to a
/// resource. Constraints keep doing what they are good at — one teacher away
/// on a Tuesday, a room closed for two hours — and are untouched by this.
enum BreakKind {
  /// Höstlov, jullov, sportlov, påsklov: nobody is in the building.
  HOLIDAY
  /// Studiedag — pupils are off, staff are working. No lessons either way, but
  /// a teacher's day is not free and a report that counts them apart needs to
  /// know which it was.
  STAFF_DAY
}

model SchoolBreak {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId       String    @db.Uuid
  academicYearId String    @db.Uuid
  /// What the school calls it — "Höstlov", "Studiedag", "Prao åk 9".
  name           String
  kind           BreakKind @default(HOLIDAY)
  /// Inclusive at both ends, so a single day is startDate == endDate.
  startDate      DateTime  @db.Date
  endDate        DateTime  @db.Date
  /// Narrows the break to a span of years, for the cases that are not
  /// school-wide — prao for åk 9, a studiedag for the lower years. Both null
  /// means the whole school, which is what a lov almost always is. Same shape
  /// and same DB checks as AvailabilityConstraint's GRADE_LEVEL rows, because
  /// a year is a property of a group's members and there is no row to point at.
  minGradeLevel  Int?
  maxGradeLevel  Int?
  createdAt      DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @db.Timestamptz(6)

  school       School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  /// Composite, for the same reason every other reference here is: a foreign
  /// key check runs as the referenced table's owner with row security off, so
  /// an id the caller cannot SELECT would still validate. The key is what makes
  /// a break's school the school of its year.
  academicYear AcademicYear @relation(fields: [academicYearId, schoolId], references: [id, schoolId], onDelete: Cascade)

  @@index([schoolId, academicYearId])
  @@index([schoolId, startDate, endDate])
  @@map("SchoolBreaks")
}

/// Lunch, and how many pupils the dining hall can seat at once.
///
/// One row per school (`@@unique([schoolId])`), which is the one scheduling
/// model here that is NOT keyed on `academicYearId`. That is deliberate: the
/// dining hall belongs to the building and the kitchen, not to the curriculum,
/// and its seats do not reset in August. Keyed per year, the setting would be
/// missing every new school year — at exactly the moment publishing is meant
/// to warn that lunch has not been defined.
///
/// `maxLessonsPerDayPerGroup` is not a lunch rule and lives here anyway,
/// because it sits in the same form. Both halves used to live in one browser's
/// `localStorage`, so a second administrator generated the schedule under
/// different rules without knowing it; persisting half the form on the server
/// and leaving the other half in one browser would keep that bug alive for the
/// half that stayed behind.
model LunchSetting {
  id                       String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId                 String   @db.Uuid
  lunchEnabled             Boolean  @default(false)
  lunchStartTime           DateTime @db.Time(0)
  lunchEndTime             DateTime @db.Time(0)
  lunchMinutes             Int
  /// Seats in the dining hall. Null means the school has no seat limit worth
  /// modelling — the solver then places lunch exactly as it did before.
  diningSeats              Int?
  maxLessonsPerDayPerGroup Int?
  createdAt                DateTime @default(now()) @db.Timestamptz(6)
  updatedAt                DateTime @updatedAt @db.Timestamptz(6)

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  // One row per school. No separate @@index([schoolId]) — this unique index
  // already is one, and a second would only be a duplicate to maintain.
  @@unique([schoolId])
  @@map("LunchSettings")
}

enum RoomRuleKind {
  /// Paid for, not required — the solver trades it against everything else.
  WISH
  /// Required. A week that cannot honour it is refused by name.
  LOCK
}

/// Where a subject's lessons belong — as a wish, or as a rule.
///
/// TWO KINDS IN ONE TABLE because they differ in one field and nothing else.
/// A WISH is a price: the solver pays `weight` per lesson placed elsewhere and
/// trades that against its other objectives, so a school gets NO in the lab but
/// not at the cost of a week that cannot be scheduled. A LOCK is a bound: the
/// lesson may go nowhere else, and a week that needs it to is refused by name.
///
/// `Subject.requiredRoomTypeId` is the only other hard room rule and it is
/// school-wide and type-only; `Room.minGradeLevel` fences a room to a stage,
/// which binds that room's every subject. Neither can say "år 4's maths happens
/// in Optimisten 4".
///
/// The optional year span scopes a rule to a stage, matched by CONTAINMENT —
/// the group's whole span inside the rule's. Null means every year, which is
/// what every row written before this column existed means. Locks resolve by
/// specificity (narrowest span wins, ties union); wishes stay additive. The
/// migration argues all of it.
model RoomPreference {
  id         String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId   String       @db.Uuid
  subjectId  String       @db.Uuid
  /// WISH pays a price; LOCK forbids everything else.
  kind       RoomRuleKind @default(WISH)
  /// Inclusive years the rule applies to; both null means every year. The DB
  /// enforces both-or-neither, ordered, and 0-12.
  minGradeLevel Int?
  maxGradeLevel Int?
  /// Either a type…
  roomTypeId String?      @db.Uuid
  /// …or a set of named rooms, via RoomPreferenceRooms. Exactly one of the two
  /// carries the rule; a rule pointing at neither could never be satisfied or
  /// violated.
  ///
  /// Read only for a WISH. Kept NOT NULL rather than nullable-means-hard: the
  /// engine reads `preference.weight or weights.room_preference`, so a falsy
  /// weight would silently become its weakest wish instead of a restriction.
  weight     Int          @default(5)
  createdAt  DateTime @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @db.Timestamptz(6)

  school   School               @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  subject  Subject              @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  roomType RoomType?            @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)
  rooms    RoomPreferenceRoom[]

  @@index([schoolId])
  @@index([schoolId, kind])
  @@map("RoomPreferences")
}

model RoomPreferenceRoom {
  id           String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId     String @db.Uuid
  preferenceId String @db.Uuid
  roomId       String @db.Uuid

  preference RoomPreference @relation(fields: [preferenceId], references: [id], onDelete: Cascade)
  room       Room           @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@unique([preferenceId, roomId])
  @@index([schoolId])
  @@map("RoomPreferenceRooms")
}
