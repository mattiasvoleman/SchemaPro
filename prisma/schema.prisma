// =============================================================================
// SchemaPro — AI-driven school scheduling & attendance system
// PostgreSQL data layer (Prisma ORM)
//
// Design principles (see .cursorrules):
//   * Privacy by Design: every primary/foreign key is an anonymized UUIDv4 so
//     that only opaque identifiers ever reach the Python AI engine. PII lives
//     exclusively on the `Users` table and is masked at the NestJS gateway.
//   * Multi-tenancy: every table carries `schoolId` so PostgreSQL Row-Level
//     Security can partition data per school cheaply (see migration.sql).
//   * Performance: indexes are tuned for date/time range scans of the calendar.
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// -----------------------------------------------------------------------------
// Enums
// -----------------------------------------------------------------------------

enum UserRole {
  STUDENT
  TEACHER
  SCHOOL_ADMIN
  GUARDIAN
}

/// Roller i skolan (20261110090000): what kind of SCHOOL_ADMIN a person is.
/// A profile of the one administrator role, not a role of its own, so every
/// arm that asks for TEACHER or SCHOOL_ADMIN reads the same as before. FULL is
/// today's administrator and every existing one became it; which areas each
/// profile writes is app.admin_profile_writes() in the database and
/// src/auth/admin-areas.ts in the gateway, held equal by tests.
enum AdminProfile {
  FULL
  REKTOR
  SCHEMALAGGARE
  EXPEDITION
  /// Läsare (Läsbehörighet, 20261120090000): reads every area, writes none,
  /// decides nothing; may be given HR-läs.
  LASARE
}

/// The areas an administrator's writes fall in, the one list both the
/// database (app.current_user_may) and the gateway (@Area) read. Every
/// profile reads every area; the areas only decide who writes.
enum AdminArea {
  PLANERING
  SCHEMALAGGNING
  PUBLICERING
  DRIFT
  PERSONAL
  INTEGRATIONER
}

enum AbsenceReportType {
  SICK
  APPOINTMENT
  OTHER
}

enum LeaveRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

/// In which role a leave request was decided (20261023091000): by the pupil's
/// mentor under rektor's delegation, or by the admin (rektor).
enum LeaveDeciderRole {
  MENTOR
  ADMIN
}

enum NotificationType {
  ABSENCE_UNREPORTED
  LEAVE_DECIDED
  LESSON_CANCELLED
  LESSON_SUBSTITUTE
  LESSON_ROOM_CHANGED
  SCHEDULE_CHANGED
  ROOM_BOOKING_DECIDED
  /// A teacher registered their own absence; to the school's admins, no reason (20261012120000).
  TEACHER_ABSENCE_REPORTED
  /// A booked substitute is no longer needed (20261012120000).
  LESSON_COVER_WITHDRAWN
  /// A lesson goes ahead as its timetable says after all: reinstated, or a cover decision the class was told about undone (20261018090000).
  LESSON_REINSTATED
  /// The cover board decided självstudier under tillsyn (20261018090000).
  LESSON_SUPERVISED_STUDY
  /// One notice per person for a bulk avbokning, and one for its reversal (20261018090000).
  CANCELLATION_DIGEST
  /// A leave request the school's delegation gives the pupil's mentor to decide; to those mentors, no reason (20261023090000).
  LEAVE_REQUESTED
}

enum RoomBookingStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum LessonStatus {
  SCHEDULED
  CANCELLED
  COMPLETED
  RESCHEDULED
}

/// Why a CalendarLesson is CANCELLED, when the data knows. Null on a
/// cancelled row means "no cause recorded" (cancelled before P3, or by a
/// writer that did not say). See 20261009090000.
enum LessonCancelCause {
  /// Publish found a dated teacher closure, or the teacher-absence page
  /// cancelled the lesson because the teacher is away.
  TEACHER_UNAVAILABLE
  /// Publish found a dated room closure.
  ROOM_UNAVAILABLE
  /// Cancelled by the school with no cause given.
  MANUAL
  /// Cancelled by a bulk avbokning for an activity the school names (prao,
  /// friluftsdag, studiedag); migration 20261011103000.
  EVENT
}

enum AttendanceStatus {
  UNKNOWN
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum TeacherAssignmentRole {
  LEAD
  ASSISTANT
  SUBSTITUTE
}

enum ConstraintResource {
  TEACHER
  ROOM
  STUDENT_GROUP
  /// Not a row anywhere: a year is a property of a group's members, so a
  /// GRADE_LEVEL constraint points at no resource at all and carries
  /// `minGradeLevel`/`maxGradeLevel` instead.
  GRADE_LEVEL
}

enum ConstraintType {
  UNAVAILABLE
  PREFERRED_FREE
  PREFERRED_BUSY
}

enum ScheduleChangeAction {
  CREATE
  UPDATE
  DELETE
  REGENERATE
  RESTORE
}

enum OptimizationJobStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
}

/// Schemaförslag (20261125090000): a run of candidates. CANCELLING still holds
/// the year's one active place until the run's task has stopped.
enum ScheduleCandidateRunStatus {
  PENDING
  RUNNING
  CANCELLING
  SUCCEEDED
  FAILED
}

// -----------------------------------------------------------------------------
// Tenant root
// -----------------------------------------------------------------------------

model School {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  slug      String   @unique
  timezone  String   @default("Europe/Stockholm")
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  users                   User[]
  rooms                   Room[]
  roomTypes               RoomType[]
  subjects                Subject[]
  academicYears           AcademicYear[]
  schoolUnits             SchoolUnit[]
  sites                   Site[]
  siteTravelTimes         SiteTravelTime[]
  studentGroups           StudentGroup[]
  teachingRequirements    TeachingRequirement[]
  teachingRequirementShares TeachingRequirementShare[]
  teachingBlocks          TeachingBlock[]
  masterLessons           MasterLesson[]
  calendarLessons         CalendarLesson[]
  calendarLessonTeachers  CalendarLessonTeacher[]
  lessonLogs              LessonLog[]
  lessonSubstituteNotes   LessonSubstituteNote[]
  attendanceRecords       AttendanceRecord[]
  availabilityConstraints AvailabilityConstraint[]
  schoolBreaks            SchoolBreak[]
  frameTimes              FrameTime[]
  rasts                   Rast[]
  lunchServings           LunchServing[]
  lunchSittings           LunchSitting[]
  calendarLunches         CalendarLunch[]
  calendarRasts           CalendarRast[]
  scheduleChangeLogs      ScheduleChangeLog[]
  scheduleVersions        ScheduleVersion[]
  optimizationJobs        OptimizationJob[]
  scheduleCandidateRuns   ScheduleCandidateRun[]
  guardianStudents        GuardianStudent[]
  absenceReports          AbsenceReport[]
  leaveRequests           LeaveRequest[]
  notifications           Notification[]
  integrationApiKeys      IntegrationApiKey[]
  signInMethod            SchoolSignInMethod?
  roomBookings            RoomBooking[]
  roomPreferences         RoomPreference[]
  teacherWorkRules        TeacherWorkRule[]
  lunchSetting            LunchSetting?
  staffingPolicy          StaffingPolicy?
  teacherEmployments      TeacherEmployment[]
  teacherQualifications   TeacherSubjectQualification[]
  teacherDuties           TeacherDuty[]
  teacherDutySlots        TeacherDutySlot[]
  teacherEmploymentLogs   TeacherEmploymentLog[]
  teacherEmploymentPeriods TeacherEmploymentPeriod[]
  supervisionAreas        SupervisionArea[]
  supervisionShifts       SupervisionShift[]
  localTimplans           LocalTimplan[]
  localTimplanEntries     LocalTimplanEntry[]
  academicYearTimplans    AcademicYearTimplan[]
  timplanCredits          TimplanCredit[]
  studentEnrollments      StudentEnrollment[]
  timplanStatementPublications TimplanStatementPublication[]
  timplanStatements       TimplanStatement[]
  publicationSettings     PublicationSettings?
  timetablePublications   TimetablePublication[]
  publishedLessons        PublishedLesson[]
  publishedLunchSittings  PublishedLunchSitting[]

  @@map("Schools")
}

// -----------------------------------------------------------------------------
// Users (the ONLY table that stores PII)
// -----------------------------------------------------------------------------

model User {
  id       String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId String   @db.Uuid
  // `authId` is the Supabase Auth user id (auth.users.id == JWT sub == auth.uid()).
  // A login has one row per school it belongs to (20261204090000): the
  // unique key is (authId, schoolId), and app.current_user_id() picks the row
  // a request names. A second school takes a login only through the
  // gateway's invitation (trigger Users_a_login_joins_another_school_by_invitation).
  authId   String   @db.Uuid
  role     UserRole

  // --- PII (masked at the NestJS gateway, never sent to the AI engine) ---
  firstName String
  lastName  String
  email     String
  phone     String?
  // ----------------------------------------------------------------------

  isActive  Boolean   @default(true)
  // When the invitation email was last sent. NULL means the person exists in
  // the school's catalog but has never been contacted — `authId` is then a
  // placeholder that matches no Supabase identity, so they cannot sign in
  // until an admin chooses to invite them.
  invitedAt DateTime? @db.Timestamptz(6)
  /// The person's id at the school's SS12000 source (20261014100000), written
  /// only by an admin's apply (a trigger refuses every other writer, SQLSTATE
  /// SS403). Unique per school where set: the partial unique index
  /// Users_schoolId_ss12000Id_key, which schema.prisma cannot state.
  ss12000Id String?   @db.Uuid
  /// When isActive last went from true to false (20261021100000). A trigger
  /// keeps it, whatever a statement writes: NULL while active, the moment of
  /// deactivation after. Gallring counts a departed person's period from it.
  /// The partial index Users_schoolId_deactivatedAt_idx lives in the migration.
  deactivatedAt   DateTime? @db.Timestamptz(6)
  /// When gallring pseudonymised the person (20261021110000): name, e-mail,
  /// phone, source id and login replaced. Such a row is never active again
  /// (CHECK Users_a_pseudonym_stays_inactive).
  pseudonymisedAt DateTime? @db.Timestamptz(6)
  /// The administrator's profile (20261110090000): set exactly on a
  /// SCHOOL_ADMIN (CHECK Users_a_profile_is_an_administrators), FULL when a
  /// writer names none. Changed only by a person whose own profile decides
  /// (rektor or full), which a trigger holds; every change is logged in
  /// UserRoleChanges.
  adminProfile    AdminProfile?
  /// HR-läs: a schemaläggare or an expedition who may read tjänst % and
  /// nedsättning. Rektor and full read them anyway, so the flag is false for
  /// them and for everybody who is not an administrator (CHECK).
  hrRead          Boolean   @default(false)
  /// When the row took the login it holds now (20261204090000): stamped by
  /// the trigger Users_login_since_is_the_logins on insert and on a change
  /// of authId, kept on every other write. A login's default row, when a
  /// request names no school, is the one that took the login first.
  loginSince      DateTime  @default(now()) @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)

  school         School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  // A student's primary group (null for teachers/admins).
  //
  // Not visible here, and load-bearing: a CHECK refuses a group on any other
  // role, because app.current_user_group_id() hands whoever holds one the
  // pupils' read path. Prisma cannot express it — see migration
  // 20260914120000_bara_en_elev_har_en_klass.
  studentGroupId String?       @db.Uuid
  studentGroup   StudentGroup? @relation("StudentGroupMembers", fields: [studentGroupId], references: [id], onDelete: SetNull)

  // Relations where this user acts as a teacher.
  teachingRequirements    TeachingRequirement[]    @relation("RequirementTeacher")
  coTeachingRequirements  TeachingRequirement[]    @relation("RequirementCoTeacher")
  /// Delade lektioner: the lessons of other teachers' posts this user takes.
  requirementShares       TeachingRequirementShare[] @relation("RequirementShareTeacher")
  masterLessons           MasterLesson[]           @relation("MasterLessonTeacher")
  coMasterLessons         MasterLesson[]           @relation("MasterLessonCoTeacher")
  calendarLessonTeachers  CalendarLessonTeacher[]  @relation("AssignedTeacher")
  recordedAttendance      AttendanceRecord[]       @relation("AttendanceRecorder")
  /// Lesson logs and notes to the substitute this person wrote last (Lektionslogg).
  writtenLessonLogs       LessonLog[]              @relation("LessonLogWriter")
  writtenSubstituteNotes  LessonSubstituteNote[]   @relation("SubstituteNoteWriter")
  availabilityConstraints AvailabilityConstraint[] @relation("ConstraintTeacher")
  /// At most one row, which the database enforces with @@unique([userId]) on
  /// the other side. A list rather than an optional single relation because the
  /// key is composite — (userId, schoolId), like every other reference here —
  /// and Prisma reads a one-to-one off the key's own uniqueness, which a unique
  /// on one of its two columns does not give it.
  workRules               TeacherWorkRule[]        @relation("WorkRuleTeacher")
  /// The teacher's post, one row per läsår (TeacherEmployment), and what they
  /// may teach (TeacherSubjectQualification). Both reach the user through the
  /// composite (userId, schoolId) key, like workRules.
  employments             TeacherEmployment[]           @relation("EmploymentTeacher")
  subjectQualifications   TeacherSubjectQualification[] @relation("QualificationTeacher")
  /// Uppdrag beside teaching, per läsår (TeacherDuty), by the same key.
  duties                  TeacherDuty[]                 @relation("DutyTeacher")
  /// Rastvaktspass, per läsår (SupervisionShift), by the same key.
  supervisionShifts       SupervisionShift[]            @relation("SupervisionShiftTeacher")
  employmentLogs          TeacherEmploymentLog[]        @relation("EmploymentLogTeacher")
  /// Local timplans this person recorded as decided. Restrict on the other
  /// side: a person who recorded a decision is deactivated, not deleted.
  decidedLocalTimplans    LocalTimplan[]                @relation("LocalTimplanDecider")

  // Relations where this user is the student.
  attendanceRecords   AttendanceRecord[]      @relation("AttendanceStudent")
  masterLessonJoins   MasterLessonStudent[]   @relation("MasterLessonParticipant")
  groupMemberships    StudentGroupMember[]    @relation("TeachingGroupStudent")
  calendarLessonJoins CalendarLessonStudent[] @relation("CalendarLessonParticipant")
  /// The home-class history (timplan P4), written only by a trigger on this
  /// table; see StudentEnrollment.
  enrollments         StudentEnrollment[]     @relation("EnrollmentStudent")
  /// The school's published "Undervisningstid" statement about this pupil (timplan P4).
  timplanStatements   TimplanStatement[]      @relation("StatementStudent")
  /// Statements this admin published; SET NULL when the admin is removed.
  publishedTimplanStatements TimplanStatementPublication[] @relation("StatementPublisher")
  publishedTimetables        TimetablePublication[]        @relation("TimetablePublisher")

  // Guardian <-> student relations.
  guardianLinks       GuardianStudent[] @relation("GuardianSide")
  studentLinks        GuardianStudent[] @relation("StudentSide")
  absenceReports      AbsenceReport[]   @relation("AbsenceStudent")
  reportedAbsences    AbsenceReport[]   @relation("AbsenceReporter")
  leaveRequests       LeaveRequest[]    @relation("LeaveStudent")
  requestedLeaves     LeaveRequest[]    @relation("LeaveRequester")
  decidedLeaves       LeaveRequest[]    @relation("LeaveDecider")
  referredLeaves      LeaveRequest[]    @relation("LeaveReferrer")
  notifications       Notification[]    @relation("NotificationRecipient")
  roomBookings        RoomBooking[]     @relation("RoomBookingBooker")
  decidedRoomBookings RoomBooking[]     @relation("RoomBookingDecider")
  /// Membership of the substitute pool (20261012110000): at most one row, a
  /// list for the composite key's sake as workRules. readActiveStaffIds
  /// filters on it.
  substitutePoolMemberships SubstitutePoolMember[] @relation("PoolMemberUser")
  /// This person's changes of role, profile and HR-läs, written by a trigger.
  roleChanges               UserRoleChange[]       @relation("RoleChangeSubject")

  @@unique([schoolId, email])
  @@unique([authId, schoolId])
  /// The target a tenant-scoped composite foreign key needs. Redundant as an
  /// index — id is already the primary key — and load-bearing as a constraint:
  /// without it no other table can reference (id, schoolId) at all.
  @@unique([id, schoolId])
  @@index([schoolId])
  @@index([schoolId, role])
  @@index([studentGroupId])
  @@map("Users")
}

/// One change of a person's role, administrator profile or HR-läs
/// (20261110090000), and an administrator's creation. Written only by the
/// trigger Users_role_changes_are_logged, whoever wrote Users; read by the
/// school's administrators through the gateway alone.
model UserRoleChange {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId    String        @db.Uuid
  /// The person changed. Composite (userId, schoolId) key, cascading: the
  /// history goes with the person.
  userId      String        @db.Uuid
  /// Null when the row was created.
  fromRole    UserRole?
  toRole      UserRole
  fromProfile AdminProfile?
  toProfile   AdminProfile?
  fromHrRead  Boolean?
  toHrRead    Boolean
  /// app.current_user_id() of the writer; null for a migration, the seed, the
  /// owner or a sync. No foreign key: the history outlives the writer's row.
  actorId     String?       @db.Uuid
  createdAt   DateTime      @default(dbgenerated("clock_timestamp()")) @db.Timestamptz(6)

  user User @relation("RoleChangeSubject", fields: [userId, schoolId], references: [id, schoolId], onDelete: Cascade)

  @@index([schoolId, userId, createdAt(sort: Desc)])
  @@map("UserRoleChanges")
}

// -----------------------------------------------------------------------------
// Physical resources
// -----------------------------------------------------------------------------

/// Room types a school defines for itself. The scheduler matches a subject's
/// required type against a room's type by identity, so these are rows rather
/// than free text: a typo cannot make a subject unschedulable.
model RoomType {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId  String   @db.Uuid
  name      String
  /// Stable identity for the six values that were enum members before the
  /// school-owned model; null for types a school created itself.
  legacyKey String?
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  school          School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  rooms           Room[]
  subjects        Subject[]
  roomPreferences RoomPreference[]

  @@unique([schoolId, name])
  @@index([schoolId])
  @@map("RoomTypes")
}

model Room {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId         String   @db.Uuid
  name             String
  code             String?
  capacity         Int?
  /// School-owned type (Klassrum, Hemkunskapssal, Trä- och metallslöjd …).
  /// Null means "unspecified", which every requirement accepts.
  roomTypeId       String?  @db.Uuid
  /// Lowest and highest year group allowed in this room, inclusive. Both null
  /// means every year may use it. A school uses these to keep a stage's rooms
  /// to that stage: lågstadiet 0–3, mellanstadiet 4–6, högstadiet 7–9.
  ///
  /// A group's own years are derived from its students' home classes, so a
  /// teaching group carrying no gradeLevel of its own is still held to the
  /// years its members actually belong to.
  minGradeLevel    Int?
  maxGradeLevel    Int?
  /// Where the room is, for the room optimisation: a teacher who walks from
  /// one lesson to the next pays for changing room, more for changing floor
  /// and most for changing building. Both optional, and a school that fills in
  /// neither still has its room changes counted.
  ///
  /// A null building is a building of its own, not a wildcard: a school that
  /// names only its annex means every unnamed room is in the main house, and
  /// the annex is a walk away from all of them. A null floor is unknown and
  /// is never counted as a floor change — guessing would charge a walk the
  /// school never described. The database holds the floor to -5..50 and a
  /// building name to 1..60 characters after trimming.
  building         String?
  floor            Int?
  /// The skolområde the room stands on (Sites, 20261124090000): above the
  /// building, and what the travel time between lessons is measured between.
  /// Null is unknown, never "the same site as the lesson before": a lesson in
  /// a room with no site is held to no travel time and charged none, as a
  /// null floor is never counted as a floor change. Deleting the site empties
  /// it (ON DELETE SET NULL ("siteId")).
  siteId           String?  @db.Uuid
  /// "Special" rooms (labs, gyms, auditoria) whose self-service bookings need
  /// admin approval before they're confirmed. Ordinary rooms auto-approve.
  requiresApproval Boolean  @default(false)
  createdAt        DateTime @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @db.Timestamptz(6)

  school                  School                   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  roomType                RoomType?                @relation(fields: [roomTypeId], references: [id], onDelete: Restrict)
  site                    Site?                    @relation(fields: [siteId, schoolId], references: [id, schoolId], onDelete: SetNull, onUpdate: NoAction)
  masterLessons           MasterLesson[]
  calendarLessons         CalendarLesson[]
  availabilityConstraints AvailabilityConstraint[]
  roomBookings            RoomBooking[]
  preferenceRooms         RoomPreferenceRoom[]

  @@unique([schoolId, name])
  /// The target a tenant-scoped composite foreign key needs; see User.
  @@unique([id, schoolId])
  @@index([schoolId])
  @@index([roomTypeId])
  @@index([siteId])
  @@map("Rooms")
}

/// A skolområde: one of a school's campuses, a walk or a bus ride from the
/// others (migration 20261124090000). Above Room.building, which says where a
/// room is within a site; separate from the skolenhet (SchoolUnit), which is
/// what Skolverket registers — one skolenhet can span two sites and one site
/// can house two skolenheter. A school with no site, or one, is the school it
/// always was: travel is only ever counted between two different sites.
model Site {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId  String   @db.Uuid
  /// 1..60 characters, trimmed; unique per school.
  name      String
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  school       School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  rooms        Room[]
  /// Rastvaktsområden on the site (SupervisionArea, 20261202090000).
  supervisionAreas SupervisionArea[]
  travelFromA  SiteTravelTime[] @relation("SiteTravelA")
  travelFromB  SiteTravelTime[] @relation("SiteTravelB")

  @@unique([schoolId, name])
  /// The target a tenant-scoped composite foreign key needs; see User.
  @@unique([id, schoolId])
  @@map("Sites")
}

/// The minutes it takes to get from one site to another: one figure per PAIR,
/// the same both ways (migration 20261124090000 argues why). Stored once, the
/// lower id first (CHECK "siteAId" < "siteBId"), so a pair cannot hold two
/// figures that disagree. 0..240. A pair with no row is unknown: no warning
/// and no restid between its sites, and the sites card lists it as missing.
model SiteTravelTime {
  schoolId  String   @db.Uuid
  siteAId   String   @db.Uuid
  siteBId   String   @db.Uuid
  minutes   Int
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  siteA  Site   @relation("SiteTravelA", fields: [siteAId, schoolId], references: [id, schoolId], onDelete: Cascade, onUpdate: NoAction)
  siteB  Site   @relation("SiteTravelB", fields: [siteBId, schoolId], references: [id, schoolId], onDelete: Cascade, onUpdate: NoAction)

  @@id([siteAId, siteBId])
  @@index([schoolId])
  @@index([siteBId, schoolId])
  @@map("SiteTravelTimes")
}

model Subject {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId           String   @db.Uuid
  name               String
  code               String?
  color              String?
  /// When set, the optimizer only places this subject in rooms of this type.
  requiredRoomTypeId String?  @db.Uuid
  /// Which cell of the national timplan this school subject feeds — 'MA',
  /// 'SV_SVA' (one cell for Svenska and SvA alike), 'BI' under NO. Null means
  /// "outside the national timplan": mentorstid, a local profile. A school
  /// names its subjects freely ("Matte 7-9") and may split one national cell
  /// across several rows, so the mapping is a column here and the DB enforces
  /// only that the code is a known one (FK to NationalSubject).
  nationalCode       String?
  /// False for the subjects a school schedules that are not undervisning in
  /// the statute's sense — Resurs, Studiehandledning — so they never pollute a
  /// timplan sum. Default true: an existing school sees no change.
  countsTowardTimplan Boolean @default(true)
  /// Skola24's "Faktor ämne": under StaffingPolicy.loadModel FACTOR a teacher
  /// is charged lesson minutes × this. 0.5..3.0 (Subjects_loadFactor_is_sane),
  /// default 1.000; never read under MINUTES. Lesson minutes the pupils sit
  /// are never weighted. See migration 20261010100000.
  loadFactor         Decimal  @default(1.000) @db.Decimal(4, 3)
  /// Ämnesfördelning, the subject's default for every timplanspost that does
  /// not carry its own (TeachingRequirement.ownDistribution): at most this
  /// many lessons a weekday (1..20), and lesson days at least this many
  /// weekdays apart (2..6; 2 is "inte dagar i följd"). Null is no rule, which
  /// is every subject until a school writes one. The generator holds both as
  /// hard rules; a hand edit that breaks one is warned about, never refused.
  /// See migration 20261019090000.
  maxLessonsPerDay   Int?
  minDaysBetween     Int?
  createdAt          DateTime @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime @updatedAt @db.Timestamptz(6)

  school               School                @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  requiredRoomType     RoomType?             @relation(fields: [requiredRoomTypeId], references: [id], onDelete: Restrict)
  nationalSubject      NationalSubject?      @relation(fields: [nationalCode], references: [code], onDelete: Restrict)
  teachingRequirements TeachingRequirement[]
  masterLessons        MasterLesson[]
  calendarLessons      CalendarLesson[]
  roomPreferences      RoomPreference[]
  teacherQualifications TeacherSubjectQualification[]
  localTimplanEntries   LocalTimplanEntry[]
  teacherDuties         TeacherDuty[]
  timplanCredits        TimplanCredit[]

  @@unique([schoolId, code])
  /// The target a tenant-scoped composite foreign key needs; see User.
  @@unique([id, schoolId])
  @@index([schoolId])
  @@map("Subjects")
}

// -----------------------------------------------------------------------------
// The national timplan — reference data, NO schoolId
//
// Skolförordningen (2011:185) bilaga 1–4 as rows: one version per bilaga per
// lydelse, one subject per ämne the bilagor name, one entry per printed cell.
// These are the only tables here without `schoolId`, and on purpose: the rows
// belong to nobody, they are the law, identical for every tenant and written
// only by a migration (which also re-adds the statute's printed totals and
// refuses the deploy on a mismatch). RLS: SELECT for every authenticated role,
// no write policy and no write grant for any API role — the posture of
// `_prisma_migrations`, turned the other way. See the migration
// 20261006090000 for the shape of a cell and every argued decision.
// -----------------------------------------------------------------------------

/// Which bilaga a version is. The statute keeps five timplaner: grundskolan
/// (bilaga 1), anpassade grundskolan twice (bilaga 2: ämnen and ämnesområden),
/// specialskolan (3) and sameskolan (4).
enum SchoolForm {
  GRUNDSKOLA
  ANPASSAD_GRUNDSKOLA_AMNEN
  ANPASSAD_GRUNDSKOLA_AMNESOMRADEN
  SPECIALSKOLA
  SAMESKOLA
}

/// The stadium a cell is printed under. LAG_MELLAN is the merged "Låg- och
/// mellanstadiet" column hem- och konsumentkunskap is printed in: one cell in
/// the statute, so one row here, and never beside a LAG or MELLAN row for the
/// same ämne.
enum TimplanStage {
  LAG
  MELLAN
  HOG
  LAG_MELLAN
}

/// The numbers a läsår gives its årskurser (20261126091000): NIOARIG today's,
/// förskoleklass 0; TIOARIG those of SFS 2025:729 from HT 2028, no förskoleklass.
enum GradeNumbering {
  NIOARIG
  TIOARIG
}

/// How a national lydelse applies to a pupil; see NationalTimplanVersion.appliesBy.
enum TimplanApplicability {
  STAGES_NOT_COMPLETED
  COHORTS_STARTING
}

model NationalTimplanVersion {
  id                    String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// 'SFS2023:945/B1': the författning the figures are the lydelse of, and the
  /// bilaga — three bilagor share SFS 2023:945, so the SFS alone is no key.
  code                  String     @unique
  sfs                   String
  title                 String
  schoolForm            SchoolForm
  /// "Totalt garanterat antal timmar" — 6 890, 6 665, 8 070, 4 473; for the
  /// 2028 law 7 424, 7 199, 8 604 and 5 007, totals without cells.
  totalHours            Int
  /// "Därav skolans val". Null where the bilaga prints no such row.
  skolansValHours       Int?
  /// "minskas med högst 20 procent" — 15 in sameskolan; null where the
  /// statute states no percentage (anpassade grundskolan, the 2028 law).
  reductionCapPercent   Int?
  /// 'HT2024': the term from which utbildning som påbörjas falls under this
  /// lydelse. Cohort-scoped, not calendar-scoped: åk 7–9 in 2024/25 still read
  /// the older bilaga 1.
  appliesFromCohortTerm String
  supersededByCode      String?
  /// HOW the lydelse applies (20261010130000): STAGES_NOT_COMPLETED — to the
  /// stadier a pupil had not finished when it came into force (SFS 2023:945
  /// övergångsbestämmelse 3); COHORTS_STARTING — to the cohorts starting åk 1
  /// from appliesFromCohortTerm (SFS 2025:729 övergångsbestämmelse 12).
  appliesBy             TimplanApplicability
  createdAt             DateTime   @default(now()) @db.Timestamptz(6)

  supersededBy NationalTimplanVersion?  @relation("TimplanSupersession", fields: [supersededByCode], references: [code], onDelete: Restrict)
  supersedes   NationalTimplanVersion[] @relation("TimplanSupersession")
  entries      NationalTimplanEntry[]
  localTimplans LocalTimplan[]
  statements    TimplanStatement[]

  /// The target LocalTimplan's (nationalTimplanVersionId, schoolForm) key
  /// needs: redundant as an index, load-bearing as the rule that a local plan
  /// is checked against a version of its own school form.
  @@unique([id, schoolForm])
  @@map("NationalTimplanVersions")
}

/// An ämne the bilagor name. NO and SO are ämnesgrupper (`isGroup`) with
/// biologi/fysik/kemi and geografi/historia/religionskunskap/samhällskunskap
/// as children; "svenska eller svenska som andraspråk" is ONE row, SV_SVA,
/// because it is one cell.
model NationalSubject {
  code       String  @id
  name       String
  parentCode String?
  isGroup    Boolean @default(false)

  parent   NationalSubject?  @relation("NationalSubjectGroup", fields: [parentCode], references: [code], onDelete: Restrict)
  children NationalSubject[] @relation("NationalSubjectGroup")
  entries  NationalTimplanEntry[]
  subjects Subject[]
  statements TimplanStatement[]

  @@map("NationalSubjects")
}

/// One printed cell. On a top-level ämne `hours` is the guaranteed figure; on
/// a child of an ämnesgrupp it is the minimum printed on that child's own line,
/// and the group's hours minus its children's is the "resterande N timmar får
/// fördelas fritt" — so children are never added to a total.
model NationalTimplanEntry {
  id                     String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  versionId              String       @db.Uuid
  subjectCode            String
  stage                  TimplanStage
  hours                  Int
  /// The uniform per-child minimum the prose states for an ämnesgrupp cell
  /// ("en minsta undervisningstid om 60 timmar i respektive ämne"); null where
  /// the minima differ per child (every SO cell) and on every leaf.
  minimumHoursPerChild   Int?
  /// "Antalet timmar för ... får dock inte minskas": svenska/SvA, engelska,
  /// matematik and språkval, plus samiska in sameskolan.
  protectedFromReduction Boolean      @default(false)

  version NationalTimplanVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  subject NationalSubject        @relation(fields: [subjectCode], references: [code], onDelete: Restrict)

  @@unique([versionId, subjectCode, stage])
  @@map("NationalTimplanEntries")
}

// -----------------------------------------------------------------------------
// The local timplan — a school's own decision, checked against the statute
//
// The huvudman's fördelning mellan årskurserna (skolförordningen 9 kap. 4 §):
// minutes per week per school subject per årskurs, in a named plan of one
// school form, checked against one national version. DRAFT until a decision is
// recorded; a DECIDED plan is a record — two triggers refuse any change to it
// or its entries (SQLSTATE TP409, message TIMPLAN_IS_DECIDED), the one
// exception being the copiedFromId pointer cleared when its source is deleted.
// Deleting a decided plan is allowed; deleting a subject a decided plan
// contains is refused by the same entries trigger. RLS: admin_all,
// staff_select (all plans), family_select (STUDENT/GUARDIAN, DECIDED only).
// See migration 20261006120000 for every argued decision, including how an
// årskurs maps to a stadium per school form.
// -----------------------------------------------------------------------------

enum LocalTimplanStatus {
  DRAFT
  DECIDED
}

model LocalTimplan {
  id                       String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId                 String             @db.Uuid
  /// Unique per school; non-blank, at most 100 characters.
  name                     String
  /// Must equal the version's school form: the composite key
  /// (nationalTimplanVersionId, schoolForm) -> NationalTimplanVersion(id, schoolForm).
  schoolForm               SchoolForm
  nationalTimplanVersionId String             @db.Uuid
  /// Standardveckor used to turn min/vecka into stage hours before a läsår
  /// exists. 20.0..40.0; 35.6 = 178 skoldagar / 5. A Decimal: read it with
  /// Decimal arithmetic (tenths), never as a float, a string or 0.
  planningWeeks            Decimal            @default(35.6) @db.Decimal(4, 1)
  status                   LocalTimplanStatus @default(DRAFT)
  /// The decision is whole: decidedAt, decidedByUserId and decisionNote are
  /// all null on a DRAFT and all set on a DECIDED plan (DB CHECK).
  decidedAt                DateTime?          @db.Timestamptz(6)
  decidedByUserId          String?            @db.Uuid
  /// Non-blank, at most 500 characters.
  decisionNote             String?
  /// The plan this one was reopened or copied from. Cleared (that column only,
  /// ON DELETE SET NULL ("copiedFromId")) when the source is deleted; Prisma
  /// cannot state the column list and the migration does.
  copiedFromId             String?            @db.Uuid
  createdAt                DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt                DateTime           @updatedAt @db.Timestamptz(6)

  school          School                 @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  nationalVersion NationalTimplanVersion @relation(fields: [nationalTimplanVersionId, schoolForm], references: [id, schoolForm], onDelete: Restrict, onUpdate: Restrict)
  decidedBy       User?                  @relation("LocalTimplanDecider", fields: [decidedByUserId, schoolId], references: [id, schoolId], onDelete: Restrict, onUpdate: Restrict)
  copiedFrom      LocalTimplan?          @relation("LocalTimplanCopy", fields: [copiedFromId, schoolId], references: [id, schoolId], onDelete: SetNull, onUpdate: NoAction)
  copies          LocalTimplan[]         @relation("LocalTimplanCopy")
  entries         LocalTimplanEntry[]
  /// The (läsår, årskurs) pairs that follow this plan. ON DELETE RESTRICT:
  /// a plan a year follows cannot be deleted (409 TIMPLAN_IN_USE).
  academicYears   AcademicYearTimplan[]

  @@unique([schoolId, name])
  /// The target of the composite keys entries and copies use; see User.
  @@unique([id, schoolId])
  @@map("LocalTimplans")
}

/// Minutes per week for one school subject in one årskurs of a plan. Keyed on
/// the SCHOOL subject, not the national code: the national comparison rolls up
/// through Subject.nationalCode. No timestamps — entries are replaced
/// wholesale, and the plan's updatedAt is their time.
model LocalTimplanEntry {
  id             String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId       String  @db.Uuid
  localTimplanId String  @db.Uuid
  subjectId      String  @db.Uuid
  /// 0..11. 0 = förskoleklass (in no stadium); 10 = specialskolan today, the
  /// tioårig grundskola from 2028; 11 = specialskolan from 2028.
  gradeLevel     Int
  /// 0..1200, integer minutes, not on the 5-minute grid: a target, not a lesson.
  minutesPerWeek Int
  /// At most 500 characters.
  note           String?

  school       School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  localTimplan LocalTimplan @relation(fields: [localTimplanId, schoolId], references: [id, schoolId], onDelete: Cascade)
  /// Cascades with the subject — unless the plan is DECIDED, when the entries
  /// trigger refuses the cascade and with it the subject's deletion.
  subject      Subject      @relation(fields: [subjectId, schoolId], references: [id, schoolId], onDelete: Cascade)

  @@unique([localTimplanId, subjectId, gradeLevel])
  @@index([schoolId, subjectId])
  @@map("LocalTimplanEntries")
}

/// Which lokal timplan one årskurs follows in one läsår — the statute's
/// cohort-scoped versioning (in 2024/25 åk 1-6 follow SFS 2023:945, åk 7-9
/// the older bilaga). One row per (year, grade); "no plan" is the absence of a
/// row. A DRAFT plan may be attached (next year is planned in spring); every
/// reader marks it, and the family arm shows pupils and guardians only rows
/// whose plan is DECIDED. A plain per-year table, so läsårsrullning can copy
/// it with INSERT ... SELECT. See migration 20261007130000.
model AcademicYearTimplan {
  schoolId       String   @db.Uuid
  /// Composite (academicYearId, schoolId) key; cascades with the year.
  academicYearId String   @db.Uuid
  /// 0..11, the bound LocalTimplanEntry.gradeLevel has (DB CHECK).
  gradeLevel     Int
  /// Composite (localTimplanId, schoolId) key, ON DELETE RESTRICT.
  localTimplanId String   @db.Uuid
  createdAt      DateTime @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @db.Timestamptz(6)

  school       School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicYear AcademicYear @relation(fields: [academicYearId, schoolId], references: [id, schoolId], onDelete: Cascade)
  localTimplan LocalTimplan @relation(fields: [localTimplanId, schoolId], references: [id, schoolId], onDelete: Restrict)

  @@id([academicYearId, gradeLevel])
  @@index([localTimplanId, schoolId])
  @@map("AcademicYearTimplans")
}

/// Tillgodoräknad undervisningstid: the school's written decision that an
/// activity on one date counts toward the timplan — "the friluftsdag 25
/// September counts as 300 min idrott och hälsa for åk 7–9". The absence of a
/// row is the decision that a day does not count. Read by the timplan's
/// delivered layer (src/common/timplan-delivered.ts). See 20261009100000.
model TimplanCredit {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId       String   @db.Uuid
  /// Composite (academicYearId, schoolId) key; cascades with the year.
  academicYearId String   @db.Uuid
  date           DateTime @db.Date
  /// 1..600 (DB CHECK). A split day is several rows.
  minutes        Int
  /// Null: undervisningstid without a subject ("Utan ämne"), never "does not
  /// count" — that is the absence of a row. Composite key, ON DELETE CASCADE.
  subjectId      String?  @db.Uuid
  /// Scope: a group, a grade span (judged by the home class's årskurs), or
  /// neither — the whole school. Never both (DB CHECK).
  studentGroupId String?  @db.Uuid
  minGradeLevel  Int?
  maxGradeLevel  Int?
  /// Non-blank, at most 80 code points (DB CHECK).
  name           String
  /// Null, or non-blank and at most 500 code points (DB CHECK).
  note           String?
  createdAt      DateTime @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @db.Timestamptz(6)

  school       School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicYear AcademicYear  @relation(fields: [academicYearId, schoolId], references: [id, schoolId], onDelete: Cascade)
  subject      Subject?      @relation(fields: [subjectId, schoolId], references: [id, schoolId], onDelete: Cascade)
  studentGroup StudentGroup? @relation(fields: [studentGroupId, schoolId], references: [id, schoolId], onDelete: Cascade)

  batchLinks CancellationBatchCredit[]

  @@unique([id, schoolId])
  @@index([schoolId, academicYearId, date])
  @@index([studentGroupId, schoolId])
  @@index([subjectId, schoolId])
  @@map("TimplanCredits")
}

/// Where a segment of a pupil's class history came from: RECORDED by the
/// Users trigger as the class changed, or BACKFILL — the one fact the database
/// held when the history began (each active pupil's current class), written by
/// migration 20261010120000.
enum EnrollmentSource {
  RECORDED
  BACKFILL
}

/// A pupil's home-class history (timplan P4): one row per SEGMENT, an
/// unbroken period [validFrom, validTo) in one läsår during which the pupil
/// had one home class. validTo null is the class the pupil has now; exactly one
/// open row exists iff the pupil is an active STUDENT with a class.
///
/// WRITTEN ONLY BY THE DATABASE. An AFTER trigger on Users
/// (app.student_enrollments_follow_the_class) writes it in the same statement
/// as every change of studentGroupId, isActive or role — the services, the
/// imports, the activation, a class's SET NULL and PostgREST alike — and a
/// guard (SQLSTATE SE403) refuses any other write, the owner's and the service
/// key's included. RLS: admin and teacher read the school's, a pupil their
/// own, a guardian their children's. Not stated here, because schema.prisma
/// cannot: the EXCLUDE constraint StudentEnrollments_one_class_at_a_time (no
/// two segments of a pupil overlap in a year) and the partial unique index
/// StudentEnrollments_one_open_per_pupil. See 20261010120000.
model StudentEnrollment {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId       String           @db.Uuid
  studentId      String           @db.Uuid
  academicYearId String           @db.Uuid
  /// Null when the class was deleted: the period is then unrecorded, never zero.
  studentGroupId String?          @db.Uuid
  /// The class's årskurs, kept in step with StudentGroups.gradeLevel; null when
  /// the class has none.
  gradeLevel     Int?
  /// The school's local date, inclusive.
  validFrom      DateTime         @db.Date
  /// Exclusive; null is the current class.
  validTo        DateTime?        @db.Date
  source         EnrollmentSource @default(RECORDED)
  createdAt      DateTime         @default(now()) @db.Timestamptz(6)
  /// Set by the trigger; no API role writes this table.
  updatedAt      DateTime         @default(now()) @db.Timestamptz(6)

  school       School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student      User          @relation("EnrollmentStudent", fields: [studentId, schoolId], references: [id, schoolId], onDelete: Cascade)
  academicYear AcademicYear  @relation(fields: [academicYearId, schoolId], references: [id, schoolId], onDelete: Cascade)
  /// ON DELETE SET NULL ("studentGroupId") — that column only, which Prisma's
  /// SetNull cannot say and the migration does — and ON UPDATE NO ACTION: a
  /// class with history keeps its year.
  studentGroup StudentGroup? @relation(fields: [studentGroupId, academicYearId, schoolId], references: [id, academicYearId, schoolId], onDelete: SetNull, onUpdate: NoAction)

  @@index([schoolId, academicYearId])
  @@index([studentGroupId, schoolId])
  @@index([studentId, academicYearId, validFrom])
  @@map("StudentEnrollments")
}

/// The school's published "Undervisningstid" statement (timplan P4): at most
/// one per school, computed for the active year by the stage module and read
/// by pupils and guardians on their cards while that year is the active one.
/// RLS: admin all; STUDENT and GUARDIAN read the row (date and year only).
/// See migration 20261010140000.
model TimplanStatementPublication {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId          String   @unique @db.Uuid
  academicYearId    String   @db.Uuid
  publishedAt       DateTime @default(now()) @db.Timestamptz(6)
  /// Cleared — that column only, ON DELETE SET NULL ("publishedByUserId"),
  /// which Prisma cannot say — when the publishing admin is removed.
  publishedByUserId String?  @db.Uuid
  asOfDate          DateTime @db.Date
  pupils            Int
  createdAt         DateTime @default(now()) @db.Timestamptz(6)

  school       School             @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicYear AcademicYear       @relation(fields: [academicYearId, schoolId], references: [id, schoolId], onDelete: Cascade)
  publishedBy  User?              @relation("StatementPublisher", fields: [publishedByUserId, schoolId], references: [id, schoolId], onDelete: SetNull, onUpdate: NoAction)
  statements   TimplanStatement[]

  @@unique([id, schoolId])
  /// The target of the statement rows' key: their year and day are this row's.
  @@unique([id, academicYearId, asOfDate, schoolId])
  @@index([academicYearId, schoolId])
  @@index([publishedByUserId, schoolId])
  @@map("TimplanStatementPublications")
}

/// One row of a published statement: a pupil's hours in one national cell of
/// the stadium they are in now. No teacher, group or other pupil in it. RLS:
/// admin all; a STUDENT their own rows; a GUARDIAN their children's.
model TimplanStatement {
  id                    String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId              String       @db.Uuid
  publicationId         String       @db.Uuid
  /// The publication's year and the school's day it was published, copied so
  /// a family reads the card without the publication row (which names an
  /// admin); held equal by the key below.
  academicYearId        String       @db.Uuid
  asOfDate              DateTime     @db.Date
  studentId             String       @db.Uuid
  stage                 TimplanStage
  /// A top-level national code (MA, SV_SVA, NO …).
  subjectCode           String
  /// The lydelse the cell is judged against; null when the reference data has none.
  versionCode           String?
  distributionPublished Boolean
  gradesFrom            Int
  gradesTo              Int
  nationalHours         Decimal?     @db.Decimal(6, 1)
  plannedHours          Decimal      @db.Decimal(6, 1)
  outcomeHours          Decimal      @db.Decimal(6, 1)
  projectedHours        Decimal      @db.Decimal(6, 1)
  /// MET | BELOW | BELOW_WITHIN_CAP | UNRECORDED | NO_NATIONAL (DB CHECK).
  status                String
  projectedStatus       String
  /// Every grade of the stage recorded in full or planned ahead.
  complete              Boolean
  /// The first recorded day of the stage: "… timmar sedan {recordedFrom}".
  recordedFrom          DateTime?    @db.Date
  plannedGrades         Int[]        @default([])
  /// Grades of the stage with no class history.
  unrecordedGrades      Int[]        @default([])
  /// Grades ahead that no plan carries yet.
  unplannedGrades       Int[]        @default([])
  backfilled            Boolean      @default(false)
  /// When backfilled: the day the class history began; the class before it is assumed.
  historyFrom           DateTime?    @db.Date

  school      School                      @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  publication TimplanStatementPublication @relation(fields: [publicationId, academicYearId, asOfDate, schoolId], references: [id, academicYearId, asOfDate, schoolId], onDelete: Cascade)
  student     User                        @relation("StatementStudent", fields: [studentId, schoolId], references: [id, schoolId], onDelete: Cascade)
  subject     NationalSubject             @relation(fields: [subjectCode], references: [code], onDelete: Restrict)
  version     NationalTimplanVersion?     @relation(fields: [versionCode], references: [code], onDelete: Restrict)

  @@unique([publicationId, studentId, stage, subjectCode])
  @@index([studentId])
  @@index([schoolId])
  @@map("TimplanStatements")
}

// -----------------------------------------------------------------------------
// Publicering (migration 20261011090000): the school's publish policy, the log
// of what was published with its validity, and a DRAFT publication's lessons.
// -----------------------------------------------------------------------------

enum PublishMode {
  /// Today's behaviour: every grundschema edit reaches the calendar at once.
  DIRECT
  /// Grundschema edits stay a draft, invisible to non-admins, until published.
  DRAFT
}

enum PublishGateMode {
  WARN
  REFUSE
}

enum PublicationKind {
  PUBLISH
  LEGACY_PUBLISH
  BASELINE
  REFILL
}

enum PublicationOutcome {
  PUBLISHED
  REFUSED
}

enum PublicScopeKind {
  GROUP
  TEACHER
  ROOM
}

enum TeacherDisplay {
  NONE
  SIGNATURE
  NAME
}

/// At most one row per school; no row means every default (DIRECT, all WARN).
model PublicationSettings {
  id                 String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId           String          @unique @db.Uuid
  publishMode        PublishMode     @default(DIRECT)
  gateClashes        PublishGateMode @default(WARN)
  gateParked         PublishGateMode @default(WARN)
  gateUnplaced       PublishGateMode @default(WARN)
  gateUnstaffed      PublishGateMode @default(WARN)
  gateMissingTeacher PublishGateMode @default(WARN)
  gateMissingRoom    PublishGateMode @default(WARN)
  gateStaffing       PublishGateMode @default(WARN)
  gateTimplan        PublishGateMode @default(WARN)
  gateOverlap        PublishGateMode @default(WARN)
  gatePast           PublishGateMode @default(WARN)
  gateLunch          PublishGateMode @default(WARN)
  gateWeekSplit      PublishGateMode @default(WARN)
  gateGap            PublishGateMode @default(WARN)
  gateDayOpsLost     PublishGateMode @default(WARN)
  /// A half of a class with lessons and no pupils (PUB_EMPTY_HALF, 20261113090000).
  gateEmptyHalf      PublishGateMode @default(WARN)
  /// The public viewer (20261011120000): everything off by default.
  publicViewerEnabled  Boolean        @default(false)
  publicGroups         Boolean        @default(false)
  publicTeachers       Boolean        @default(false)
  publicRooms          Boolean        @default(false)
  /// NONE by default; the TEACHER scope requires another (CHECK).
  publicTeacherDisplay TeacherDisplay @default(NONE)
  publicShowMeals      Boolean        @default(true)
  /// The smallest teaching group shown by name. 3..30.
  publicMinGroupSize   Int            @default(5)
  /// Embedding (20261102090000): per scope, off by default, and the school's
  /// websites that may frame the viewer (frame-ancestors; at most ten
  /// lowercase https origins, CHECK).
  publicEmbedGroups    Boolean        @default(false)
  publicEmbedTeachers  Boolean        @default(false)
  publicEmbedRooms     Boolean        @default(false)
  publicEmbedOrigins   String[]       @default([])
  /// Kalenderprenumeration (20261112091000), per audience, off by default.
  /// Turning one off revokes that audience's live feeds (a trigger).
  calendarFeedTeachers  Boolean      @default(false)
  calendarFeedStudents  Boolean      @default(false)
  calendarFeedGuardians Boolean      @default(false)
  createdAt          DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime        @default(now()) @updatedAt @db.Timestamptz(6)

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@map("PublicationSettings")
}

/// One publish attempt that reached the gates. Append-only by privilege.
model TimetablePublication {
  id                   String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId             String             @db.Uuid
  academicYearId       String             @db.Uuid
  kind                 PublicationKind
  outcome              PublicationOutcome
  publishMode          PublishMode
  validFrom            DateTime           @db.Date
  validTo              DateTime           @db.Date
  publishedAt          DateTime           @default(now()) @db.Timestamptz(6)
  /// Cleared — that column only — when the publishing admin is removed.
  publishedByUserId    String?            @db.Uuid
  created              Int                @default(0)
  cancelled            Int                @default(0)
  skipped              Int                @default(0)
  moved                Int                @default(0)
  removed              Int                @default(0)
  adopted              Int                @default(0)
  /// The snapshot's size; null when nothing was snapshotted (DIRECT, REFUSED).
  lessonCount          Int?
  gates                Json               @default("[]")
  acknowledgedWarnings Boolean            @default(false)

  school       School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicYear AcademicYear      @relation(fields: [academicYearId, schoolId], references: [id, schoolId], onDelete: Cascade)
  publishedBy  User?             @relation("TimetablePublisher", fields: [publishedByUserId, schoolId], references: [id, schoolId], onDelete: SetNull, onUpdate: NoAction)
  lessons      PublishedLesson[]
  lunchSittings PublishedLunchSitting[]

  @@unique([id, schoolId])
  @@unique([id, academicYearId, schoolId])
  @@index([academicYearId, schoolId, publishedAt])
  @@index([publishedByUserId, schoolId])
  @@map("TimetablePublications")
}

/// The grundschema a DRAFT publication published. No FK to what it names:
/// readers map a vanished reference the way the live key would have acted.
model PublishedLesson {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId       String           @db.Uuid
  publicationId  String           @db.Uuid
  academicYearId String           @db.Uuid
  masterLessonId String           @db.Uuid
  subjectId      String           @db.Uuid
  studentGroupId String           @db.Uuid
  teacherId      String?          @db.Uuid
  coTeacherId    String?          @db.Uuid
  roomId         String?          @db.Uuid
  dayOfWeek      Int
  startTime      DateTime         @db.Time(6)
  endTime        DateTime         @db.Time(6)
  isLocked       Boolean
  isGenerated    Boolean
  isParked       Boolean
  recurrence     LessonRecurrence
  startDate      DateTime?        @db.Date
  endDate        DateTime?        @db.Date
  extraGroupIds  String[]         @default([]) @db.Uuid
  studentIds     String[]         @default([]) @db.Uuid

  school      School               @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  publication TimetablePublication @relation(fields: [publicationId, academicYearId, schoolId], references: [id, academicYearId, schoolId], onDelete: Cascade)

  @@unique([publicationId, masterLessonId])
  @@index([schoolId])
  @@map("PublishedLessons")
}

/// The lunch sittings a snapshot publication published (20261011130000):
/// what a DRAFT school's refill materialises its meals from. No FK to the
/// group; a reader drops a row whose group is gone. Append-only by privilege.
model PublishedLunchSitting {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId       String   @db.Uuid
  publicationId  String   @db.Uuid
  academicYearId String   @db.Uuid
  studentGroupId String   @db.Uuid
  dayOfWeek      Int
  startTime      DateTime @db.Time(6)
  endTime        DateTime @db.Time(6)

  school      School               @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  publication TimetablePublication @relation(fields: [publicationId, academicYearId, schoolId], references: [id, academicYearId, schoolId], onDelete: Cascade)

  @@unique([publicationId, studentGroupId, dayOfWeek])
  @@index([schoolId])
  @@map("PublishedLunchSittings")
}

/// A calendar row whose template was deleted in a DRAFT school
/// (20261011100000; every row, the past too, since 20261011132000). Written
/// only by the trigger on MasterLessons; the next publish adopts, deletes or
/// leaves the row, and releases a past row once the deletion is published.
model PublicationPendingRemoval {
  calendarLessonId String   @id @db.Uuid
  schoolId         String   @db.Uuid
  academicYearId   String   @db.Uuid
  /// The deleted template's id: the row's published key until it is settled.
  masterLessonId   String   @db.Uuid
  /// Whether a publish could still move or delete the row when its template
  /// was deleted: SCHEDULED, not begun, no attendance.
  reconcilable     Boolean
  recordedAt       DateTime @default(now()) @db.Timestamptz(6)

  calendarLesson CalendarLesson @relation(fields: [calendarLessonId, schoolId], references: [id, schoolId], onDelete: Cascade)

  @@index([academicYearId, schoolId])
  @@index([schoolId])
  @@map("PublicationPendingRemovals")
}

/// A bulk avbokning (migration 20261011110000): the selection, the rows it
/// cancelled and how it was reversed. The admin's record; families read the
/// cancelled lessons in the calendar.
model CancellationBatch {
  id               String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId         String            @db.Uuid
  academicYearId   String            @db.Uuid
  name             String
  /// EVENT or MANUAL only (CHECK).
  cause            LessonCancelCause
  fromDate         DateTime          @db.Date
  /// At most 30 days after fromDate (CHECK): 31 days inclusive.
  toDate           DateTime          @db.Date
  startTime        DateTime?         @db.Time(6)
  endTime          DateTime?         @db.Time(6)
  /// SCHOOL, GRADES or GROUPS (CHECK).
  scope            String
  minGradeLevel    Int?
  maxGradeLevel    Int?
  groupIds         String[]          @default([]) @db.Uuid
  cancelled        Int               @default(0)
  createdAt        DateTime          @default(now()) @db.Timestamptz(6)
  createdByUserId  String?           @db.Uuid
  reversedAt       DateTime?         @db.Timestamptz(6)
  reversedByUserId String?           @db.Uuid
  reinstated       Int               @default(0)
  skippedRoomTaken Int               @default(0)
  /// Told its people (CANCELLATION_DIGEST) when made, so its reversal tells them too (20261018091000).
  notifies         Boolean           @default(false)

  lessons CancellationBatchLesson[]
  credits CancellationBatchCredit[]

  @@unique([id, schoolId])
  @@index([academicYearId, schoolId, fromDate])
  @@index([createdByUserId, schoolId])
  @@index([reversedByUserId, schoolId])
  @@map("CancellationBatches")
}

model CancellationBatchLesson {
  batchId          String  @db.Uuid
  calendarLessonId String  @db.Uuid
  schoolId         String  @db.Uuid
  /// The note the lesson carried before the batch; restored on reversal.
  previousNote     String?

  batch          CancellationBatch @relation(fields: [batchId, schoolId], references: [id, schoolId], onDelete: Cascade)
  calendarLesson CalendarLesson    @relation(fields: [calendarLessonId, schoolId], references: [id, schoolId], onDelete: Cascade)

  @@id([batchId, calendarLessonId])
  @@index([calendarLessonId, schoolId])
  @@index([schoolId])
  @@map("CancellationBatchLessons")
}

model CancellationBatchCredit {
  batchId  String @db.Uuid
  creditId String @unique @db.Uuid
  schoolId String @db.Uuid

  batch  CancellationBatch @relation(fields: [batchId, schoolId], references: [id, schoolId], onDelete: Cascade)
  credit TimplanCredit     @relation(fields: [creditId, schoolId], references: [id, schoolId], onDelete: Cascade)

  @@id([batchId, creditId])
  @@index([schoolId])
  @@map("CancellationBatchCredits")
}

/// A shared, revocable link to the public viewer (20261011120000). Only the
/// token's sha256 is stored. The keys to the school, year, target and creator
/// are composite (id, schoolId) foreign keys in the migration; the API reads
/// and writes this table through the admin's RLS and never navigates them.
model PublicTimetableLink {
  id              String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId        String          @db.Uuid
  academicYearId  String          @db.Uuid
  kind            PublicScopeKind
  targetGroupId   String?         @db.Uuid
  targetTeacherId String?         @db.Uuid
  targetRoomId    String?         @db.Uuid
  tokenHash       String          @unique
  label           String?
  createdAt       DateTime        @default(now()) @db.Timestamptz(6)
  createdByUserId String?         @db.Uuid
  revokedAt       DateTime?       @db.Timestamptz(6)
  lastUsedAt      DateTime?       @db.Timestamptz(6)

  @@index([schoolId, academicYearId])
  @@map("PublicTimetableLinks")
}

/// A teacher never shown on a public timetable (skyddad identitet).
model TeacherPublicLabel {
  userId    String   @id @db.Uuid
  schoolId  String   @db.Uuid
  hidden    Boolean  @default(false)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  @@index([schoolId])
  @@map("TeacherPublicLabels")
}

model AcademicYear {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId  String   @db.Uuid
  name      String
  startDate DateTime @db.Date
  endDate   DateTime @db.Date
  isActive  Boolean  @default(false)
  /// The year this one was rolled over from (läsårsrullning). Written at
  /// INSERT only: a trigger refuses every later change (SQLSTATE LR409,
  /// ROLLOVER_LINK_IS_FIXED) except the foreign key clearing it — this column
  /// only, ON DELETE SET NULL ("predecessorId"), which Prisma's SetNull below
  /// cannot say and the migration does — when the predecessor is deleted. At
  /// most one successor per year (@@unique below). See 20261007150000.
  predecessorId        String?  @db.Uuid
  /// The årskurs that left school at the hand-over into this year: a class of
  /// the predecessor at or above it got no successor, and activation calls its
  /// pupils graduates. 0..12. Set by the rollover; never moves anyone.
  graduatingGradeLevel Int?
  /// The numbering its årskurser are in (SFS 2025:729 övergångsbestämmelse
  /// 4 numbers them anew from HT 2028). Written once, at INSERT (GN409 after);
  /// TIOARIG only for a year starting 2028-07-01 or later (CHECK). Left out,
  /// a trigger fills it: NIOARIG before 2028-07-01, else the numbering of the
  /// school's latest year from that date, else TIOARIG. See 20261126091000.
  gradeNumbering       GradeNumbering @default(dbgenerated())
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  school               School                @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  predecessor          AcademicYear?         @relation("YearSuccession", fields: [predecessorId, schoolId], references: [id, schoolId], onDelete: SetNull, onUpdate: NoAction)
  successor            AcademicYear?         @relation("YearSuccession")
  studentGroups        StudentGroup[]
  teachingRequirements TeachingRequirement[]
  /// Parallella block: the rows of this year that run together (TeachingBlock).
  teachingBlocks       TeachingBlock[]
  masterLessons        MasterLesson[]
  schoolBreaks         SchoolBreak[]
  lunchSittings        LunchSitting[]
  teacherEmployments   TeacherEmployment[]
  teacherDuties        TeacherDuty[]
  /// The year's rastvaktsschema (SupervisionShift).
  supervisionShifts    SupervisionShift[]
  teacherEmploymentLogs TeacherEmploymentLog[]
  /// Which lokal timplan each årskurs follows this year.
  timplans             AcademicYearTimplan[]
  /// The school's decisions that a day's activity counts as undervisningstid.
  timplanCredits       TimplanCredit[]
  /// Who sat in which class this year (timplan P4).
  studentEnrollments   StudentEnrollment[]
  /// The published "Undervisningstid" statement computed for this year.
  timplanStatementPublications TimplanStatementPublication[]
  timetablePublications TimetablePublication[]
  /// Schemaförslag: the year's candidate runs, deleted with it.
  scheduleCandidateRuns ScheduleCandidateRun[]

  @@unique([schoolId, name])
  /// The target a tenant-scoped composite foreign key needs; see User.
  @@unique([id, schoolId])
  /// One successor per year; also the index the predecessor key's SET NULL scans.
  @@unique([predecessorId, schoolId])
  @@index([schoolId])
  @@index([schoolId, startDate, endDate])
  // Not stated here, because schema.prisma cannot state a partial index: the
  // unique index AcademicYears_one_active_per_school on (schoolId) WHERE
  // isActive, from migration 20260914090000. It is what keeps a school to one
  // active year. Prisma's differ skips it, so a migration generated from this
  // file will never mention it, whether it is there or not.
  @@map("AcademicYears")
}

/// What a group IS, rather than what it happens to contain right now.
///
/// The two were previously told apart by guesswork — "no gradeLevel, so
/// probably a teaching group" — which misfiles a nivågrupp that does carry a
/// year, and files every freshly created teaching group under classes until
/// somebody adds its first member.
enum StudentGroupKind {
  /// A home class: every member follows all of its lessons (7A, 8B).
  CLASS
  /// A teaching group cutting across classes (Ma71, språkval En74).
  TEACHING_GROUP
}

/// A skolform as S1 SchoolTypesEnum spells it, of the seven a
/// grundskola-shaped school has (TR is anpassad grundskola, ämnesområden).
enum SchoolUnitType {
  FKLASS
  FTH
  GR
  GRS
  TR
  SP
  SAM
}

/// A skolenhet: Skolverket's unit, the one SCB's Pedagogisk personal and an
/// SS12000 Organisation of type Skolenhet count by. A school has none (as
/// before), one, or several, and a class belongs to the unit whose årskurs
/// span holds its gradeLevel — spans never overlap within a school (trigger,
/// SU409). One rule in src/school-units/school-unit-map.ts and
/// web/lib/school-units.ts; see migration 20261031090000.
model SchoolUnit {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId    String           @db.Uuid
  /// 1..200 characters, not blank.
  name        String
  /// The skolenhetskod: exactly eight digits, or null until entered. Unique
  /// per school where set (partial index SchoolUnits_schoolId_code_key).
  code        String?
  schoolTypes SchoolUnitType[] @default([])
  /// 0..10, both or neither; 0 = förskoleklass. In the nine-year numbering
  /// for good, like every school-wide span (20261126091000).
  gradeFrom   Int?
  gradeTo     Int?
  /// The source's Organisation id once an admin linked the unit; written only
  /// by an admin. Unique per school where set (SchoolUnits_schoolId_ss12000Id_key).
  ss12000Id   String?          @db.Uuid
  createdAt   DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime         @default(now()) @updatedAt @db.Timestamptz(6)

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([id, schoolId])
  @@index([schoolId])
  @@map("SchoolUnits")
}

model StudentGroup {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId       String           @db.Uuid
  academicYearId String           @db.Uuid
  name           String
  kind           StudentGroupKind @default(CLASS)
  gradeLevel     Int?
  /// Last year's group this one continues (7A -> 8A), written by the rollover
  /// at INSERT. A trigger (SQLSTATE LR409) holds it to the group's year's
  /// predecessor year (ROLLOVER_LINK_MISMATCH), refuses every later change but
  /// the foreign key clearing it — this column only, ON DELETE SET NULL
  /// ("predecessorId") — (ROLLOVER_LINK_IS_FIXED), and keeps a group linked
  /// either way in its year (ROLLOVER_GROUP_IS_LINKED). One successor per
  /// group. See 20261007150000.
  predecessorId  String?          @db.Uuid
  /// The group's id at the school's SS12000 source (20261014100000); written
  /// only by an admin's apply. Unique per school where set (partial index
  /// StudentGroups_schoolId_ss12000Id_key).
  ss12000Id      String?          @db.Uuid
  /// The CLASS this group is a half of (Halvklasser, 20261113090000): a
  /// TEACHING_GROUP made by "Dela klassen", in its class's year. Set at INSERT
  /// and never changed; a trigger (SQLSTATE HC409) holds a half to being a
  /// teaching group of a class of its own year, and a class with halves to
  /// its kind and year. Deleting the class deletes its halves.
  halfOfId       String?          @db.Uuid
  createdAt      DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime         @updatedAt @db.Timestamptz(6)

  school       School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicYear AcademicYear  @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  predecessor  StudentGroup? @relation("GroupSuccession", fields: [predecessorId, schoolId], references: [id, schoolId], onDelete: SetNull, onUpdate: NoAction)
  successor    StudentGroup? @relation("GroupSuccession")
  halfOf       StudentGroup?  @relation("ClassHalves", fields: [halfOfId, schoolId], references: [id, schoolId], onDelete: Cascade, onUpdate: NoAction)
  halves       StudentGroup[] @relation("ClassHalves")

  // Home-class members (User.studentGroupId points here).
  members                 User[]                   @relation("StudentGroupMembers")
  // Teaching-group members: students whose HOME class is another group but who
  // take this group's subject lessons (nivågrupper, språkval). A group used as
  // a plain class has none of these.
  teachingMembers         StudentGroupMember[]     @relation("TeachingGroupGroup")
  teachingRequirements    TeachingRequirement[]
  masterLessons           MasterLesson[]
  calendarLessons         CalendarLesson[]
  availabilityConstraints AvailabilityConstraint[] @relation("ConstraintGroup")
  extraMasterLessons      MasterLessonGroup[]      @relation("MasterLessonExtraGroup")
  extraCalendarLessons    CalendarLessonGroup[]    @relation("CalendarLessonExtraGroup")
  lunchSittings           LunchSitting[]
  calendarRasts           CalendarRast[]
  calendarLunches         CalendarLunch[]
  /// Mentorskap for this class (TeacherDuty.studentGroupId).
  teacherDuties           TeacherDuty[]
  /// Credits scoped to this group (TimplanCredit.studentGroupId).
  timplanCredits          TimplanCredit[]
  /// The pupils' segments in this class (StudentEnrollment.studentGroupId).
  enrollments             StudentEnrollment[]

  @@unique([schoolId, academicYearId, name])
  /// The target a tenant-scoped composite foreign key needs; see User.
  @@unique([id, schoolId])
  /// The target StudentEnrollment's class key needs: a class OF ITS OWN YEAR.
  @@unique([id, academicYearId, schoolId])
  /// One successor per group; also the index the predecessor key's SET NULL scans.
  @@unique([predecessorId, schoolId])
  @@index([halfOfId, schoolId])
  @@index([schoolId])
  @@index([academicYearId])
  @@map("StudentGroups")
}

// -----------------------------------------------------------------------------
// Curriculum / scheduling demand
// -----------------------------------------------------------------------------

model TeachingRequirement {
  id               String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId         String  @db.Uuid
  academicYearId   String  @db.Uuid
  subjectId        String  @db.Uuid
  studentGroupId   String  @db.Uuid
  teacherId        String? @db.Uuid
  /// Optional second teacher — both are scheduled together (co-teaching).
  coTeacherId      String? @db.Uuid
  /// The number of lessons a week — on a split row too.
  lessonsPerWeek   Int     @default(1)
  /// The length of every lesson on a uniform row; the LONGEST on a split one,
  /// so a reader asking whether a lesson fits a frame or a rast sees the
  /// length that binds.
  minutesPerLesson Int     @default(60)

  /// Lektionslängder: one entry per lesson of the week, longest first, when
  /// the lessons are NOT all one length — {80,40} is "1 × 80 + 1 × 40",
  /// {60,60,55} is "2 × 60 + 1 × 55". EMPTY on every uniform row, which is
  /// every row written before 20261008090000, and then lessonsPerWeek ×
  /// minutesPerLesson says it all, as before.
  ///
  /// Canonical by CHECK (TeachingRequirements_lesson_lengths_are_canonical):
  /// exactly lessonsPerWeek entries, the first is minutesPerLesson, sorted
  /// longest first, 15..240 on the five-minute grid, two or three different
  /// lengths. Weekly minutes and the lesson count of a row are read through
  /// src/common/lesson-lengths.ts, never as lessonsPerWeek × minutesPerLesson.
  lessonLengths    Int[]   @default([])

  /// Minutes the PUPILS are occupied on either side of the lesson: ombyte
  /// before idrotten, dusch and ombyte after it.
  ///
  /// OUTSIDE THE LESSON. A 60-minute lesson with 10 before and 20 after still
  /// teaches 60 — `minutesPerLesson` is untouched and the timplan still counts
  /// 60 — while the class is unavailable for 90. The numbers do not shorten the
  /// teaching, they say what surrounds it.
  ///
  /// SAID PER REQUIREMENT, which is to say per (class, subject). Not on the
  /// subject, because ombyte is a property of what THIS class does in this
  /// subject: 4.1 walks from the far corridor and 4.2 from the hall next door,
  /// and the same idrott needs different margins for the two. Not per stage
  /// either, for the same reason — the walk is the class's, not the årskurs's.
  ///
  /// ONLY THE PUPILS ARE BLOCKED. Not the teacher, who does not shower with the
  /// class and may teach the slot on either side. Not the room, which stands
  /// empty through both windows — the class is in the omklädningsrummet, not in
  /// the gymnastiksal.
  ///
  /// WHY THIS IS NOT THE CHANGEOVER CORRIDOR (FrameTimes.changeoverMinutes).
  /// That one is a FLOOR ON THE GAP between any two lessons of a stage, and the
  /// solver argues itself down to one end of it: padding both sides turns a
  /// ten-minute rule into a silent twenty, and padding the front makes 08:00 an
  /// illegal start for the first lesson of the day (scheduler_solver.py:103-105,
  /// padded_of). It declines to pad the room at all, because a room needs no
  /// time to become itself again (:3834-3838).
  ///
  /// Neither argument reaches these two columns. A pupil buffer is not one rule
  /// counted twice: ombyte before and dusch after are two different things the
  /// children actually do, each named on its own, so 10 + 20 is thirty minutes
  /// of real occupancy and not a doubled ten. Nor is it a gap the schema may
  /// quietly shrink — 08:00 idrott genuinely means the class is changing at
  /// 07:50, which is the school's answer and not an artefact of the encoding.
  /// The room is left alone here for precisely the reason the solver gives for
  /// its own room arm: nobody is in it.
  ///
  /// 0..60 on each, as CHECK constraints mirroring the DTO's bounds. Default 0,
  /// so nothing changes for any school until somebody writes a number, and the
  /// whole mechanism costs a school that never does exactly nothing.
  minutesBefore Int @default(0)
  minutesAfter  Int @default(0)

  /// How much of this row counts toward each teacher's load: Skola24's
  /// "Justera längd för lärare (%)". The row counts lessonsPerWeek ×
  /// minutesPerLesson × percent / 100 for teacherId (teacherLoadPercent) and
  /// for coTeacherId (coTeacherLoadPercent). 0..200 by CHECK, mirroring the
  /// DTO; default 100, so a row counts in full for both, as before. Load
  /// arithmetic only — the optimisation proxy never sends either column.
  /// See migration 20261007090000.
  teacherLoadPercent   Int @default(100)
  coTeacherLoadPercent Int @default(100)

  /// Ämnesfördelning for this row. False, the default, follows the subject's
  /// rule (Subject.maxLessonsPerDay, Subject.minDaysBetween) and leaves both
  /// columns below empty, which a CHECK holds. True makes the two columns this
  /// row's whole rule, null in either meaning no rule — so "no limit here,
  /// although the subject has one" needs no sentinel. Same bounds as the
  /// subject's. See migration 20261019090000.
  ownDistribution  Boolean @default(false)
  maxLessonsPerDay Int?
  minDaysBetween   Int?

  /// Parallella block: the block this row runs in, whose rows have their
  /// lessons placed at the same times. Null, the default, is a row in no
  /// block. The key is (blockId, academicYearId, schoolId), so a block is in
  /// its row's own year and school, and the members have the same lessons and
  /// weeks by trigger (SQLSTATE TB409, BLOCK_MEMBERS_DIFFER). Deleting the
  /// block clears this column only — ON DELETE SET NULL ("blockId"), which
  /// the SetNull below cannot say and the migration does. See 20261024090000.
  blockId          String? @db.Uuid

  /// Which weeks the requirement is read over, inherited by every lesson the
  /// optimizer generates for it. `lessonsPerWeek` counts weeks the requirement
  /// actually runs, so 2 lessons a week over a spring-only window is two a week
  /// that spring — not two averaged across the year.
  ///
  /// The engine has no concept of weeks (optimization-proxy.service.ts), so it
  /// still packs a windowed requirement as if it ran all year: the window is
  /// stamped on the resulting lessons afterwards. That over-provisions — two
  /// half-year subjects get separate slots where they could have shared one —
  /// which costs packing room and not correctness, and is visible on the
  /// timetable rather than hidden.
  recurrence LessonRecurrence @default(ALL_WEEKS)
  /// First date the requirement is read; null means "from the start of the
  /// year". With endDate this expresses a subject read for one term only.
  startDate  DateTime?        @db.Date
  /// Last date the requirement is read; null means "until the year ends".
  endDate    DateTime?        @db.Date
  createdAt  DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime         @updatedAt @db.Timestamptz(6)

  school       School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  /// Every reference carries `schoolId`, because create() copies all five ids
  /// out of the request and checks none of them, and a foreign-key check runs
  /// as the referenced table's owner with row security off — so an id the
  /// caller cannot even SELECT still validates. The composite keys are what
  /// make a requirement's school the school of its year, subject, group and
  /// teachers.
  academicYear AcademicYear @relation(fields: [academicYearId, schoolId], references: [id, schoolId], onDelete: Cascade)
  subject      Subject      @relation(fields: [subjectId, schoolId], references: [id, schoolId], onDelete: Cascade)
  studentGroup StudentGroup @relation(fields: [studentGroupId, schoolId], references: [id, schoolId], onDelete: Cascade)
  teacher      User?        @relation("RequirementTeacher", fields: [teacherId, schoolId], references: [id, schoolId], onDelete: SetNull)
  coTeacher    User?        @relation("RequirementCoTeacher", fields: [coTeacherId, schoolId], references: [id, schoolId], onDelete: SetNull)
  block        TeachingBlock? @relation(fields: [blockId, academicYearId, schoolId], references: [id, academicYearId, schoolId], onDelete: SetNull, onUpdate: NoAction)
  /// Delade lektioner: the lessons other teachers take. The post's own
  /// teacherId is its huvudlärare and takes every lesson no share takes, so a
  /// post with none is the post it always was. See TeachingRequirementShare.
  shares       TeachingRequirementShare[]

  /// `schoolId` leads the key so the slot a school occupies is its own. Without
  /// it one school's forged row took the (year, group, subject) slot of
  /// another, whose admin then got a 409 creating their real requirement while
  /// seeing no row anywhere that explained it.
  @@unique([schoolId, academicYearId, studentGroupId, subjectId])
  /// The target the shares' composite key needs: a share OF ITS OWN SCHOOL.
  @@unique([id, schoolId])
  @@index([schoolId])
  @@index([teacherId])
  @@index([blockId])
  @@map("TeachingRequirements")
}

/// Delade lektioner: `lessons` of a post's lessons of `minutes` each, taught
/// by `teacherId` rather than by the post's huvudlärare — "Bo: 1 × 60" of
/// 9A's three matematik. Each lesson has one teacher; the huvudlärare
/// (TeachingRequirement.teacherId) takes every lesson no share takes.
///
/// The shares fit the post by trigger (SQLSTATE TS409,
/// REQUIREMENT_SHARES_DO_NOT_FIT): every length is one of the post's, no more
/// of a length than the post has, at most lessonsPerWeek − 1 in all (the
/// huvudlärare keeps a lesson), and no share's teacher is the post's own
/// teacher or co-teacher. A null teacher is a share whose teacher was deleted:
/// that many unstaffed lessons, never silently the huvudlärare's (ON DELETE
/// SET NULL ("teacherId"), which the SetNull below cannot say and the
/// migration does). Read and written through the gateway only. See migration
/// 20261205090000.
model TeachingRequirementShare {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId      String   @db.Uuid
  requirementId String   @db.Uuid
  teacherId     String?  @db.Uuid
  /// 1..39 by CHECK.
  lessons       Int
  /// The length of each of the share's lessons, one of the post's; 15..240 on
  /// the five-minute grid by CHECK.
  minutes       Int
  createdAt     DateTime @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @db.Timestamptz(6)

  school      School              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  requirement TeachingRequirement @relation(fields: [requirementId, schoolId], references: [id, schoolId], onDelete: Cascade)
  teacher     User?               @relation("RequirementShareTeacher", fields: [teacherId, schoolId], references: [id, schoolId], onDelete: SetNull)

  /// NULLS DISTINCT on purpose: two deleted teachers leave two teacherless shares.
  @@unique([requirementId, teacherId, minutes])
  @@index([teacherId])
  @@index([schoolId])
  @@map("TeachingRequirementShares")
}

/// Parallella block: rows of one läsår whose lessons are placed at the same
/// times — "Språkval åk 7" holds Spanska, Tyska and Franska for the
/// teaching groups cut across 7A, 7B and 7C, and takes one slot of 7A's week
/// per lesson rather than one per language. A row joins through
/// TeachingRequirement.blockId. See migration 20261024090000.
model TeachingBlock {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId       String   @db.Uuid
  academicYearId String   @db.Uuid
  /// Trimmed, 1..80 characters by CHECK (TeachingBlocks_name_is_sane).
  name           String
  /// The block whose times this one takes: a term split's spring block names
  /// its autumn block, and the generator writes each spring post at the times
  /// of the autumn post in its subject (same-times.ts). Null, the default, is
  /// a block placed on its own. Of the block's own year and school by the
  /// composite key; never itself, and one block per named block (CHECK and a
  /// unique index). Deleting the named block clears this column only — ON
  /// DELETE SET NULL ("sameTimesAsBlockId"), which the SetNull below cannot
  /// say and the migration does. See 20261128090000.
  sameTimesAsBlockId String? @unique @db.Uuid
  createdAt      DateTime @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @db.Timestamptz(6)

  school       School                @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicYear AcademicYear          @relation(fields: [academicYearId, schoolId], references: [id, schoolId], onDelete: Cascade)
  requirements TeachingRequirement[]
  sameTimesAs  TeachingBlock?        @relation("SameTimes", fields: [sameTimesAsBlockId, academicYearId, schoolId], references: [id, academicYearId, schoolId], onDelete: SetNull, onUpdate: NoAction)
  /// The block on this one's times, if any (the unique index makes it one).
  sameTimes    TeachingBlock[]       @relation("SameTimes")

  @@unique([schoolId, academicYearId, name])
  /// The target TeachingRequirement's block key needs: a block OF ITS OWN YEAR.
  @@unique([id, academicYearId, schoolId])
  @@index([academicYearId])
  @@map("TeachingBlocks")
}

// -----------------------------------------------------------------------------
// Master timetable (recurring weekly template the AI engine produces)
// -----------------------------------------------------------------------------

/// Which weeks a lesson actually runs.
///
/// Anchored to ISO week numbers rather than counted from a start date, because
/// that is what a Swedish school says out loud — "slöjd udda veckor" — and it
/// means the same thing whenever anyone looks. A count from the start date
/// would leave nobody able to tell, from a week number alone, whether a given
/// week is an "on" week.
enum LessonRecurrence {
  /// Every week the lesson's period covers.
  ALL_WEEKS
  /// Odd ISO week numbers only.
  ODD_WEEKS
  /// Even ISO week numbers only.
  EVEN_WEEKS
}

model MasterLesson {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId       String   @db.Uuid
  academicYearId String   @db.Uuid
  subjectId      String   @db.Uuid
  studentGroupId String   @db.Uuid
  teacherId      String?  @db.Uuid
  /// Optional second teacher (co-teaching); published as an ASSISTANT assignment.
  coTeacherId    String?  @db.Uuid
  roomId         String?  @db.Uuid
  // ISO weekday: 1 = Monday ... 7 = Sunday.
  dayOfWeek      Int
  startTime      DateTime @db.Time(0)
  endTime        DateTime @db.Time(0)

  recurrence LessonRecurrence @default(ALL_WEEKS)
  /// First date the lesson runs; null means "from the start of the year".
  /// With endDate this expresses a subject read for half a term.
  startDate  DateTime?        @db.Date
  /// Last date the lesson runs; null means "until the year ends".
  endDate    DateTime?        @db.Date

  // Locked lessons survive regeneration untouched: the optimizer treats them
  // as fixed placements and schedules the remaining demand around them.
  isLocked    Boolean  @default(false)
  /// Set aside on the grid's tray. A parked lesson OCCUPIES NOTHING: it is
  /// excluded from every clash check, from publish, from the solver's fixed
  /// placements and from the SS12000 feed. Its day and time survive only as a
  /// memory of where it was, so it can be put back. See the migration.
  isParked    Boolean  @default(false)
  /// True only for lessons the optimizer itself produced, and the one thing
  /// regeneration is allowed to replace.
  ///
  /// Ownership used to be inferred from the lesson looking untouched — default
  /// recurrence, no dates. That held only while nothing but a human ever set
  /// those. Now a generated lesson inherits its requirement's window, so an
  /// inferred rule would read the optimizer's own output as handmade: it would
  /// be preserved, the requirement would still count as unmet, and the next
  /// regeneration would stack another copy on top of it every time.
  ///
  /// Defaults to false so a creation path that forgets to say is treated as
  /// handmade and survives. Only the optimizer sets it true.
  isGenerated Boolean  @default(false)
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @db.Timestamptz(6)

  school       School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  /// Tenant-scoped for the same reason as TeachingRequirement's: create() takes
  /// subjectId, studentGroupId, teacherId, coTeacherId and roomId from the
  /// request and only ever validates the academic year. `academicYearId` is on
  /// the list too — the service does derive `schoolId` from that very row, but
  /// that is a property of three TypeScript call sites, and a direct PostgREST
  /// write meets no TypeScript at all.
  academicYear AcademicYear @relation(fields: [academicYearId, schoolId], references: [id, schoolId], onDelete: Cascade)
  subject      Subject      @relation(fields: [subjectId, schoolId], references: [id, schoolId], onDelete: Cascade)
  studentGroup StudentGroup @relation(fields: [studentGroupId, schoolId], references: [id, schoolId], onDelete: Cascade)
  teacher      User?        @relation("MasterLessonTeacher", fields: [teacherId, schoolId], references: [id, schoolId], onDelete: SetNull)
  coTeacher    User?        @relation("MasterLessonCoTeacher", fields: [coTeacherId, schoolId], references: [id, schoolId], onDelete: SetNull)
  room         Room?        @relation(fields: [roomId, schoolId], references: [id, schoolId], onDelete: SetNull)

  calendarLessons CalendarLesson[]
  /// Additional classes attending this lesson (beyond the primary group).
  extraGroups     MasterLessonGroup[]
  /// Individual students attending (electives across classes).
  participants    MasterLessonStudent[]

  @@index([schoolId, dayOfWeek, startTime])
  @@index([studentGroupId, dayOfWeek])
  @@index([teacherId, dayOfWeek])
  @@index([roomId, dayOfWeek])
  @@map("MasterLessons")
}

// -----------------------------------------------------------------------------
// Concrete calendar (materialized instances for a specific date)
// -----------------------------------------------------------------------------

model CalendarLesson {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId       String       @db.Uuid
  masterLessonId String?      @db.Uuid
  subjectId      String       @db.Uuid
  studentGroupId String       @db.Uuid
  roomId         String?      @db.Uuid
  date           DateTime     @db.Date
  startsAt       DateTime     @db.Timestamptz(6)
  endsAt         DateTime     @db.Timestamptz(6)
  status         LessonStatus @default(SCHEDULED)
  note           String?
  /// Read only under status CANCELLED; reinstate() writes null. The free text
  /// stays in `note`. No CHECK ties it to the status (see the migration).
  cancelCause    LessonCancelCause?
  createdAt      DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @db.Timestamptz(6)

  school       School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  masterLesson MasterLesson? @relation(fields: [masterLessonId], references: [id], onDelete: SetNull)
  subject      Subject       @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  studentGroup StudentGroup  @relation(fields: [studentGroupId], references: [id], onDelete: Cascade)
  room         Room?         @relation(fields: [roomId], references: [id], onDelete: SetNull)

  teachers          CalendarLessonTeacher[]
  attendanceRecords AttendanceRecord[]
  extraGroups       CalendarLessonGroup[]
  participants      CalendarLessonStudent[]
  /// Set while the lesson's template was deleted in a DRAFT school and no publish has settled it.
  pendingRemovals   PublicationPendingRemoval[]
  batchLessons      CancellationBatchLesson[]
  /// The lesson's log and its note to the substitute (Lektionslogg,
  /// 20261203090000): at most one row each (UNIQUE "calendarLessonId" on the
  /// other side). Lists for the composite key's sake, as User.workRules.
  lessonLogs        LessonLog[]
  substituteNotes   LessonSubstituteNote[]

  // Not visible here, and load-bearing: an EXCLUDE constraint on
  // (roomId, tstzrange(startsAt, endsAt)) refuses a second SCHEDULED lesson in
  // a room already taken, and a BEFORE trigger takes an advisory lock on the
  // room so the cross-table checks against RoomBookings hold too. Prisma
  // cannot express either — see migration
  // 20260822131500_a_room_holds_one_thing_at_a_time.

  // Indexes optimized for fast date/time range scans.
  @@index([schoolId, date])
  @@index([schoolId, startsAt, endsAt])
  @@index([studentGroupId, date])
  @@index([studentGroupId, startsAt])
  @@index([roomId, startsAt])
  @@index([masterLessonId])
  @@index([date])
  @@index([startsAt])
  /// The target of composite keys from Publicering's tables (20261011100000).
  @@unique([id, schoolId])
  @@map("CalendarLessons")
}

// -----------------------------------------------------------------------------
// Lesson participants: a lesson can span multiple classes and/or individual
// students from different classes (joint activities, electives, support).
// -----------------------------------------------------------------------------

model MasterLessonGroup {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId       String   @db.Uuid
  masterLessonId String   @db.Uuid
  studentGroupId String   @db.Uuid
  createdAt      DateTime @default(now()) @db.Timestamptz(6)

  masterLesson MasterLesson @relation(fields: [masterLessonId], references: [id], onDelete: Cascade)
  /// The extra classes come straight from the request, so this reference is
  /// tenant-scoped like the lesson's own. `masterLessonId` is deliberately
  /// left plain: the row's school is already pinned to the group's by this
  /// key, and nothing reads a lesson through this link without asking the
  /// lesson's own school first.
  studentGroup StudentGroup @relation("MasterLessonExtraGroup", fields: [studentGroupId, schoolId], references: [id, schoolId], onDelete: Cascade)

  @@unique([masterLessonId, studentGroupId])
  @@index([schoolId])
  @@index([studentGroupId])
  @@map("MasterLessonGroups")
}

model MasterLessonStudent {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId       String   @db.Uuid
  masterLessonId String   @db.Uuid
  studentId      String   @db.Uuid
  createdAt      DateTime @default(now()) @db.Timestamptz(6)

  masterLesson MasterLesson @relation(fields: [masterLessonId], references: [id], onDelete: Cascade)
  /// The one reference here that a pupil's own read policy trusts:
  /// `master_lesson_students_self_select` asks only "is this row about me?".
  /// Pinning the school to the pupil is what makes a row that answers yes
  /// necessarily a row from the pupil's own school.
  student      User         @relation("MasterLessonParticipant", fields: [studentId, schoolId], references: [id, schoolId], onDelete: Cascade)

  @@unique([masterLessonId, studentId])
  @@index([schoolId])
  @@index([studentId])
  @@map("MasterLessonStudents")
}

model StudentGroupMember {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId       String   @db.Uuid
  studentGroupId String   @db.Uuid
  studentId      String   @db.Uuid
  /// The class of the half this membership is in, or null: copied from the
  /// group's halfOfId by a trigger whatever the writer sends, so the partial
  /// unique index StudentGroupMembers_one_half_per_class holds a pupil to one
  /// half per class (20261113090000).
  halfOfId       String?  @db.Uuid
  createdAt      DateTime @default(now()) @db.Timestamptz(6)

  studentGroup StudentGroup @relation("TeachingGroupGroup", fields: [studentGroupId], references: [id], onDelete: Cascade)
  student      User         @relation("TeachingGroupStudent", fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentGroupId, studentId])
  @@index([schoolId])
  @@index([studentId])
  @@map("StudentGroupMembers")
}

model CalendarLessonGroup {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId         String   @db.Uuid
  calendarLessonId String   @db.Uuid
  studentGroupId   String   @db.Uuid
  createdAt        DateTime @default(now()) @db.Timestamptz(6)

  calendarLesson CalendarLesson @relation(fields: [calendarLessonId], references: [id], onDelete: Cascade)
  studentGroup   StudentGroup   @relation("CalendarLessonExtraGroup", fields: [studentGroupId], references: [id], onDelete: Cascade)

  @@unique([calendarLessonId, studentGroupId])
  @@index([schoolId])
  @@index([studentGroupId])
  @@map("CalendarLessonGroups")
}

model CalendarLessonStudent {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId         String   @db.Uuid
  calendarLessonId String   @db.Uuid
  studentId        String   @db.Uuid
  createdAt        DateTime @default(now()) @db.Timestamptz(6)

  calendarLesson CalendarLesson @relation(fields: [calendarLessonId], references: [id], onDelete: Cascade)
  student        User           @relation("CalendarLessonParticipant", fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([calendarLessonId, studentId])
  @@index([schoolId])
  @@index([studentId])
  @@map("CalendarLessonStudents")
}

// -----------------------------------------------------------------------------
// Teacher <-> CalendarLesson assignment (supports co-teaching / substitutes)
// -----------------------------------------------------------------------------

model CalendarLessonTeacher {
  id               String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId         String                @db.Uuid
  calendarLessonId String                @db.Uuid
  teacherId        String                @db.Uuid
  role             TeacherAssignmentRole @default(LEAD)
  createdAt        DateTime              @default(now()) @db.Timestamptz(6)

  school         School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  calendarLesson CalendarLesson @relation(fields: [calendarLessonId], references: [id], onDelete: Cascade)
  teacher        User           @relation("AssignedTeacher", fields: [teacherId], references: [id], onDelete: Cascade)

  @@unique([calendarLessonId, teacherId])
  @@index([schoolId])
  @@index([teacherId])
  @@map("CalendarLessonTeachers")
}

// -----------------------------------------------------------------------------
// Lektionslogg (20261203090000): what a lesson is about and what is to be
// done before the next one, which families see; and a note to whoever
// covers it, which only staff see. Two tables, so that row security and not
// only the gateway keeps the note from families. Composite keys, CHECKs, the
// write arms and app.lesson_teacher_role live in the migration.
// -----------------------------------------------------------------------------

/// A lesson's topic and homework, written by its teacher if they want to and
/// read by the pupils on it and their guardians. One per calendar lesson at
/// most; deleted, never kept empty (CHECK: topic or homework).
model LessonLog {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId         String   @db.Uuid
  calendarLessonId String   @unique @db.Uuid
  /// One line, trimmed, 1..200 characters (DB CHECK).
  topic            String?
  /// Trimmed, 1..1000 characters, may run over lines (DB CHECK).
  homework         String?
  /// Who wrote it last: a trigger stamps it from the claims (app.lesson_text_written_by).
  writtenById      String?  @db.Uuid
  createdAt        DateTime @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @db.Timestamptz(6)

  school         School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  calendarLesson CalendarLesson @relation(fields: [calendarLessonId, schoolId], references: [id, schoolId], onDelete: Cascade, onUpdate: NoAction)
  writtenBy      User?          @relation("LessonLogWriter", fields: [writtenById, schoolId], references: [id, schoolId], onDelete: SetNull, onUpdate: NoAction)

  @@index([schoolId])
  @@index([writtenById])
  @@map("LessonLogs")
}

/// A note to the substitute from the lesson's own teacher: read by the
/// lesson's teachers, its substitute among them, and nobody else: never an
/// administrator (who learns only that one exists,
/// app.substitute_noted_lessons), a pupil or a guardian. One per calendar
/// lesson at most.
model LessonSubstituteNote {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId         String   @db.Uuid
  calendarLessonId String   @unique @db.Uuid
  /// Trimmed, 1..2000 characters (DB CHECK).
  body             String
  /// Who wrote it last: a trigger stamps it from the claims (app.lesson_text_written_by).
  writtenById      String?  @db.Uuid
  createdAt        DateTime @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @db.Timestamptz(6)

  school         School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  calendarLesson CalendarLesson @relation(fields: [calendarLessonId, schoolId], references: [id, schoolId], onDelete: Cascade, onUpdate: NoAction)
  writtenBy      User?          @relation("SubstituteNoteWriter", fields: [writtenById, schoolId], references: [id, schoolId], onDelete: SetNull, onUpdate: NoAction)

  @@index([schoolId])
  @@index([writtenById])
  @@map("LessonSubstituteNotes")
}

// -----------------------------------------------------------------------------
// Attendance
// -----------------------------------------------------------------------------

model AttendanceRecord {
  id               String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId         String           @db.Uuid
  calendarLessonId String           @db.Uuid
  studentId        String           @db.Uuid
  status           AttendanceStatus @default(UNKNOWN)
  recordedById     String?          @db.Uuid
  recordedAt       DateTime?        @db.Timestamptz(6)
  note             String?
  createdAt        DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime         @updatedAt @db.Timestamptz(6)

  school         School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  calendarLesson CalendarLesson @relation(fields: [calendarLessonId], references: [id], onDelete: Cascade)
  student        User           @relation("AttendanceStudent", fields: [studentId], references: [id], onDelete: Cascade)
  recordedBy     User?          @relation("AttendanceRecorder", fields: [recordedById], references: [id], onDelete: SetNull)

  @@unique([calendarLessonId, studentId])
  @@index([schoolId, recordedAt])
  @@index([studentId, recordedAt])
  @@index([calendarLessonId])
  /// SS12000's /attendances keyset, page by page within one school (20261114090000).
  @@index([schoolId, id])
  /// SS12000's incremental /attendances: the records created after the cursor (20261114090150).
  @@index([schoolId, createdAt])
  @@map("AttendanceRecords")
}

// -----------------------------------------------------------------------------
// Schedule change audit trail (manual timetable edits + regenerations)
// -----------------------------------------------------------------------------

model ScheduleChangeLog {
  id             String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId       String               @db.Uuid
  academicYearId String               @db.Uuid
  // Scalar reference on purpose (no FK): log rows must outlive deleted lessons.
  masterLessonId String?              @db.Uuid
  actorId        String?              @db.Uuid
  action         ScheduleChangeAction
  before         Json?
  after          Json?
  createdAt      DateTime             @default(now()) @db.Timestamptz(6)

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId, academicYearId, createdAt])
  @@index([masterLessonId])
  /// Gallring's predicate (20261021110000).
  @@index([schoolId, createdAt])
  @@map("ScheduleChangeLogs")
}

// -----------------------------------------------------------------------------
// Named snapshots of the master timetable (save / compare / restore)
// -----------------------------------------------------------------------------

model ScheduleVersion {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId       String   @db.Uuid
  academicYearId String   @db.Uuid
  name           String
  createdById    String?  @db.Uuid
  /// Full master-lesson snapshot (array of lesson records).
  lessons        Json
  lessonCount    Int
  createdAt      DateTime @default(now()) @db.Timestamptz(6)

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId, academicYearId, createdAt])
  @@map("ScheduleVersions")
}

// -----------------------------------------------------------------------------
// Optimization run history (durable job store, replaces the in-memory queue)
// -----------------------------------------------------------------------------

model OptimizationJob {
  id                    String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId              String                @db.Uuid
  academicYearId        String                @db.Uuid
  actorId               String?               @db.Uuid
  status                OptimizationJobStatus @default(PENDING)
  solverStatus          String?
  lessonsGenerated      Int                   @default(0)
  conflictSummary       String?
  /// The summary's message code and values, so the screen can say it in the
  /// reader's language; the string above is the engine's own English, and it
  /// is what a row written before the codes — or a sentence the web has not
  /// translated yet — still shows. See optimization-engine/app/messages.py.
  conflictSummaryCode   String?
  conflictSummaryParams Json?
  conflicts             Json?
  error                 String?
  /// The same for a refused payload: the engine's 400 names its reason.
  errorCode             String?
  errorParams           Json?
  /// Objective weights used for this run (null = server defaults).
  weights               Json?
  /// Effective schedule rules used for this run — the lunch window, the dining
  /// hall's seat count and the daily lesson cap, after the stored settings and
  /// any per-run override were merged. Snapshotted for the same reason
  /// `weights` is, and it became necessary the moment lunch stopped being a
  /// per-request blob: the settings row is edited in place, so without this a
  /// timetable generated in September cannot be explained in November.
  rules                 Json?
  /// What a finished run could not keep of the soft wishes (Lärarens dag:
  /// a teacher's free-day wish), in a conflict's shape — code, params, the
  /// work rule as the resource — so the page says it as it says a refusal.
  /// Null when every wish was kept, and on every run before 20261123090100.
  notes                 Json?
  createdAt             DateTime              @default(now()) @db.Timestamptz(6)
  finishedAt            DateTime?             @db.Timestamptz(6)

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId, academicYearId, createdAt])
  @@map("OptimizationJobs")
}

// -----------------------------------------------------------------------------
// Schemaförslag: private candidates of the year's grundschema (20261125090000)
// -----------------------------------------------------------------------------

/// One request for candidates. Every administrator reads it; SCHEMALAGGNING
/// writes it. One active (PENDING, RUNNING, CANCELLING) run per year, by a
/// partial unique index; app.schedule_candidates_sweep() marks a run past its
/// lease FAILED, and deletes runs older than seven days and removed runs
/// (discardedAt) whose engine call could have ended.
model ScheduleCandidateRun {
  id             String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId       String                     @db.Uuid
  academicYearId String                     @db.Uuid
  /// Who asked (no key, like ScheduleVersion.createdById; the row lives a week at most).
  createdById    String?                    @db.Uuid
  status         ScheduleCandidateRunStatus @default(PENDING)
  /// 2..4 for a new run, 1..4 for a refresh (DB CHECK 1..4).
  requested      Int
  /// Candidates finished so far, 0..requested (DB CHECK).
  progress       Int                        @default(0)
  /// sha256 (hex) of what the candidates were solved from, by content; an apply recomputes it and refuses a difference.
  basis          String?
  /// One sha256 per part of the basis (requirements, preserved, draft, rooms, rules, rosters), so a refusal can say what changed.
  basisParts     Json?
  /// Objective weights asked for (null = server defaults); each candidate's own are on the candidate.
  weights        Json?
  /// Unplaced demand, the same for every applicable candidate in practice: {lines, minutes, draftLines, draftMinutes}.
  unplaced       Json?
  /// The free-day wishes the draft the run was solved from breaks, as a candidate's notes say its own: the comparison's
  /// first column. Written when the run succeeds; null otherwise and on every run before 20261127090000 (DB CHECK: a list).
  draftNotes     Json?
  /// The run this one refreshed ("Uppdatera förslagen"); no key, the old run is deleted when this one succeeds.
  refreshOfId    String?                    @db.Uuid
  /// The candidate applied from this run, and when (both or neither, DB CHECK).
  appliedCandidateId String?                @db.Uuid
  appliedAt      DateTime?                  @db.Timestamptz(6)
  error          String?
  errorCode      String?
  errorParams    Json?
  /// Bumped by the run's task before every candidate; past heartbeatAt + leaseSeconds the sweep abandons the run.
  heartbeatAt    DateTime                   @default(now()) @db.Timestamptz(6)
  /// 60..3600 (DB CHECK): twice the longest engine call the run makes.
  leaseSeconds   Int                        @default(600)
  /// The latest an engine call the run has out can still be solving; cleared when the call returns or never reached the
  /// engine. A run that ended while a call may still be solving — the API restarting, or the call timing out, cancelled
  /// or not — keeps it and is counted by app.schedule_candidate_runs_active() until then.
  engineBusyUntil DateTime?                 @db.Timestamptz(6)
  /// Set when a discard or a newer batch removed a finished run whose call could still be solving: its candidates are
  /// gone, no page shows it, and the sweep deletes it once engineBusyUntil has passed. Finished runs only (DB CHECK).
  discardedAt    DateTime?                  @db.Timestamptz(6)
  createdAt      DateTime                   @default(now()) @db.Timestamptz(6)
  startedAt      DateTime?                  @db.Timestamptz(6)
  finishedAt     DateTime?                  @db.Timestamptz(6)

  school       School              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicYear AcademicYear        @relation(fields: [academicYearId, schoolId], references: [id, schoolId], onDelete: Cascade)
  candidates   ScheduleCandidate[]

  @@unique([id, schoolId])
  @@index([schoolId, academicYearId, createdAt])
  @@index([createdAt])
  @@map("ScheduleCandidateRuns")
}

/// One candidate of a run, written once (no UPDATE grant). lessons is a list of
/// {requirementId, roomId, dayOfWeek, startTime, endTime} in real ids; subject,
/// group, teachers and dates are the requirement's, resolved when read.
model ScheduleCandidate {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  runId        String   @db.Uuid
  schoolId     String   @db.Uuid
  /// 1..4; 1 is KEEP (Generera's own request).
  ordinal      Int
  /// The emphasis: KEEP, TEACHER_GAPS, SPREAD, FREE (an open code, DB CHECK ^[A-Z][A-Z0-9_]{0,31}$).
  variant      String
  /// The objective weights this candidate was solved with.
  weights      Json?
  /// The solver's random seed (never shown: a run is not reproducible while the solver uses several workers).
  seed         Int?
  /// OPTIMAL | FEASIBLE | INFEASIBLE | TIMEOUT | REJECTED | FAILED (DB CHECK).
  solverStatus String
  lessons      Json     @default("[]")
  lunches      Json?
  metrics      Json?
  conflicts    Json?
  /// The free-day wishes the candidate's timetable breaks, beside the lessons every candidate keeps, in the shape of
  /// OptimizationJob.notes (the teacher's Users id server-only, named when read). Null on a candidate with no timetable
  /// and on every candidate before 20261127090000; [] when every wish is kept (DB CHECK: a list).
  notes        Json?
  /// The engine's summary of a candidate that found no timetable (e.g. PROBE_NOTHING_HELPED), and its values,
  /// scalars only, as OptimizationJob keeps conflictSummaryCode/Params: what the page says stopped it.
  errorCode    String?
  errorParams  Json?
  createdAt    DateTime @default(now()) @db.Timestamptz(6)

  run ScheduleCandidateRun @relation(fields: [runId, schoolId], references: [id, schoolId], onDelete: Cascade)

  @@unique([runId, ordinal])
  @@map("ScheduleCandidates")
}

// -----------------------------------------------------------------------------
// Guardians, absence reporting and leave requests (Frånvaro parity)
// -----------------------------------------------------------------------------

model GuardianStudent {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId   String   @db.Uuid
  guardianId String   @db.Uuid
  studentId  String   @db.Uuid
  /// Who made the link: a person (MANUAL) or an applied SS12000 sync.
  origin     GuardianLinkOrigin @default(MANUAL)
  createdAt  DateTime @default(now()) @db.Timestamptz(6)

  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  /// Composite keys, both of them, and that is the tenancy boundary rather than
  /// a policy: a link may only name users of its own school, and the database
  /// says so for every writer including a future migration. A plain reference to
  /// Users(id) let a school admin file another school's pupil as their own
  /// child, which unlocked that child's profile, health notes and leave reasons
  /// through six policies that trusted the link without checking its school.
  guardian User   @relation("GuardianSide", fields: [guardianId, schoolId], references: [id, schoolId], onDelete: Cascade)
  student  User   @relation("StudentSide", fields: [studentId, schoolId], references: [id, schoolId], onDelete: Cascade)

  @@unique([guardianId, studentId])
  @@index([schoolId])
  @@index([studentId])
  @@map("GuardianStudents")
}

/// A guardian- (or adult-student-) reported absence for a date; startTime/
/// endTime null = full day. Pre-fills the teacher's attendance view.
model AbsenceReport {
  id           String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId     String            @db.Uuid
  studentId    String            @db.Uuid
  reportedById String            @db.Uuid
  date         DateTime          @db.Date
  startTime    DateTime?         @db.Time(0)
  endTime      DateTime?         @db.Time(0)
  type         AbsenceReportType @default(SICK)
  note         String?
  /// A day of a granted leave, written by the leave decision (LeaveService).
  /// A trigger lets only a SCHOOL_ADMIN or a TEACHER set it (20261114090000),
  /// so a guardian's own note can never make a report one. SS12000 emits it as
  /// "Beviljad ledighet", every other report as "Anmäld frånvaro".
  grantedLeave Boolean           @default(false)
  createdAt    DateTime          @default(now()) @db.Timestamptz(6)

  school     School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student    User   @relation("AbsenceStudent", fields: [studentId], references: [id], onDelete: Cascade)
  reportedBy User   @relation("AbsenceReporter", fields: [reportedById], references: [id], onDelete: Cascade)

  @@index([schoolId, date])
  @@index([studentId, date])
  @@map("AbsenceReports")
}

model LeaveRequest {
  id            String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId      String             @db.Uuid
  studentId     String             @db.Uuid
  requestedById String             @db.Uuid
  startDate     DateTime           @db.Date
  endDate       DateTime           @db.Date
  reason        String
  status        LeaveRequestStatus @default(PENDING)
  decidedById   String?            @db.Uuid
  decidedAt     DateTime?          @db.Timestamptz(6)
  decisionNote  String?
  /// MENTOR or ADMIN, set with the decision; NULL while PENDING, and for the
  /// decisions before 20261023091000 whose decider was no SCHOOL_ADMIN.
  decidedAs     LeaveDeciderRole?
  /// A mentor passed the request on to rektor: when, and who. The admin
  /// decides it then. CHECKs in 20261023091000: a referrer has a time, and a
  /// referred request is never decided as MENTOR.
  referredAt    DateTime?          @db.Timestamptz(6)
  referredById  String?            @db.Uuid
  createdAt     DateTime           @default(now()) @db.Timestamptz(6)

  school      School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student     User   @relation("LeaveStudent", fields: [studentId], references: [id], onDelete: Cascade)
  requestedBy User   @relation("LeaveRequester", fields: [requestedById], references: [id], onDelete: Cascade)
  decidedBy   User?  @relation("LeaveDecider", fields: [decidedById], references: [id], onDelete: SetNull)
  referredBy  User?  @relation("LeaveReferrer", fields: [referredById], references: [id], onDelete: SetNull)

  @@index([schoolId, status, createdAt])
  @@index([studentId, startDate])
  /// Gallring's predicate (20261021110000).
  @@index([schoolId, endDate])
  @@map("LeaveRequests")
}

// -----------------------------------------------------------------------------
// Self-service room bookings (Skola24 Lokal parity). Teachers reserve free
// rooms themselves; these bookings coexist with lessons in conflict checking.
// Bookings on "special" rooms (requiresApproval) start PENDING until an admin
// decides; ordinary rooms auto-approve.
// -----------------------------------------------------------------------------

model RoomBooking {
  id           String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId     String            @db.Uuid
  roomId       String            @db.Uuid
  bookedById   String            @db.Uuid
  title        String
  startsAt     DateTime          @db.Timestamptz(6)
  endsAt       DateTime          @db.Timestamptz(6)
  status       RoomBookingStatus @default(APPROVED)
  decidedById  String?           @db.Uuid
  decidedAt    DateTime?         @db.Timestamptz(6)
  decisionNote String?
  createdAt    DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime          @updatedAt @db.Timestamptz(6)

  school    School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  room      Room   @relation(fields: [roomId], references: [id], onDelete: Cascade)
  bookedBy  User   @relation("RoomBookingBooker", fields: [bookedById], references: [id], onDelete: Cascade)
  decidedBy User?  @relation("RoomBookingDecider", fields: [decidedById], references: [id], onDelete: SetNull)

  // Not visible here, and load-bearing: an EXCLUDE constraint on
  // (roomId, tstzrange(startsAt, endsAt)), limited to PENDING and APPROVED
  // rows, is what stops two people holding one room at one hour. Prisma cannot
  // express it — see migration 20260822131500_a_room_holds_one_thing_at_a_time.
  @@index([schoolId, startsAt])
  @@index([roomId, startsAt])
  @@index([bookedById, startsAt])
  @@index([schoolId, status, createdAt])
  @@map("RoomBookings")
}

// -----------------------------------------------------------------------------
// Integration API keys (SS12000-style external access; hashed at rest)
// -----------------------------------------------------------------------------

model IntegrationApiKey {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId    String    @db.Uuid
  name        String
  /// SHA-256 hex of the key — the plaintext is shown exactly once on create.
  keyHash     String    @unique
  createdById String?   @db.Uuid
  lastUsedAt  DateTime? @db.Timestamptz(6)
  revokedAt   DateTime? @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)
  /// What the key may reach (20261014120000): ss12000.v1, ss12000.v1.import
  /// and the v2.0 provider's <resource>.read and subscriptions.write. The
  /// default is the backfill: every key that existed keeps exactly today's
  /// reach. A CHECK holds it to the known scopes (src/integration/
  /// ss12000-v2/scopes.ts).
  scopes      String[]  @default(["ss12000.v1", "ss12000.v1.import"])

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  /// The target of the composite keys a webhook secret and a subscription use.
  @@unique([id, schoolId])
  @@index([schoolId])
  @@map("IntegrationApiKeys")
}

/// A key's webhook signing secret, AES-256-GCM (20261014120000). RLS with
/// no arm and no grant: only the app.*webhook_secret* functions touch it.
model IntegrationKeyWebhookSecret {
  keyId              String    @id @db.Uuid
  schoolId           String    @db.Uuid
  ciphertext         Bytes
  iv                 Bytes
  authTag            Bytes
  encKeyId           String
  setAt              DateTime  @default(now()) @db.Timestamptz(6)
  setById            String?   @db.Uuid
  previousCiphertext Bytes?
  previousIv         Bytes?
  previousAuthTag    Bytes?
  previousEncKeyId   String?
  previousValidUntil DateTime? @db.Timestamptz(6)

  @@index([schoolId])
  @@map("IntegrationKeyWebhookSecrets")
}

// -----------------------------------------------------------------------------
// Logga in med skolkonto (20261020090000)
// -----------------------------------------------------------------------------

/// The school-account providers SchemaPro's Supabase project signs in with.
/// The value is Supabase Auth's own provider name.
enum SignInProvider {
  azure
  google
}

/// How a school's people may sign in with their school account (Entra ID or
/// Google Workspace), at most one row per school. No row: passwords only, and
/// the access-token hook (sign_in.custom_access_token_hook) refuses a token
/// to any session that signed in with a school account.
///
/// `domains` is what /login looks a typed address up by
/// (app.sign_in_provider_for_domain); `entraTenantId` and `googleHostedDomain`
/// are what the hook pins every school-account identity of the school's people
/// to. CHECKs in the migration hold the shape: lower-case domains, none of
/// them (nor the hd) a consumer mail domain such as gmail.com, one pin and
/// only the one that belongs to the provider.
model SchoolSignInMethod {
  id                 String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId           String         @unique @db.Uuid
  provider           SignInProvider
  domains            String[]
  entraTenantId      String?        @db.Uuid
  googleHostedDomain String?
  /// Staff (SCHOOL_ADMIN, TEACHER) may then sign in with the school account
  /// only. Off by default (PRODUCT.md, principle 6).
  ssoOnlyForStaff    Boolean        @default(false)
  createdAt          DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime       @updatedAt @db.Timestamptz(6)

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@map("SchoolSignInMethods")
}

// -----------------------------------------------------------------------------
// Notifications (in-app inbox; optionally mirrored to email)
// -----------------------------------------------------------------------------

model Notification {
  id        String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId  String           @db.Uuid
  userId    String           @db.Uuid
  type      NotificationType
  /// Render payload (dates, names, status) — the client localizes per type.
  meta      Json?
  readAt    DateTime?        @db.Timestamptz(6)
  emailedAt DateTime?        @db.Timestamptz(6)
  createdAt DateTime         @default(now()) @db.Timestamptz(6)

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user   User   @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([schoolId])
  /// Gallring's predicate (20261021110000).
  @@index([schoolId, createdAt])
  @@map("Notifications")
}

/// "Do not e-mail or push me this type" (20261013100000). No row = send; the
/// in-app row is always written. Own rows only (RLS); never
/// ABSENCE_UNREPORTED or TEACHER_ABSENCE_REPORTED (CHECKs). The (userId,
/// schoolId) key to Users lives in the migration; the delivery reads the rows
/// through app.delivery_opt_outs.
model NotificationOptOut {
  userId    String           @db.Uuid
  schoolId  String           @db.Uuid
  type      NotificationType
  createdAt DateTime         @default(now()) @db.Timestamptz(6)

  @@id([userId, type])
  @@index([schoolId, type])
  @@map("NotificationOptOuts")
}

enum DevicePlatform {
  IOS
  ANDROID
}

/// One installation of the mobile app that may receive push (20261013110000).
/// UNIQUE(token): a token has one owner, and a registration takes it over.
/// Written only through app.claim_device_push_token; the owner reads and
/// deletes their own rows (RLS). The (userId, schoolId) key to Users, the
/// token-format and locale CHECKs live in the migration.
model DevicePushToken {
  id            String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId      String         @db.Uuid
  userId        String         @db.Uuid
  token         String         @unique
  platform      DevicePlatform
  /// 'sv' or 'en': the language the push is written in.
  locale        String         @default("sv")
  createdAt     DateTime       @default(now()) @db.Timestamptz(6)
  lastSeenAt    DateTime       @default(now()) @db.Timestamptz(6)
  revokedAt     DateTime?      @db.Timestamptz(6)
  /// 'DEVICE_NOT_REGISTERED', set with revokedAt.
  revokedReason String?

  @@unique([id, schoolId])
  @@map("DevicePushTokens")
}

/// An Expo receipt id awaiting its check (at most 24 h). RLS with no arm and
/// no grant: only the app.push_* functions touch it.
model PushTicket {
  id        String    @id
  schoolId  String    @db.Uuid
  tokenId   String    @db.Uuid
  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  claimedAt DateTime? @db.Timestamptz(6)

  @@index([tokenId, schoolId])
  @@map("PushTickets")
}

// -----------------------------------------------------------------------------
// Availability / scheduling constraints (consumed by the OR-Tools engine)
// -----------------------------------------------------------------------------

model AvailabilityConstraint {
  id             String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId       String             @db.Uuid
  resourceType   ConstraintResource
  userId         String?            @db.Uuid
  roomId         String?            @db.Uuid
  studentGroupId String?            @db.Uuid
  // A GRADE_LEVEL constraint has none of the three ids above and this range
  // instead — "håll åk 4-6 fria 11:30-12:15" is a rule about every group whose
  // members sit in those years, and there is no row to point at. Both bounds
  // are 0-12 and ordered; the DB enforces that, plus that they are set for
  // GRADE_LEVEL rows and only for those (see the migration).
  minGradeLevel  Int?
  maxGradeLevel  Int?
  // Either a recurring weekday (1-7) or a one-off `date` may be set.
  dayOfWeek      Int?
  date           DateTime?          @db.Date
  startTime      DateTime           @db.Time(0)
  endTime        DateTime           @db.Time(0)
  type           ConstraintType     @default(UNAVAILABLE)
  reason         String?
  createdAt      DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime           @updatedAt @db.Timestamptz(6)

  school       School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user         User?         @relation("ConstraintTeacher", fields: [userId], references: [id], onDelete: Cascade)
  room         Room?         @relation(fields: [roomId], references: [id], onDelete: Cascade)
  studentGroup StudentGroup? @relation("ConstraintGroup", fields: [studentGroupId], references: [id], onDelete: Cascade)
  /// The uppdrag time this constraint holds, when it is one (migration
  /// 20261017090000): created and deleted by the duties service in the
  /// duty's transaction. Triggers keep it a weekly UNAVAILABLE row of the
  /// duty's own teacher and refuse a TEACHER writing it. The link table
  /// replaced TeacherDuty.blockedConstraintId (gone since 20261022100000).
  teacherDutySlot TeacherDutySlot? @relation("DutySlotConstraint")

  /// The target TeacherDutySlot's composite (availabilityConstraintId,
  /// schoolId) key needs; see User.
  @@unique([id, schoolId])
  @@index([schoolId, dayOfWeek])
  @@index([userId, dayOfWeek])
  @@index([roomId, dayOfWeek])
  @@index([studentGroupId, dayOfWeek])
  @@index([date])
  @@map("AvailabilityConstraints")
}

/// En lärares arbetstid: the lunch a teacher is owed, and the rest between two
/// of their days.
///
/// The counterpart of the table above, and the thing it cannot say. An
/// AvailabilityConstraint with resourceType TEACHER is a teacher CLOSING hours —
/// "jag är ledig på fredagar" — a subtraction from the week the solver may not
/// place anything in. It is the only per-teacher row in the schema, and nothing
/// anywhere says a teacher is OWED something: the model protects pupils with a
/// lunch window per class and a rast per stage, and leaves the adult who walks
/// them there with no meal, no break and no evening.
///
/// HARD RULES, EVERY ONE OF THEM BUT THE WISH. A week that cannot honour a row
/// here is refused, and the refusal names the row. That is why the table exists
/// instead of a weight: a lunch the solver may trade against a fuller Tuesday is
/// not a lunch, it is a preference, and a school reading "schemat är klart" has
/// no way to discover which teacher paid for it. The one preference here is
/// `preferredFreeDayOfWeek`, and its name says it is one.
///
/// EVERY RULE IS OPTIONAL, AND NULL MEANS IT DOES NOT APPLY. A school that has
/// filled in nobody is refused nothing, which is what makes this safe to deploy
/// into every existing database: no row exists, so no week changes. Null is not
/// "zero minutes" and not "the default": there is deliberately no default, since
/// a number nobody chose would start refusing weeks that used to solve.
///
/// ITS OWN TABLE, NOT COLUMNS ON `User`. Two reasons, and either alone decides
/// it. `Users` is the PII table — the fenced block of firstName/lastName/email/
/// phone, masked at the gateway and never sent to the engine — and a scheduling
/// rule the solver reads has no business behind that fence, where every reader
/// has to be trusted with the name beside it. And every other scheduling rule in
/// this schema is already a table of its own: FrameTimes, LunchServings, Rasts,
/// RoomPreferences. A rule on `User` would be the one a developer looking for
/// the rules does not find.
model TeacherWorkRule {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId String @db.Uuid
  /// The teacher. Reached through a composite (id, schoolId) key like every
  /// other reference here, because a foreign-key check runs as the referenced
  /// table's owner with row security OFF — so a userId the caller cannot even
  /// SELECT would still validate, and one school could write a rule about
  /// another school's teacher.
  userId   String @db.Uuid

  /// Minutes of lunch the teacher must get, somewhere inside the window below.
  ///
  /// The trio is all-or-nothing: all three set, or all three null. Half a rule
  /// cannot be read — 30 minutes with no window is a lunch the solver may place
  /// at 07:00, and a window with no length is a window nothing has to happen in.
  /// The DB enforces it, and so does the DTO; see the migration.
  ///
  /// 5..240 and a multiple of 5, because the solver's grid is five minutes wide
  /// and a rule it cannot express is a week that fails forever rather than a bad
  /// request once.
  lunchMinutes        Int?
  /// The earliest the lunch may start and the latest it may end. The window is
  /// at least `lunchMinutes` wide, which the DB checks: a 30-minute lunch inside
  /// a 20-minute window is arithmetic nobody can satisfy, and it would be
  /// refused on every run from then on rather than at the moment it was typed.
  lunchStartTime      DateTime? @db.Time(0)
  lunchEndTime        DateTime? @db.Time(0)

  /// Minutes between the END of the teacher's last lesson one day and the START
  /// of their first the next.
  ///
  /// 60..1320 — an hour at the bottom, twenty-two hours at the top. Null means
  /// the rule does not apply. The bound at the top is what keeps a typo from
  /// being a proof: 1440 minutes of rest is a teacher who can never teach two
  /// days running, and the engine would have to refuse the week to say so.
  minDailyRestMinutes Int?

  /// Lärarens dag (20261123090000): the most minutes of teaching on one day.
  /// HARD where set, like the two rules above. Minutes and not lessons, since
  /// lessons are not one length; every lesson the teacher is on counts, start
  /// to end (src/common/teacher-day.ts). 30..720 and a multiple of 5. Set by an
  /// administrator who writes planering — a trigger keeps it from the teacher's
  /// own write of this row.
  maxTeachingMinutesPerDay Int?
  /// The ISO weekday the teacher would rather have free. SOFT, THE ONE WISH ON
  /// THIS TABLE: the generator pays for a lesson on it and never refuses a
  /// week over it, and the Vikarietavla ranks a cover on it lower. 1..7. Set by
  /// the administrator, like the cap.
  preferredFreeDayOfWeek   Int?

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user   User   @relation("WorkRuleTeacher", fields: [userId, schoolId], references: [id, schoolId], onDelete: Cascade)

  /// One row per teacher. Not per läsår and not per weekday: a person's meal and
  /// a person's night belong to the person, not to the curriculum, and a rule
  /// keyed per year would be missing every August — at exactly the moment a new
  /// timetable is being generated.
  @@unique([userId])
  @@index([schoolId])
  @@map("TeacherWorkRules")
}

// -----------------------------------------------------------------------------
// Tjänstefördelning: the school's policy, a teacher's post, what they may teach
// -----------------------------------------------------------------------------

/// What happens when a staffing write breaks a rule: nothing, a warning in the
/// response, or a 409 naming the rule. Both checks on StaffingPolicy default to
/// WARN so that no existing school is refused anything on deploy.
enum StaffingCheckMode {
  OFF
  WARN
  REFUSE
}

/// MINUTES: a teacher's load is lesson minutes. FACTOR: Skola24's "Faktor
/// ämne" / Untis' subject factor — a teacher is charged lesson minutes ×
/// Subject.loadFactor (Fas 3, teacher-load.ts loadWeightOf).
enum StaffingLoadModel {
  MINUTES
  FACTOR
}

/// Ferietjänst (Bilaga M: 1 767 h a year, 1 360 reglerad on 194 A-dagar) or
/// semestertjänst (an ordinary week with semester). The annual arithmetic
/// differs between them.
enum TeacherContractKind {
  FERIE
  SEMESTER
}

/// Anställningsform as SCB's Pedagogisk personal asks it (AnstForm T and V).
/// Tjänstledig (L) is the post on SCB's mätdatum, read from the nedsättning,
/// not a form of employment. See migration 20261111090000.
enum TeacherEmploymentForm {
  TILLSVIDARE
  VISSTID
}

/// Legitimerad och behörig; behörig utan legitimation; får undervisa enligt
/// rektors beslut (skollagen 2 kap. 18 §). Strongest first — the order the
/// substitute picker ranks candidates in.
enum TeacherQualificationKind {
  LEGITIMATION
  BEHORIG
  TILLATEN
}

/// Whether generation may start with teacherless requirements. Two values, not
/// StaffingCheckMode: there is no meaningful WARN — the generate page shows the
/// count either way.
enum UnstaffedGenerationMode {
  ALLOW
  REFUSE
}

/// What an uppdrag beside teaching is: the Göteborg uppdragsbeskrivning's
/// checkboxes plus what every school has. ANNAT for the rest, named by label.
enum TeacherDutyKind {
  MENTORSKAP
  AMNESANSVAR
  FORSTELARARE
  RASTVAKT
  PEDAGOGISK_LUNCH
  APT_KONFERENS
  VFU_HANDLEDNING
  APL
  ANNAT
}

/// The school's tjänstefördelningsinställning: one row per school, like
/// LunchSetting. See migration 20261006100000 for every bound.
model StaffingPolicy {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId String @db.Uuid

  /// Riktmärke undervisning för en heltid, in minutes per week. NULL, and NO
  /// default: the central agreement fixes no weekly teaching measure, kommuner
  /// differ (Vimmerby 1 080, national median 1 090), and a default would be a
  /// number nobody at the school chose. Null = no load comparison: every
  /// teacher reads NO_TARGET and the over-allocation check is inert. The form
  /// suggests 1 080 with its source.
  fullTimeTeachingMinutesPerWeek Int?
  /// Bilaga M 6 b: reglerad arbetstid for a full ferietjänst. 1..fullTimeAnnualHours.
  fullTimeRegulatedHoursPerYear  Int     @default(1360)
  /// Bilaga M: the whole year of a full ferietjänst. 1..2500.
  fullTimeAnnualHours            Int     @default(1767)
  /// A-dagar. 1..260.
  workDaysPerYear                Int     @default(194)
  /// The week of a semestertjänst. (0, 60].
  semesterHoursPerWeek           Decimal @default(40.0) @db.Decimal(4, 1)

  qualificationMode              StaffingCheckMode @default(WARN)
  overAllocationMode             StaffingCheckMode @default(WARN)
  /// How far over target a teacher may be before overAllocationMode fires. 0..50.
  overAllocationTolerancePercent Int               @default(10)
  loadModel                      StaffingLoadModel @default(MINUTES)
  /// Whether a timetable run may start while a requirement of the year has no
  /// teacher. ALLOW is today's behaviour; REFUSE answers
  /// STAFF_UNSTAFFED_REQUIREMENTS naming group · subject.
  unstaffedGeneration            UnstaffedGenerationMode @default(ALLOW)
  /// Whether GET /ss12000/v1/duties emits dutyPercent and hoursPerYear. Off by
  /// default: see migration 20261010110000.
  shareEmploymentWithIntegrations Boolean @default(false)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  // One row per school; the unique index is the schoolId index.
  @@unique([schoolId])
  @@map("StaffingPolicies")
}

/// A teacher's post for one läsår. Per year, unlike TeacherWorkRule: a
/// tjänstgöringsgrad is renegotiated every year and the load it bounds is the
/// year's requirements. Its own table rather than columns on User because this
/// is HR data with a narrower read arm than any scheduling table — a teacher
/// reads their own row and no colleague's; see the migration's RLS section.
model TeacherEmployment {
  id             String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId       String @db.Uuid
  /// Composite (userId, schoolId) key to Users, like TeacherWorkRule.
  userId         String @db.Uuid
  /// Composite (academicYearId, schoolId) key to AcademicYears.
  academicYearId String @db.Uuid

  /// Tjänstgöringsgrad. (0, 100]. Three decimals because SCB and IST report a
  /// share of a post "upp till tre decimaler".
  employmentPercent            Decimal             @db.Decimal(6, 3)
  /// Nedsättning (partial leave). [0, employmentPercent].
  reductionPercent             Decimal             @default(0) @db.Decimal(6, 3)
  contractKind                 TeacherContractKind @default(FERIE)
  /// Tillsvidare or visstid; null while the school has not said (SCB's AnstForm).
  employmentForm               TeacherEmploymentForm?
  /// Share of the post the förstelärare karriärtjänst takes, 1..100 whole per
  /// cent; null = no förstelärare. With lecturerPercent at most 100 (CHECK).
  firstTeacherPercent          Int?
  /// The same for lektor.
  lecturerPercent              Int?
  /// Per-teacher override of the policy's riktmärke × (employment − reduction)
  /// / 100. Null = derive. 0..2400.
  teachingTargetMinutesPerWeek Int?
  /// Deltid in days (Lärarens dag, 20261123090000): the most weekdays with
  /// teaching the post allows, 1..6; null = no limit. HARD where set, in the
  /// generator, a hand edit's warning and the Vikarietavla. HR data like the
  /// tjänstgöringsgrad: hideHr leaves it out for an administrator without
  /// HR-läs, and no refusal, warning or ranking states it to them. The whole
  /// year's, not a period's: the generator plans one week.
  maxTeachingDaysPerWeek       Int?
  /// Lärarsignatur, 1..8 characters. Unique per school AND YEAR where set — not
  /// per school: the same teacher carries the same signature next year, and a
  /// per-school key would refuse the roll-forward. Prisma cannot state the
  /// partial unique index TeacherEmployments_one_signature_per_year
  /// (schoolId, academicYearId, signature) WHERE signature IS NOT NULL; it
  /// lives in the migration alone, like AcademicYears_one_active_per_school.
  signature                    String?
  /// At most 500 characters.
  note                         String?
  /// A value no integration and no other person ever gets — only the
  /// teacher's own direct read of their own post reaches it, which tells
  /// them nothing they do not know — and which with the post's id and a day
  /// names a changing post's SS12000 Duties after its first (migration
  /// 20261104090000): a reader cannot compute the id of a stretch that was
  /// buried, so /deletedEntities tells nothing of when the grad changed.
  /// Random per post, written once by the default, never after.
  ss12000StretchKey            String              @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  school       School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user         User         @relation("EmploymentTeacher", fields: [userId, schoolId], references: [id, schoolId], onDelete: Cascade)
  academicYear AcademicYear @relation(fields: [academicYearId, schoolId], references: [id, schoolId], onDelete: Cascade)
  /// The post from a date: tjänstgöringsgrad, nedsättning or riktmärke changed
  /// for a stretch of the year (migration 20261022120000). A day no period
  /// covers is this row's.
  periods      TeacherEmploymentPeriod[]

  /// One post per teacher per year; schoolId leads so one school cannot fill
  /// another's slot, and the key doubles as the per-year listing's index.
  @@unique([schoolId, userId, academicYearId])
  /// The target of a period's key, which keeps its owner and year the post's.
  @@unique([id, schoolId, userId, academicYearId])
  @@index([schoolId, academicYearId])
  @@map("TeacherEmployments")
}

/// A stretch of a teacher's post with other figures: "80 % från 1 november".
/// Overrides the base row (TeacherEmployment) on the days it covers; periods
/// of one post never overlap (EXCLUDE), and lie inside the läsår (the service,
/// against the year's bounds read FOR SHARE). States all three figures it
/// carries, not only the ones that change. HR data, read exactly as the post
/// is. See migration 20261022120000.
model TeacherEmploymentPeriod {
  id             String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId       String @db.Uuid
  employmentId   String @db.Uuid
  /// The post's own, kept so by the composite key to TeacherEmployments.
  userId         String @db.Uuid
  academicYearId String @db.Uuid
  /// Från, inclusive.
  validFrom      DateTime @db.Date
  /// Till, inclusive; null = the läsår's last day. Not before validFrom (CHECK).
  validTo        DateTime? @db.Date

  /// (0, 100], three decimals, as on the base row.
  employmentPercent            Decimal @db.Decimal(6, 3)
  /// [0, employmentPercent].
  reductionPercent             Decimal @default(0) @db.Decimal(6, 3)
  /// Own riktmärke for the period, 0..2400; null = derived from the school's.
  teachingTargetMinutesPerWeek Int?

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  school     School            @relation(fields: [schoolId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  employment TeacherEmployment @relation(fields: [employmentId, schoolId, userId, academicYearId], references: [id, schoolId, userId, academicYearId], onDelete: Cascade, onUpdate: Cascade, map: "TeacherEmploymentPeriods_employment_fkey")

  @@index([schoolId, academicYearId])
  @@index([employmentId])
  @@map("TeacherEmploymentPeriods")
}

/// What a teacher may teach: one inclusive grade span per subject ("Ma 1-6"
/// and "Ma 7-9" are written as 1-9). School-owned and not per year, because a
/// legitimation belongs to the person. Readable by all staff (the substitute
/// picker ranks colleagues by it), written by the administrator alone.
model TeacherSubjectQualification {
  id        String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId  String @db.Uuid
  /// Composite (userId, schoolId) key to Users.
  userId    String @db.Uuid
  /// Composite (subjectId, schoolId) key to Subjects; cascades with the subject.
  subjectId String @db.Uuid

  /// 0..12, max >= min — the same inclusive-stage convention as Room,
  /// FrameTime and Rast.
  minGradeLevel Int
  maxGradeLevel Int
  /// No default: which of the three the teacher holds is stated, not presumed.
  kind          TeacherQualificationKind
  /// Tidsbegränsad legitimation. Either alone is legal; both set means
  /// validTo >= validFrom.
  validFrom     DateTime?                @db.Date
  validTo       DateTime?                @db.Date
  /// At most 500 characters.
  note          String?

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  school  School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user    User    @relation("QualificationTeacher", fields: [userId, schoolId], references: [id, schoolId], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId, schoolId], references: [id, schoolId], onDelete: Cascade)

  @@unique([schoolId, userId, subjectId])
  /// The substitute picker asks the other way round: who may teach THIS subject.
  @@index([schoolId, subjectId])
  @@map("TeacherSubjectQualifications")
}

/// Ett uppdrag beside teaching — mentorskap, ämnesansvar, rastvakt, APT — for
/// one teacher in one läsår. HR data: a teacher reads their own and no
/// colleague's, the admin writes, the service principal reads by school. See
/// migration 20261007090000 for every bound, and 20261017090000 for the times.
model TeacherDuty {
  id             String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId       String          @db.Uuid
  /// Composite (userId, schoolId) key to Users; cascades with the person.
  userId         String          @db.Uuid
  /// Composite (academicYearId, schoolId) key to AcademicYears.
  academicYearId String          @db.Uuid
  kind           TeacherDutyKind
  /// "Mentor 7B". Non-blank (the DTO's /\S/, as a CHECK) and at most 80.
  label          String
  /// 1..2400.
  minutesPerWeek Int
  /// True: the minutes consume the teaching target (status, saldo, over
  /// target). False: reported and drawn as uppdrag beside it.
  countsAsTeaching Boolean       @default(false)
  /// Ämnesansvar's subject. ON DELETE SET NULL of this column only.
  subjectId      String?         @db.Uuid
  /// Mentorskap's class. ON DELETE SET NULL of this column only.
  studentGroupId String?         @db.Uuid
  // blockedConstraintId, the one-time column `slots` replaced, was retired by
  // 20261022090000 and dropped by 20261022100000.
  /// At most 500 characters.
  note           String?
  /// Från, inclusive; null = the läsår's first day. Inside the läsår (the
  /// service checks it against the year's bounds, read FOR SHARE).
  validFrom      DateTime?       @db.Date
  /// Till, inclusive; null = the läsår's last day. Not before validFrom (CHECK).
  validTo        DateTime?       @db.Date

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  /// The uppdrag's fixed weekly times, one UNAVAILABLE TEACHER constraint each.
  slots             TeacherDutySlot[]
  school            School                  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user              User                    @relation("DutyTeacher", fields: [userId, schoolId], references: [id, schoolId], onDelete: Cascade)
  academicYear      AcademicYear            @relation(fields: [academicYearId, schoolId], references: [id, schoolId], onDelete: Cascade)
  subject           Subject?                @relation(fields: [subjectId, schoolId], references: [id, schoolId], onDelete: SetNull, onUpdate: NoAction)
  studentGroup      StudentGroup?           @relation(fields: [studentGroupId, schoolId], references: [id, schoolId], onDelete: SetNull, onUpdate: NoAction)

  /// The composite target TeacherDutySlot's key needs.
  @@unique([id, schoolId])
  @@index([schoolId, academicYearId, userId])
  /// "Who holds MENTORSKAP for this class": the mentor lookup and the class's SET NULL.
  @@index([schoolId, studentGroupId, kind])
  @@map("TeacherDuties")
}

/// One fixed weekly time of an uppdrag: the link to the UNAVAILABLE TEACHER
/// AvailabilityConstraint that holds it (migration 20261017090000). The time
/// lives on the constraint; this row is the link and is never updated. The
/// guards keep the constraint a weekly row of the duty's own teacher, a
/// deleted link takes its constraint, and RLS is TeacherDuties' own.
model TeacherDutySlot {
  id                       String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId                 String   @db.Uuid
  teacherDutyId            String   @db.Uuid
  availabilityConstraintId String   @db.Uuid
  createdAt                DateTime @default(now()) @db.Timestamptz(6)

  school                 School                 @relation(fields: [schoolId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  teacherDuty            TeacherDuty            @relation(fields: [teacherDutyId, schoolId], references: [id, schoolId], onDelete: Cascade, onUpdate: NoAction)
  availabilityConstraint AvailabilityConstraint @relation("DutySlotConstraint", fields: [availabilityConstraintId, schoolId], references: [id, schoolId], onDelete: Cascade, onUpdate: NoAction)

  @@unique([availabilityConstraintId, schoolId])
  @@index([teacherDutyId, schoolId])
  @@map("TeacherDutySlots")
}

/// A rastvaktsområde: a place the school watches during the pupils' breaks —
/// skolgården, matsalen, korridoren på plan 2 (migration 20261202090000).
/// Which breaks it is watched in is said here once, and the rastvaktsschema
/// (SupervisionShift) says who watches it when. Not per läsår: like a rast,
/// it describes the building and the yard, not one year's curriculum.
model SupervisionArea {
  id            String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId      String  @db.Uuid
  /// 1..60 characters, trimmed; unique per school.
  name          String
  /// The skolområde the area is on; null = not said. Deleting the site
  /// empties it (ON DELETE SET NULL ("siteId")).
  siteId        String? @db.Uuid
  /// The årskurser whose rasts and lunches the area is watched in, inclusive
  /// 0..12 as a Rast's, in NIOARIG as every school-wide span; both null =
  /// every stage's. Matching is overlap, as for every stage span here.
  minGradeLevel Int?
  maxGradeLevel Int?
  /// Watched while the matching stages have rast (Rast rows).
  duringRasts   Boolean @default(true)
  /// Watched while the matching stages eat (their lunchsittningar, or the
  /// school's lunch window where none speaks about the stage).
  duringLunch   Boolean @default(false)
  /// Rastvakter the area needs at once, 0..10. 0: passes may be planned
  /// here, and no break is warned about as unwatched.
  guardsNeeded  Int     @default(1)
  /// True: a pass here consumes the teaching target, as an uppdrag marked
  /// countsAsTeaching does (rastaktivitet the school counts as undervisning).
  countsAsTeaching Boolean @default(false)
  createdAt     DateTime @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  school School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  site   Site?             @relation(fields: [siteId, schoolId], references: [id, schoolId], onDelete: SetNull, onUpdate: NoAction)
  shifts SupervisionShift[]

  @@unique([schoolId, name])
  /// The target a tenant-scoped composite foreign key needs; see User.
  @@unique([id, schoolId])
  @@index([siteId])
  @@map("SupervisionAreas")
}

/// One pass of the rastvaktsschema: a teacher watches an area on a weekday,
/// from a time to a time, between two dates of a läsår (migration
/// 20261202090000). The time is the pass's own, not a reference to a Rast:
/// a rast moved in March must not rewrite who watched in February, and a
/// pass at the bus at 15:00 belongs to no rast. One person watches one place
/// at a time: two passes of a teacher on one weekday never share a minute
/// on a date both run (EXCLUDE). A teacher reads their own passes and no
/// colleague's; the administrator reads all and planering writes them.
model SupervisionShift {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId       String    @db.Uuid
  /// Composite (academicYearId, schoolId) key to AcademicYears.
  academicYearId String    @db.Uuid
  /// Composite (areaId, schoolId) key to SupervisionAreas; goes with the area.
  areaId         String    @db.Uuid
  /// Composite (userId, schoolId) key to Users; goes with the person.
  userId         String    @db.Uuid
  /// ISO weekday 1..7.
  dayOfWeek      Int
  /// Whole minutes of one day (before 24:00), start before end.
  startTime      DateTime  @db.Time(0)
  endTime        DateTime  @db.Time(0)
  /// Från, inclusive; null = the läsår's first day. Inside the läsår (the
  /// service checks it against the year's bounds, read FOR SHARE).
  validFrom      DateTime? @db.Date
  /// Till, inclusive; null = the läsår's last day. Not before validFrom (CHECK).
  validTo        DateTime? @db.Date
  /// At most 200 characters, trimmed.
  note           String?
  createdAt      DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime  @default(now()) @updatedAt @db.Timestamptz(6)

  school       School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicYear AcademicYear    @relation(fields: [academicYearId, schoolId], references: [id, schoolId], onDelete: Cascade, onUpdate: NoAction)
  area         SupervisionArea @relation(fields: [areaId, schoolId], references: [id, schoolId], onDelete: Cascade, onUpdate: NoAction)
  user         User            @relation("SupervisionShiftTeacher", fields: [userId, schoolId], references: [id, schoolId], onDelete: Cascade, onUpdate: NoAction)

  @@index([academicYearId, schoolId])
  @@index([areaId, schoolId])
  @@index([userId, schoolId])
  @@map("SupervisionShifts")
}

/// What a TeacherEmploymentLog row is about.
enum TeacherLogEntity {
  EMPLOYMENT
  DUTY
  /// A period of a post (migration 20261022110000).
  PERIOD
}

/// What happened to the row: CREATE has only `after`, DELETE only `before`.
enum TeacherLogAction {
  CREATE
  UPDATE
  DELETE
}

/// A tjänst's history: one row per change to a teacher's post or uppdrag,
/// written by a database trigger in the write's own transaction, append-only
/// for every role. HR data: the admin reads all, a teacher their own. See
/// migration 20261010090000 for the trigger, the existence rule and the guards.
model TeacherEmploymentLog {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId       String           @db.Uuid
  /// The teacher the change is about. Composite (userId, schoolId) key.
  userId         String           @db.Uuid
  /// Composite (academicYearId, schoolId) key.
  academicYearId String           @db.Uuid
  /// 1, 2, 3 … per (schoolId, userId, academicYearId); "Version 7" is a citation.
  version        Int
  entity         TeacherLogEntity
  /// The employment's or duty's id. No foreign key: the history outlives the row.
  entityId       String           @db.Uuid
  action         TeacherLogAction
  /// The row before, minus schoolId/createdAt/updatedAt; null on CREATE.
  before         Json?
  /// The row after, likewise; null on DELETE.
  after          Json?
  /// app.current_user_id() of the writer; null for a migration, the seed or the owner.
  actorId        String?          @db.Uuid
  createdAt      DateTime         @default(dbgenerated("clock_timestamp()")) @db.Timestamptz(6)

  school       School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user         User         @relation("EmploymentLogTeacher", fields: [userId, schoolId], references: [id, schoolId], onDelete: Cascade)
  academicYear AcademicYear @relation(fields: [academicYearId, schoolId], references: [id, schoolId], onDelete: Cascade)

  @@unique([schoolId, userId, academicYearId, version], map: "TeacherEmploymentLogs_version_key")
  @@index([entityId])
  @@map("TeacherEmploymentLogs")
}

/// Ramtider: the hours of the day a stage of the school may be taught in.
///
/// The positive twin of an UNAVAILABLE constraint. "Åk 4 does not go on until
/// 17:00" was expressible before only as the holes around the day, two or three
/// rows per weekday per stage, none of which read back as the sentence meant.
///
/// Matching is OVERLAP and every match applies, so a group is bound by the
/// intersection of the frames its years touch. That is what lets a weekday row
/// and an every-day row compose without a precedence rule: "08:00-15:00 always,
/// 08:00-13:00 on Friday" needs no further sentence. dayOfWeek null is every
/// teaching day, as on a constraint. See the migration for the rest.
model FrameTime {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId      String   @db.Uuid
  /// Inclusive, 0-12, both required and ordered — the DB enforces all three.
  minGradeLevel Int
  maxGradeLevel Int
  /// ISO weekday 1-7, or null for every teaching day.
  dayOfWeek     Int?
  startTime     DateTime @db.Time(0)
  endTime       DateTime @db.Time(0)
  /// Minutes a body needs between two lessons: the corridor, not the yard.
  ///
  /// Composes as MAX over matching frames — the opposite of the window, which
  /// intersects — because a changeover is a floor and the widest floor wins.
  /// Zero for every school until somebody writes a number, and the engine skips
  /// the whole mechanism while every matching frame reads zero.
  changeoverMinutes Int   @default(0)
  createdAt     DateTime @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @db.Timestamptz(6)

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, minGradeLevel, maxGradeLevel, dayOfWeek], map: "FrameTimes_schoolId_span_dayOfWeek_key")
  @@index([schoolId, dayOfWeek])
  @@map("FrameTimes")
}

/// Lunchsittningar: the window each stage of the school may eat in.
///
/// The declaration half of the lunch flow. The school states when a stage may
/// eat; the solver decides which class goes when inside that window, splitting
/// a stage too big for the hall into waves through the seat cumulative.
///
/// Windows UNION across spans — the opposite of FrameTime, which intersects —
/// because a serving grants permission where a frame imposes a bound. A
/// day-specific row REPLACES the every-day row for that day, so "alla dagar
/// 12:20-13:00" plus "fredag 11:40-12:20" means Friday is different rather than
/// wider. No unique key: two rows for one stage on one day are two hand-written
/// waves. See the migration for the rest.
model LunchServing {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId      String   @db.Uuid
  /// Inclusive, 0-12, both required and ordered — the DB enforces all three.
  minGradeLevel Int
  maxGradeLevel Int
  /// ISO weekday 1-7, or null for every teaching day.
  dayOfWeek     Int?
  startTime     DateTime @db.Time(0)
  endTime       DateTime @db.Time(0)
  /// Chairs for THIS sitting; null means the hall's own diningSeats.
  seats         Int?
  createdAt     DateTime @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @db.Timestamptz(6)

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId, dayOfWeek])
  @@map("LunchServings")
}

/// Raster: the minutes of a day a stage of the school is NOT taught.
///
/// The declaration, and the whole of it — unlike the meal, which needs a second
/// table because the solver CHOOSES when each class eats. Nothing about a rast
/// is chosen: the school states it, the engine subtracts it from every matching
/// lesson's start domain, and publish dates it. A middle table would store what
/// this row already says, and two copies of "when does åk 4-6 have rast" are two
/// things to disagree.
///
/// Windows UNION across spans and every matching row applies, but the union
/// means the OPPOSITE of a LunchServing's: a serving that matches GRANTS
/// permission, a rast that matches IMPOSES an obligation. A day-specific row
/// shadows only the every-day rows whose window it OVERLAPS — narrower than the
/// serving rule, because several rasts a day are normal and replacing all of
/// them would silently delete a stage's other Friday breaks. No unique key, for
/// the same reason. See the migration for the rest.
model Rast {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId      String   @db.Uuid
  /// What the school calls it, printed on the pupil's band.
  name          String
  /// Inclusive, 0-12, both required and ordered — the DB enforces all three.
  minGradeLevel Int
  maxGradeLevel Int
  /// ISO weekday 1-7, or null for every teaching day.
  dayOfWeek     Int?
  startTime     DateTime @db.Time(0)
  endTime       DateTime @db.Time(0)
  /// Whether the stretch ending at this rast must hold a lesson.
  ///
  /// A rast is otherwise only a hole, and a class whose Monday starts at the
  /// morning break has broken no rule. Counted from the previous break — the
  /// rast before it, or the class's own lunch. See the migration.
  requiresLessonBefore Boolean @default(false)
  createdAt     DateTime @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @db.Timestamptz(6)

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId, dayOfWeek])
  @@map("Rasts")
}

/// A rast as published: one class, one day, one break.
///
/// The dated half of Rast, and the only thing a pupil, guardian or teacher ever
/// reads. Dated rather than derived in the client because a published week has
/// to be a record of that week: a lov makes a Monday differ from the rule, and
/// an admin editing a declaration in March must not rewrite February.
///
/// The name is COPIED, not referenced, for the same reason a CalendarLesson
/// carries its own times rather than reading its template's.
model CalendarRast {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId       String   @db.Uuid
  studentGroupId String   @db.Uuid
  name           String
  date           DateTime @db.Date
  startsAt       DateTime @db.Timestamptz(6)
  endsAt         DateTime @db.Timestamptz(6)
  createdAt      DateTime @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @db.Timestamptz(6)

  school       School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  studentGroup StudentGroup @relation(fields: [studentGroupId, schoolId], references: [id, schoolId], onDelete: Cascade)

  @@unique([studentGroupId, date, startsAt])
  @@index([schoolId, date])
  @@index([studentGroupId, date])
  @@map("CalendarRasts")
}

/// The lunch one class has on one weekday — the solver's choice, or the school's.
///
/// The meal's half of the MasterLesson -> CalendarLesson path. A run replaces
/// the rows the SOLVER wrote (isGenerated) and leaves the ones the school
/// placed by hand; a failed run leaves them all alone. A hand-placed row is
/// sent to the engine as a PIN on the lunch variable it already builds — one
/// reservation, not the fixed lesson beside a live variable that the migration
/// creating this table refused. See 20260911090000.
model LunchSitting {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId       String   @db.Uuid
  academicYearId String   @db.Uuid
  studentGroupId String   @db.Uuid
  /// ISO weekday 1-7. Never null: this is a placement, not a rule.
  dayOfWeek      Int
  startTime      DateTime @db.Time(0)
  endTime        DateTime @db.Time(0)
  /// Children seated, as the engine was told. Kept so the kitchen's list does
  /// not have to re-derive a roster that may have changed since the run.
  headcount      Int      @default(0)
  /// Whether the SOLVER wrote this row. The one thing regeneration may replace,
  /// spelled as MasterLesson spells it, and defaulting false for the same
  /// reason: a creation path that forgets to say is treated as handmade and
  /// survives, which is the error a school can see and undo.
  isGenerated    Boolean  @default(false)
  createdAt      DateTime @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @db.Timestamptz(6)

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  /// Composite, like every other reference here: a foreign-key check runs as
  /// the referenced table's owner with row security OFF, so an id the caller
  /// cannot even SELECT would still validate. The key is what makes a sitting's
  /// group the group of its school.
  academicYear AcademicYear @relation(fields: [academicYearId, schoolId], references: [id, schoolId], onDelete: Cascade)
  studentGroup StudentGroup @relation(fields: [studentGroupId, schoolId], references: [id, schoolId], onDelete: Cascade)

  @@unique([academicYearId, studentGroupId, dayOfWeek], map: "LunchSittings_group_day_key")
  @@index([schoolId, academicYearId])
  @@map("LunchSittings")
}

/// A dated meal, as publish materialises it.
///
/// Its own table rather than a CalendarLesson, because everything downstream of
/// that one assumes teaching: SS12000 would report lunch to the kommun as
/// undervisning, and the absence notice would tell a guardian their child was
/// away from "Lunch". Both are read straight from the browser through PostgREST
/// with no server DTO to filter at, so separation is the only guard that holds.
model CalendarLunch {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId       String   @db.Uuid
  studentGroupId String   @db.Uuid
  date           DateTime @db.Date
  startsAt       DateTime @db.Timestamptz(6)
  endsAt         DateTime @db.Timestamptz(6)
  createdAt      DateTime @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @db.Timestamptz(6)

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  /// Composite, for the same reason as everywhere else in this schema.
  studentGroup StudentGroup @relation(fields: [studentGroupId, schoolId], references: [id, schoolId], onDelete: Cascade)

  @@unique([studentGroupId, date], map: "CalendarLunches_group_date_key")
  @@index([schoolId, date])
  @@index([studentGroupId, date])
  @@map("CalendarLunches")
}

/// Lov och studiedagar: whole days a school does not teach.
///
/// A dated `UNAVAILABLE` constraint could already say "this group cannot be
/// taught on this date", and publish honoured it. What it could not say is
/// "the school is closed all of week 9": a constraint names ONE resource on
/// ONE date, so a sportlov meant a row per day per group, and a läsår's lov
/// and studiedagar together ran past a thousand rows entered by hand. Nothing
/// in `ConstraintResource` means "everybody" either.
///
/// So this is a named RANGE that belongs to the school rather than to a
/// resource. Constraints keep doing what they are good at — one teacher away
/// on a Tuesday, a room closed for two hours — and are untouched by this.
enum BreakKind {
  /// Höstlov, jullov, sportlov, påsklov: nobody is in the building.
  HOLIDAY
  /// Studiedag — pupils are off, staff are working. No lessons either way, but
  /// a teacher's day is not free and a report that counts them apart needs to
  /// know which it was.
  STAFF_DAY
}

model SchoolBreak {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId       String    @db.Uuid
  academicYearId String    @db.Uuid
  /// What the school calls it — "Höstlov", "Studiedag", "Prao åk 9".
  name           String
  kind           BreakKind @default(HOLIDAY)
  /// Inclusive at both ends, so a single day is startDate == endDate.
  startDate      DateTime  @db.Date
  endDate        DateTime  @db.Date
  /// Narrows the break to a span of years, for the cases that are not
  /// school-wide — prao for åk 9, a studiedag for the lower years. Both null
  /// means the whole school, which is what a lov almost always is. Same shape
  /// and same DB checks as AvailabilityConstraint's GRADE_LEVEL rows, because
  /// a year is a property of a group's members and there is no row to point at.
  minGradeLevel  Int?
  maxGradeLevel  Int?
  createdAt      DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @db.Timestamptz(6)

  school       School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  /// Composite, for the same reason every other reference here is: a foreign
  /// key check runs as the referenced table's owner with row security off, so
  /// an id the caller cannot SELECT would still validate. The key is what makes
  /// a break's school the school of its year.
  academicYear AcademicYear @relation(fields: [academicYearId, schoolId], references: [id, schoolId], onDelete: Cascade)

  @@index([schoolId, academicYearId])
  @@index([schoolId, startDate, endDate])
  @@map("SchoolBreaks")
}

/// Lunch, and how many pupils the dining hall can seat at once.
///
/// One row per school (`@@unique([schoolId])`), which is the one scheduling
/// model here that is NOT keyed on `academicYearId`. That is deliberate: the
/// dining hall belongs to the building and the kitchen, not to the curriculum,
/// and its seats do not reset in August. Keyed per year, the setting would be
/// missing every new school year — at exactly the moment publishing is meant
/// to warn that lunch has not been defined.
///
/// `maxLessonsPerDayPerGroup` is not a lunch rule and lives here anyway,
/// because it sits in the same form. Both halves used to live in one browser's
/// `localStorage`, so a second administrator generated the schedule under
/// different rules without knowing it; persisting half the form on the server
/// and leaving the other half in one browser would keep that bug alive for the
/// half that stayed behind.
model LunchSetting {
  id                       String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId                 String   @db.Uuid
  lunchEnabled             Boolean  @default(false)
  lunchStartTime           DateTime @db.Time(0)
  lunchEndTime             DateTime @db.Time(0)
  lunchMinutes             Int
  /// Seats in the dining hall. Null means the school has no seat limit worth
  /// modelling — the solver then places lunch exactly as it did before.
  diningSeats              Int?
  maxLessonsPerDayPerGroup Int?
  createdAt                DateTime @default(now()) @db.Timestamptz(6)
  updatedAt                DateTime @updatedAt @db.Timestamptz(6)

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  // One row per school. No separate @@index([schoolId]) — this unique index
  // already is one, and a second would only be a duplicate to maintain.
  @@unique([schoolId])
  @@map("LunchSettings")
}

enum RoomRuleKind {
  /// Paid for, not required — the solver trades it against everything else.
  WISH
  /// Required. A week that cannot honour it is refused by name.
  LOCK
}

/// Where a subject's lessons belong — as a wish, or as a rule.
///
/// TWO KINDS IN ONE TABLE because they differ in one field and nothing else.
/// A WISH is a price: the solver pays `weight` per lesson placed elsewhere and
/// trades that against its other objectives, so a school gets NO in the lab but
/// not at the cost of a week that cannot be scheduled. A LOCK is a bound: the
/// lesson may go nowhere else, and a week that needs it to is refused by name.
///
/// `Subject.requiredRoomTypeId` is the only other hard room rule and it is
/// school-wide and type-only; `Room.minGradeLevel` fences a room to a stage,
/// which binds that room's every subject. Neither can say "år 4's maths happens
/// in Optimisten 4".
///
/// The optional year span scopes a rule to a stage, matched by CONTAINMENT —
/// the group's whole span inside the rule's. Null means every year, which is
/// what every row written before this column existed means. Locks resolve by
/// specificity (narrowest span wins, ties union); wishes stay additive. The
/// migration argues all of it.
model RoomPreference {
  id         String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId   String       @db.Uuid
  subjectId  String       @db.Uuid
  /// WISH pays a price; LOCK forbids everything else.
  kind       RoomRuleKind @default(WISH)
  /// Inclusive years the rule applies to; both null means every year. The DB
  /// enforces both-or-neither, ordered, and 0-12.
  minGradeLevel Int?
  maxGradeLevel Int?
  /// Either a type…
  roomTypeId String?      @db.Uuid
  /// …or a set of named rooms, via RoomPreferenceRooms. Exactly one of the two
  /// carries the rule; a rule pointing at neither could never be satisfied or
  /// violated.
  ///
  /// Read only for a WISH. Kept NOT NULL rather than nullable-means-hard: the
  /// engine reads `preference.weight or weights.room_preference`, so a falsy
  /// weight would silently become its weakest wish instead of a restriction.
  weight     Int          @default(5)
  createdAt  DateTime @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @db.Timestamptz(6)

  school   School               @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  subject  Subject              @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  roomType RoomType?            @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)
  rooms    RoomPreferenceRoom[]

  @@index([schoolId])
  @@index([schoolId, kind])
  @@map("RoomPreferences")
}

model RoomPreferenceRoom {
  id           String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId     String @db.Uuid
  preferenceId String @db.Uuid
  roomId       String @db.Uuid

  preference RoomPreference @relation(fields: [preferenceId], references: [id], onDelete: Cascade)
  room       Room           @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@unique([preferenceId, roomId])
  @@index([schoolId])
  @@map("RoomPreferenceRooms")
}

// -----------------------------------------------------------------------------
// Vikarieplanering: absences, cover decisions, the substitute pool
// (migrations 20261012090000–20261012120000). The composite (x, schoolId) keys,
// the EXCLUDE on overlapping absences, the CHECKs, the guard triggers and the
// partial unique indexes live in the migrations; Prisma knows only the columns
// the API reads and writes. An absence's reason is read by the admin and the
// absent teacher alone (RLS); nothing else carries it.
// -----------------------------------------------------------------------------

enum TeacherAbsenceStatus {
  ACTIVE
  WITHDRAWN
}

/// The five categories every school starts with; labels are localised by the client.
enum AbsenceReasonBuiltin {
  SICK
  CHILD_CARE
  WORK_TRAVEL
  PROFESSIONAL_DEVELOPMENT
  OTHER
}

enum CoverDecisionKind {
  SUBSTITUTE
  CANCELLED
  SUPERVISED_STUDY
  CO_TEACHER
}

enum CoverPoolPreference {
  PREFER
  NEUTRAL
  LAST_RESORT
}

/// The school's list of absence categories: a built-in or a label, never both.
model TeacherAbsenceReason {
  id         String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId   String                @db.Uuid
  builtin    AbsenceReasonBuiltin?
  label      String?
  sortOrder  Int                   @default(0)
  archivedAt DateTime?             @db.Timestamptz(6)
  createdAt  DateTime              @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime              @default(now()) @updatedAt @db.Timestamptz(6)

  @@unique([id, schoolId])
  @@map("TeacherAbsenceReasons")
}

/// A teacher away over [startsAt, endsAt). Its lessons are derived, never stored.
model TeacherAbsence {
  id                String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId          String               @db.Uuid
  userId            String               @db.Uuid
  startsAt          DateTime             @db.Timestamptz(6)
  endsAt            DateTime             @db.Timestamptz(6)
  wholeDays         Boolean              @default(true)
  /// Null = "ej angiven". Read only by the admin and the absent teacher.
  reasonId          String?              @db.Uuid
  status            TeacherAbsenceStatus @default(ACTIVE)
  createdByUserId   String?              @db.Uuid
  withdrawnAt       DateTime?            @db.Timestamptz(6)
  withdrawnByUserId String?              @db.Uuid
  createdAt         DateTime             @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime             @default(now()) @updatedAt @db.Timestamptz(6)

  @@unique([id, schoolId])
  @@unique([id, userId, schoolId])
  @@index([schoolId, userId, startsAt])
  // TeacherAbsences_schoolId_endsAt_idx (schoolId, endsAt) WHERE reasonId IS
  // NOT NULL, gallring's predicate, lives in 20261021110000 alone.
  @@map("TeacherAbsences")
}

/// One decision per (absence, lesson): what the school did about the lesson.
model TeacherAbsenceCover {
  id               String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId         String            @db.Uuid
  absenceId        String            @db.Uuid
  calendarLessonId String            @db.Uuid
  absentTeacherId  String            @db.Uuid
  /// The CalendarLessonTeachers rows this decision removed: [{teacherId, role}].
  removedTeachers  Json              @default("[]")
  decision         CoverDecisionKind
  /// Audit only; the calendar row is the truth.
  substituteId     String?           @db.Uuid
  previousNote     String?
  decidedByUserId  String?           @db.Uuid
  decidedAt        DateTime          @default(now()) @db.Timestamptz(6)

  @@unique([absenceId, calendarLessonId])
  @@index([calendarLessonId, schoolId])
  @@index([schoolId, decidedAt])
  @@map("TeacherAbsenceCovers")
}

/// One row per school; no row = every default.
model CoverSettings {
  schoolId          String              @id @db.Uuid
  poolPreference    CoverPoolPreference @default(NEUTRAL)
  teacherSelfReport Boolean             @default(false)
  createdAt         DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime            @default(now()) @updatedAt @db.Timestamptz(6)

  @@map("CoverSettings")
}

/// A TEACHER user who covers without (necessarily) a post: a timvikarie.
model SubstitutePoolMember {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId        String   @db.Uuid
  userId          String   @unique @db.Uuid
  createdAt       DateTime @default(now()) @db.Timestamptz(6)
  createdByUserId String?  @db.Uuid

  user User @relation("PoolMemberUser", fields: [userId, schoolId], references: [id, schoolId], onDelete: Cascade)

  @@unique([userId, schoolId])
  @@index([schoolId])
  @@map("SubstitutePoolMembers")
}

/// When a pool member can work: a date or a weekday, a window of the day.
model SubstituteAvailability {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId  String    @db.Uuid
  userId    String    @db.Uuid
  date      DateTime? @db.Date
  dayOfWeek Int?
  startTime DateTime  @db.Time(0)
  endTime   DateTime  @db.Time(0)
  createdAt DateTime  @default(now()) @db.Timestamptz(6)

  @@index([schoolId, userId, date])
  @@map("SubstituteAvailabilities")
}

// -----------------------------------------------------------------------------
// SS12000 consumer: the school's source, its run log and its diff
// (20261014090000-20261014110000). SIS TK450 SS12000 OpenAPI 2.1.0.
// Composite keys, CHECKs, guards and RLS live in the migrations.
// -----------------------------------------------------------------------------

enum GuardianLinkOrigin {
  MANUAL
  SS12000
}

enum Ss12000AuthKind {
  OAUTH2_CLIENT_CREDENTIALS
  BEARER_TOKEN
  MTLS_CLIENT_CERT
}

enum Ss12000TokenAuthStyle {
  BASIC
  FORM
}

enum Ss12000SecretKind {
  CLIENT_SECRET
  BEARER_TOKEN
  CLIENT_KEY_PEM
  CLIENT_CERT_PEM
}

enum Ss12000RunTrigger {
  MANUAL
  SCHEDULED
}

enum Ss12000RunMode {
  FULL
  INCREMENTAL
}

enum Ss12000RunStatus {
  RUNNING
  FETCH_FAILED
  NO_CHANGES
  DIFF_READY
  APPLIED
  APPLY_FAILED
  DISCARDED
  SUPERSEDED
  SKIPPED
}

enum Ss12000ChangeEntity {
  PERSON
  GROUP
  CLASS_MEMBERSHIP
  GROUP_MEMBERSHIP
  RESPONSIBLE
  DUTY_LINK
  ORGANISATION
}

enum Ss12000ChangeOp {
  CREATE
  LINK
  RELINK
  UPDATE
  MOVE
  DEACTIVATE
  REACTIVATE
  ADD
  END
  CONFLICT
  INFO
}

/// The school's SS12000 provider (one per school). No secret lives here:
/// credentials are Ss12000SourceSecrets, reachable only through functions.
model Ss12000Source {
  id                     String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId               String                @unique @db.Uuid
  name                   String
  /// https, up to and including the provider's "/v2.0"; no userinfo, query or fragment.
  baseUrl                String
  authKind               Ss12000AuthKind
  tokenUrl               String?
  clientId               String?
  tokenScope             String?
  tokenAuthStyle         Ss12000TokenAuthStyle @default(BASIC)
  /// The source's skolenhet ids this school is, 0..5.
  organisationIds        String[]              @default([]) @db.Uuid
  schoolUnitCodes        String[]              @default([])
  pageSize               Int                   @default(1000)
  enabled                Boolean               @default(true)
  scheduleEnabled        Boolean               @default(false)
  scheduleAutoApply      Boolean               @default(false)
  scheduleHourLocal      Int                   @default(2)
  fullEveryDays          Int                   @default(7)
  incrementalUnsupported Boolean               @default(false)
  modifiedCursor         DateTime?             @db.Timestamptz(6)
  deletedCursor          DateTime?             @db.Timestamptz(6)
  lastFullAt             DateTime?             @db.Timestamptz(6)
  lastAppliedAt          DateTime?             @db.Timestamptz(6)
  lastTestedAt           DateTime?             @db.Timestamptz(6)
  lastTestOutcome        String?
  schedulerClaimedAt     DateTime?             @db.Timestamptz(6)
  lastScheduledLocalDate DateTime?             @db.Date
  createdById            String?               @db.Uuid
  createdAt              DateTime              @default(now()) @db.Timestamptz(6)
  updatedAt              DateTime              @default(now()) @updatedAt @db.Timestamptz(6)

  @@unique([id, schoolId])
  @@map("Ss12000Sources")
}

/// One encrypted credential (AES-256-GCM). RLS with no arm and no grant:
/// only the app.ss12000_*secret* functions touch it.
model Ss12000SourceSecret {
  sourceId   String            @db.Uuid
  schoolId   String            @db.Uuid
  kind       Ss12000SecretKind
  ciphertext Bytes
  iv         Bytes
  authTag    Bytes
  keyId      String
  setAt      DateTime          @default(now()) @db.Timestamptz(6)
  setById    String?           @db.Uuid

  @@id([sourceId, kind])
  @@map("Ss12000SourceSecrets")
}

/// Which source Duty a person holds in a läsår. No HR figure.
model Ss12000DutyLink {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId       String    @db.Uuid
  userId         String    @db.Uuid
  academicYearId String    @db.Uuid
  ss12000DutyId  String    @db.Uuid
  /// S1's DutyRole, spelled as S1 spells it.
  dutyRole       String
  startDate      DateTime  @db.Date
  endDate        DateTime? @db.Date
  /// Set when the duty ended or was deleted at the source; the row stays.
  endedAt        DateTime? @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime  @default(now()) @updatedAt @db.Timestamptz(6)

  @@unique([schoolId, academicYearId, ss12000DutyId])
  @@index([userId, schoolId])
  @@map("Ss12000DutyLinks")
}

/// Every guardian unlink, written by an AFTER DELETE trigger on
/// GuardianStudents; ids only.
model GuardianStudentHistory {
  id           String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId     String             @db.Uuid
  guardianId   String             @db.Uuid
  studentId    String             @db.Uuid
  origin       GuardianLinkOrigin
  linkedAt     DateTime           @db.Timestamptz(6)
  unlinkedAt   DateTime           @default(now()) @db.Timestamptz(6)
  unlinkedById String?            @db.Uuid

  @@index([schoolId, studentId])
  /// Gallring's predicate (20261021110000).
  @@index([schoolId, unlinkedAt])
  @@map("GuardianStudentHistory")
}

/// One run of the sync: the log, newest first in Synkhistorik.
model Ss12000SyncRun {
  id                     String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId               String            @db.Uuid
  sourceId               String            @db.Uuid
  trigger                Ss12000RunTrigger
  mode                   Ss12000RunMode
  status                 Ss12000RunStatus  @default(RUNNING)
  statusCode             String?
  requestedById          String?           @db.Uuid
  startedAt              DateTime          @default(now()) @db.Timestamptz(6)
  fetchedAt              DateTime?         @db.Timestamptz(6)
  finishedAt             DateTime?         @db.Timestamptz(6)
  appliedAt              DateTime?         @db.Timestamptz(6)
  appliedById            String?           @db.Uuid
  autoApplied            Boolean           @default(false)
  providerClock          DateTime?         @db.Timestamptz(6)
  cursorFromModified     DateTime?         @db.Timestamptz(6)
  cursorFromDeleted      DateTime?         @db.Timestamptz(6)
  cursorTo               DateTime?         @db.Timestamptz(6)
  /// Ids and numbers only.
  counts                 Json              @default("{}")
  /// [{code, entity, externalId?}], at most 200.
  errors                 Json              @default("[]")
  basisHash              String?
  autoApplyBlockedReason String?

  @@unique([id, schoolId])
  @@index([schoolId, startedAt(sort: Desc)])
  @@map("Ss12000SyncRuns")
}

/// One change a run proposes. before/after hold names and emails only while
/// the run is DIFF_READY; a trigger nulls them on every other status.
model Ss12000SyncChange {
  id                String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  runId             String              @db.Uuid
  schoolId          String              @db.Uuid
  seq               Int
  entity            Ss12000ChangeEntity
  op                Ss12000ChangeOp
  externalId        String?             @db.Uuid
  localId           String?             @db.Uuid
  before            Json?
  after             Json?
  conflictCode      String?
  selected          Boolean
  autoApplicable    Boolean             @default(false)
  protectedIdentity Boolean             @default(false)
  applied           Boolean             @default(false)
  createdAt         DateTime            @default(now()) @db.Timestamptz(6)

  @@unique([runId, seq])
  @@index([runId, schoolId])
  @@map("Ss12000SyncChanges")
}

/// When an object the SS12000 v2.0 provider emits last changed
/// (20261014130000): one row per (school, resource, entity), written only by
/// statement-level triggers. xid is the changing transaction's id, the
/// webhook delivery's watermark; Prisma cannot read the type.
model Ss12000EntityVersion {
  schoolId   String                 @db.Uuid
  resource   String
  entityId   String                 @db.Uuid
  createdAt  DateTime               @default(now()) @db.Timestamptz(6)
  modifiedAt DateTime               @default(now()) @db.Timestamptz(6)
  xid        Unsupported("xid8")    @default(dbgenerated("pg_current_xact_id()"))

  @@id([schoolId, resource, entityId])
  @@index([schoolId, resource, modifiedAt], map: "Ss12000EntityVersions_modified_idx")
  @@index([schoolId, xid], map: "Ss12000EntityVersions_xid_idx")
  @@map("Ss12000EntityVersions")
}

/// An id the provider no longer emits (/deletedEntities), keyed by the id
/// the consumer was given; written only by the same triggers, kept 400 days.
/// 'AdhocActivity' rows hold a lesson id the gateway turns into its UUIDv5.
model Ss12000Tombstone {
  schoolId  String              @db.Uuid
  resource  String
  emittedId String              @db.Uuid
  removedAt DateTime            @default(now()) @db.Timestamptz(6)
  xid       Unsupported("xid8") @default(dbgenerated("pg_current_xact_id()"))

  @@id([schoolId, resource, emittedId])
  @@index([schoolId, removedAt], map: "Ss12000Tombstones_removedAt_idx")
  @@index([schoolId, xid], map: "Ss12000Tombstones_xid_idx")
  @@map("Ss12000Tombstones")
}

/// An S1 subscription (POST /ss12000/v2.0/subscriptions) of one key. The
/// delivery columns are written by the app.ss12000_*notification* functions.
model Ss12000Subscription {
  id              String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId        String              @db.Uuid
  keyId           String              @db.Uuid
  name            String
  target          String
  resourceTypes   String[]
  expiresAt       DateTime            @default(dbgenerated("(now() + '30 days'::interval)")) @db.Timestamptz(6)
  endedAt         DateTime?           @db.Timestamptz(6)
  suspendedAt     DateTime?           @db.Timestamptz(6)
  /// FAILING (72 h of failed deliveries) or ADMIN (the school paused it).
  suspendedReason String?
  watermark       Unsupported("xid8") @default(dbgenerated("pg_snapshot_xmin(pg_current_snapshot())"))
  lastNotifiedAt  DateTime?           @db.Timestamptz(6)
  nextAttemptAt   DateTime            @default(now()) @db.Timestamptz(6)
  attempts        Int                 @default(0)
  failingSince    DateTime?           @db.Timestamptz(6)
  claimedAt       DateTime?           @db.Timestamptz(6)
  createdAt       DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime            @default(now()) @updatedAt @db.Timestamptz(6)

  @@unique([id, schoolId])
  @@index([keyId, schoolId], map: "Ss12000Subscriptions_key_idx")
  @@map("Ss12000Subscriptions")
}

/// One delivery attempt: status, outcome code and duration, no body and no
/// header. Kept 30 days.
model Ss12000SubscriptionDelivery {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId       String   @db.Uuid
  subscriptionId String   @db.Uuid
  attemptedAt    DateTime @default(now()) @db.Timestamptz(6)
  httpStatus     Int?
  outcome        String
  durationMs     Int

  @@index([subscriptionId, schoolId, attemptedAt], map: "Ss12000SubscriptionDeliveries_subscription_idx")
  @@index([attemptedAt], map: "Ss12000SubscriptionDeliveries_attemptedAt_idx")
  @@map("Ss12000SubscriptionDeliveries")
}

// -----------------------------------------------------------------------------
// Drift: the job runner and gallring (20261021090000, 20261021110000)
// -----------------------------------------------------------------------------

/// One row per job and UTC day: how many ticks ran and failed, and the passes'
/// counts summed key by key. Counts only (CHECKs in the migration). Row
/// security with no arm and no grant: only app.job_run_settled and
/// app.job_runs_latest touch it.
model JobRun {
  job            String
  day            DateTime  @db.Date
  runs           Int       @default(0)
  failures       Int       @default(0)
  counts         Json      @default("{}")
  lastStartedAt  DateTime  @db.Timestamptz(6)
  lastFinishedAt DateTime  @db.Timestamptz(6)
  lastFailedAt   DateTime? @db.Timestamptz(6)
  /// An error class name, never a message.
  lastError      String?

  @@id([job, day])
  @@map("JobRuns")
}

/// A school's nightly job, claimed once per local day by one API instance
/// (app.job_claim_nightly). The key to Schools lives in the migration. No
/// grant: only the app.job_claim_* functions touch it.
model JobClaim {
  job        String
  schoolId   String    @db.Uuid
  day        DateTime  @db.Date
  claimedAt  DateTime  @db.Timestamptz(6)
  finishedAt DateTime? @db.Timestamptz(6)

  @@id([job, schoolId, day])
  @@index([schoolId])
  @@map("JobClaims")
}

/// The kinds of data a school sets a retention period for (/admin/dataskydd).
enum RetentionDataType {
  ATTENDANCE
  ABSENCE_REPORTS
  LEAVE_REQUESTS
  NOTIFICATIONS
  CHANGE_LOGS
  ABSENCE_REASONS
  DEPARTED_PEOPLE
  /// The read log, PersonalDataAccess (20261026090000).
  ACCESS_LOG
}

/// PURGE_AFTER `months`; KEEP (bevaras); UNDECIDED (back to ej beslutat).
enum RetentionDecisionKind {
  PURGE_AFTER
  KEEP
  UNDECIDED
}

enum GallringRunStatus {
  RUNNING
  DONE
  INTERRUPTED
}

/// The school's decision whether integrations (SS12000 v2.0, scopes
/// attendances.read and absences.read) may read pupils' attendance and
/// absence (20261114090000). Append-only like LeaveDelegationDecision: a
/// trigger stamps decidedAt and decidedById and refuses UPDATE and DELETE, so
/// the latest row is in force; no row is not shared. The keys to Schools and
/// to Users (decidedById, ON DELETE SET NULL of that column alone) live in
/// the migration. The school's administrators read and insert (RLS, the API's
/// role only).
model AttendanceSharingDecision {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId    String   @db.Uuid
  shares      Boolean
  /// The school's konsekvensbedömning or decision (dnr), at most 200 characters.
  reference   String?
  decidedById String?  @db.Uuid
  decidedAt   DateTime @default(dbgenerated("clock_timestamp()")) @db.Timestamptz(6)
  /// The transaction the decision was written in, stamped by the database: the
  /// webhook delivery's snapshot rule for telling a start; Prisma cannot read the type.
  xid         Unsupported("xid8") @default(dbgenerated("pg_current_xact_id()"))
  /// When the decision took effect, stamped by the database as its transaction
  /// commits; a stop dates what may have left by it.
  committedAt DateTime? @db.Timestamptz(6)

  @@index([schoolId, decidedAt(sort: Desc)])
  @@map("AttendanceSharingDecisions")
}

/// Rektor's delegation of leave decisions (skollagen 2 kap. 10 §, 7 kap. 18 §):
/// the mentor decides a request of at most mentorMaxSchoolDays skoldagar (1..10;
/// NULL, and no row at all, is no delegation: the admin decides everything).
/// Append-only like RetentionDecision: a trigger stamps decidedAt and
/// decidedById and refuses UPDATE and DELETE, so the latest row is in force.
/// The keys to Schools and to Users (decidedById, ON DELETE SET NULL of that
/// column alone) live in 20261023091000. The school's staff read it and the
/// administrator inserts (RLS, the API's role only).
model LeaveDelegationDecision {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId            String   @db.Uuid
  mentorMaxSchoolDays Int?
  /// The delegationsordning's reference (dnr), at most 200 characters.
  reference           String?
  decidedById         String?  @db.Uuid
  decidedAt           DateTime @default(dbgenerated("clock_timestamp()")) @db.Timestamptz(6)

  @@index([schoolId, decidedAt(sort: Desc)])
  @@map("LeaveDelegationDecisions")
}

/// A mentor told of a leave request (LEAVE_REQUESTED), once per request and
/// mentor (20261101090000). app.leave_tell_mentors writes the row before the
/// notice, so a notice gallring deletes is never owed again; the row goes
/// with its request. The keys to LeaveRequests and to Users (userId,
/// schoolId), both ON DELETE CASCADE, live in the migration. Row security
/// with no policy: no API role reads or writes it.
model LeaveRequestNotice {
  leaveRequestId String   @db.Uuid
  userId         String   @db.Uuid
  schoolId       String   @db.Uuid
  toldAt         DateTime @default(now()) @db.Timestamptz(6)

  @@id([leaveRequestId, userId])
  @@index([userId, schoolId])
  @@map("LeaveRequestNotices")
}

/// A person's calendar feed (Kalenderprenumeration, 20261112091000): their
/// published week, or a guardian's child's, behind a secret address of which
/// only the sha256 is kept. At most one live feed per week a person may have;
/// a new one revokes the old. The owner reads their own rows through the API;
/// only the definer functions write (app.calendar_feed_create, _revoke, the
/// settings', people's and links' triggers, and the door, which marks a feed
/// used, records a guardian's day and ends a feed it refuses). The keys to
/// Schools and to Users (userId and studentId, with schoolId, ON DELETE
/// CASCADE) live in the migration.
model CalendarFeed {
  id         String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId   String               @db.Uuid
  userId     String               @db.Uuid
  /// The pupil whose week it is: the owner for a STUDENT feed, the child for a GUARDIAN's, null for a TEACHER's.
  studentId  String?              @db.Uuid
  audience   CalendarFeedAudience
  tokenHash  String               @unique
  /// "sv" or "en": the language the feed speaks.
  locale     String               @default("sv")
  createdAt  DateTime             @default(now()) @db.Timestamptz(6)
  revokedAt  DateTime?            @db.Timestamptz(6)
  lastUsedAt DateTime?            @db.Timestamptz(6)
  /// The school day a guardian's feed was last written to the read log.
  recordedOn DateTime?            @db.Date

  @@index([userId, schoolId])
  @@index([studentId, schoolId])
  @@map("CalendarFeeds")
}

enum CalendarFeedAudience {
  TEACHER
  STUDENT
  GUARDIAN
}

/// A school's decision on how long one kind of data is kept. Append-only: a
/// trigger stamps decidedAt and decidedById and refuses UPDATE and DELETE, so
/// the rows are the history and the latest per kind is the decision. No row
/// is "ej beslutat". The keys to Schools and to Users (decidedById, ON DELETE
/// SET NULL of that column alone) live in the migration. The administrator
/// reads and inserts (RLS); app.retention_months_in_force says what a run
/// may apply: a change that gallrar more waits 24 hours.
model RetentionDecision {
  id          String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId    String                @db.Uuid
  dataType    RetentionDataType
  decision    RetentionDecisionKind
  /// 1..120, set exactly when decision is PURGE_AFTER.
  months      Int?
  /// The dokumenthanteringsplan's reference, at most 200 characters.
  reference   String?
  decidedById String?               @db.Uuid
  decidedAt   DateTime              @default(dbgenerated("clock_timestamp()")) @db.Timestamptz(6)

  @@index([schoolId, dataType, decidedAt(sort: Desc)])
  @@map("RetentionDecisions")
}

/// What a read of another person's personal data is recorded as (Läslogg).
enum PersonalDataAccessKind {
  PEOPLE
  ROSTER
  ATTENDANCE
  ABSENCE_REPORTS
  LEAVE_REQUESTS
  LEAVE_REASON_AS_MENTOR
  GUARDIANS
  EMPLOYMENT
  STAFF_ABSENCES
  ACCESS_LOG
  SCHEDULE
  TEACHING_TIME
}

/// The client a read came through; INTEGRATION for an SS12000 key.
enum PersonalDataAccessChannel {
  WEB
  APP
  INTEGRATION
  OTHER
  /// A guardian's calendar feed of their child (20261112090000).
  CALENDAR
}

/// Läsloggen (20261026091000): one row per request that returned other
/// people's personal data, per kind. Who read (actorId and the role then, or
/// the integration key), through which client, what kind, and the ids of the
/// people read about, never the reader themself. Append-only by trigger; only
/// app.personal_data_read writes it, from the read's own transaction, leaving
/// out whoever the same reader read of that kind in the last 15 minutes. The
/// school's administrator reads it through the gateway; ACCESS_LOG is its
/// Gallring kind. The keys to Schools, Users and IntegrationApiKeys live in
/// the migration.
model PersonalDataAccess {
  id         String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId   String                    @db.Uuid
  at         DateTime                  @default(dbgenerated("clock_timestamp()")) @db.Timestamptz(6)
  actorId    String?                   @db.Uuid
  actorRole  UserRole?
  apiKeyId   String?                   @db.Uuid
  channel    PersonalDataAccessChannel
  kind       PersonalDataAccessKind
  subjectIds String[]                  @db.Uuid
  /// How many people of the school the read named, the reader aside, before
  /// the dedupe left out those already recorded: subjectIds is a subset.
  readSize   Int

  @@index([subjectIds], type: Gin)
  @@index([schoolId, at])
  @@map("PersonalDataAccess")
}

/// One night's gallring of one school: the periods and cutoffs applied and,
/// per kind, how many rows or people went, whether nothing past the cutoff
/// was left, and how many were held back. Counts only (CHECK in the
/// migration). The administrator reads it; only the app.gallring_*
/// functions write it. The key to Schools lives in the migration.
model GallringRun {
  id         String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId   String            @db.Uuid
  localDay   DateTime          @db.Date
  status     GallringRunStatus @default(RUNNING)
  startedAt  DateTime          @db.Timestamptz(6)
  finishedAt DateTime?         @db.Timestamptz(6)
  periods    Json              @default("{}")
  cutoffs    Json              @default("{}")
  counts     Json              @default("{}")
  complete   Json              @default("{}")
  waiting    Json              @default("{}")

  @@index([schoolId, startedAt(sort: Desc)])
  @@map("GallringRuns")
}
