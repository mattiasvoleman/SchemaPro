{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    // ts-jest transpiles per-file; this makes tsc enforce the same constraints
    // it compiles under, so `npm run typecheck:test` catches what jest can't.
    "isolatedModules": true,
    "types": ["jest", "node"]
  },
  "include": ["**/*.ts", "../src/**/*.ts"],
  // Its own, because an `exclude` is inherited whole: the root's leaves out
  // `test` and `src/**/*.spec.ts`, the very files this config exists to check,
  // and under it this typecheck saw neither. Nothing the includes reach needs
  // leaving out.
  "exclude": []
}
