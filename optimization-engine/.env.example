# =============================================================================
# SchemaPro — Optimization Engine — Environment Variables
# =============================================================================
# Copy this file to .env and populate it for your environment.
# NEVER commit a populated .env to version control.

# ---------------------------------------------------------------------------
# Service identity
# ---------------------------------------------------------------------------
APP_ENV=production            # production | staging | development | local
LOG_LEVEL=INFO                # DEBUG | INFO | WARNING | ERROR | CRITICAL

# ---------------------------------------------------------------------------
# Network
# ---------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000

# ---------------------------------------------------------------------------
# Service-to-service authentication
# The NestJS gateway must pass this value in the X-API-Key header on every
# request.  Generate a cryptographically random value (e.g. openssl rand -hex 32).
# ---------------------------------------------------------------------------
API_KEY=                      # REQUIRED — min 32 chars (e.g. `openssl rand -hex 32`); service will not start otherwise

# Per-client request cap (fixed 60s window). Health checks are exempt.
RATE_LIMIT_PER_MINUTE=120

# ---------------------------------------------------------------------------
# CORS — only the NestJS backend origin should be listed here.
# Comma-separated list for multi-host internal deployments.
# ---------------------------------------------------------------------------
ALLOWED_ORIGINS=http://nestjs-backend:3000

# ---------------------------------------------------------------------------
# Scheduling grid
# ---------------------------------------------------------------------------
SCHEDULE_DAYS=1,2,3,4,5           # ISO weekday numbers (1=Mon … 7=Sun)
SCHEDULE_DAY_START_MINUTES=480    # 08:00 expressed as minutes-from-midnight
SCHEDULE_DAY_END_MINUTES=1080     # 18:00 expressed as minutes-from-midnight
SLOT_MINUTES=5                    # Time-grid granularity; must divide 60 evenly.
                                  # 5 admits 40- and 50-minute lessons; 15 does not.

# ---------------------------------------------------------------------------
# CP-SAT Solver
#
# Raising these means raising the API's AI_ENGINE_TIMEOUT_MS to match: the API
# cuts the HTTP call off at its own deadline, so a solve allowed more time here
# than the caller waits there is time the solver spends on an answer nobody
# receives. A solve that times out answers after SOLVER_MAX_TIME_SECONDS plus
# SOLVER_PROBE_SECONDS, so the API's timeout must exceed their sum.
#
# SOLVER_TIMEOUT_SECONDS no longer exists (nothing ever read it); an old
# deployment that sets it is ignored. SOLVER_MAX_TIME_SECONDS is the budget.
# ---------------------------------------------------------------------------
SOLVER_MAX_TIME_SECONDS=60        # The budget: wall-clock seconds per generation (> 0)
SOLVER_PROBE_SECONDS=20           # Spent after a TIMEOUT naming a rule that did not fit (0 = off)
ROOM_SOLVER_MAX_TIME_SECONDS=10   # Room optimisation (POST /api/v1/optimize-rooms).
                                  # Stopping early only shrinks the improvement:
                                  # the current rooms are always a valid answer.

# ---------------------------------------------------------------------------
# Soft-constraint weights
# Higher = stronger preference enforcement in the objective function
# ---------------------------------------------------------------------------
WEIGHT_PREFERRED_FREE_VIOLATION=10   # Penalty when a lesson lands in a PREFERRED_FREE window
WEIGHT_PREFERRED_BUSY_VIOLATION=5    # Penalty when a lesson misses a PREFERRED_BUSY window
