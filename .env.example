# ---------------------------------------------------------------------------
# Database connection (NEVER commit the real .env — see .gitignore)
# Use a pooled connection string for the app and a direct one for migrations.
# Credentials are injected at runtime via the environment / secrets manager.
#
# IMPORTANT: the app MUST connect as the least-privilege `app_authenticated`
# role (created by the migration) so that Row-Level Security is enforced on
# every query. Never connect as a superuser or the table owner.
# ---------------------------------------------------------------------------

# Runtime connection used by the NestJS app (PgBouncer / pooled).
# sslmode: pg, Prisma 7's driver, uses TLS only when the URL asks for it, and
# without sslmode it connects unencrypted. require + uselibpqcompat=true
# encrypts without verifying the certificate, as Prisma 5 did. verify-full with
# sslrootcert=<CA file> verifies it too. A bare require means verify-full to pg
# (docs/DEPLOYMENT.md §3).
DATABASE_URL="postgresql://app_authenticated:PASSWORD@HOST:6543/schemapro?schema=public&pgbouncer=true&connection_limit=1&sslmode=require&uselibpqcompat=true"

# DIRECT_URL — the OWNER's direct, non-pooled connection, used only by
# `prisma migrate` and `npm run db:seed`, never by the API. Neither reads this
# file: the Prisma CLI no longer loads .env, so give it on the command, e.g.
#   DIRECT_URL="postgresql://postgres:PASSWORD@HOST:5432/schemapro?sslmode=require&uselibpqcompat=true" npm run migrate:deploy
# Left commented out so owner credentials do not sit next to the app's.
# DIRECT_URL="postgresql://postgres:PASSWORD@HOST:5432/schemapro?schema=public&sslmode=require&uselibpqcompat=true"

# ---------------------------------------------------------------------------
# HTTP server
# ---------------------------------------------------------------------------
NODE_ENV="development"
PORT="4000"
# Comma-separated list of allowed CORS origins (web + mobile).
# The first origin is also used as the base URL for Supabase invite links.
CORS_ORIGINS="http://localhost:3000,http://localhost:19006"

# ---------------------------------------------------------------------------
# JWT verification.
# JWT_ISSUER is REQUIRED: Supabase signs access tokens with a rotating ES256
# key, and the API fetches the public half from <JWT_ISSUER>/.well-known/jwks.json.
# It must be "https://<project-ref>.supabase.co/auth/v1".
# JWT_SECRET only verifies first-party HS256 service tokens (see scripts/bench);
# Supabase user tokens no longer use it.
# ---------------------------------------------------------------------------
JWT_SECRET="replace-with-your-supabase-jwt-secret"
JWT_ISSUER="https://your-project.supabase.co/auth/v1"
JWT_AUDIENCE="authenticated"

# ---------------------------------------------------------------------------
# Supabase Admin API (identity lifecycle only: invite / delete auth users).
# The service-role key bypasses RLS — it must NEVER be exposed to clients
# and is only used server-side by the users module.
# Leave empty to disable invitations (users are then catalog-only).
# ---------------------------------------------------------------------------
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""

# ---------------------------------------------------------------------------
# Python AI engine (FastAPI + OR-Tools). Only anonymized payloads are sent.
#
# AI_ENGINE_TIMEOUT_MS must exceed the engine's own SOLVER_TIMEOUT_SECONDS
# (60s in optimization-engine/.env.example). The API enforces it as a hard
# deadline, so anything shorter turns every solve that runs its full budget
# into a 503 the operator cannot tell apart from the engine being down.
# ---------------------------------------------------------------------------
AI_ENGINE_URL="http://localhost:8000"
AI_ENGINE_API_KEY="replace-with-the-shared-service-api-key"
AI_ENGINE_TIMEOUT_MS="90000"

# ---------------------------------------------------------------------------
# Rate limiting (protects the attendance endpoint during morning peak).
# Leave REDIS_URL empty to fall back to in-memory throttling (single instance).
# ---------------------------------------------------------------------------
THROTTLE_TTL_SECONDS="60"
THROTTLE_LIMIT="120"
REDIS_URL=""
