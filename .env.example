# ---------------------------------------------------------------------------
# Database connection (NEVER commit the real .env — see .gitignore)
# Use a pooled connection string for the app and a direct one for migrations.
# Credentials are injected at runtime via the environment / secrets manager.
#
# IMPORTANT: the app MUST connect as the least-privilege `app_authenticated`
# role (created by the migration) so that Row-Level Security is enforced on
# every query. Never connect as a superuser or the table owner.
# ---------------------------------------------------------------------------

# Runtime connection used by the NestJS app (PgBouncer / pooled).
DATABASE_URL="postgresql://app_authenticated:PASSWORD@HOST:6543/schemapro?schema=public&pgbouncer=true&connection_limit=1"

# Direct, non-pooled connection used only by `prisma migrate`.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/schemapro?schema=public"

# ---------------------------------------------------------------------------
# HTTP server
# ---------------------------------------------------------------------------
NODE_ENV="development"
PORT="3000"
# Comma-separated list of allowed CORS origins (web + mobile).
CORS_ORIGINS="http://localhost:3001,http://localhost:19006"

# ---------------------------------------------------------------------------
# JWT verification (tokens are minted by the auth/identity provider).
# Use an asymmetric public key in production; HS256 secret shown for local dev.
# ---------------------------------------------------------------------------
JWT_SECRET="replace-with-a-long-random-secret-in-local-dev-only"
JWT_ISSUER="https://auth.schemapro.example"
JWT_AUDIENCE="schemapro-api"

# ---------------------------------------------------------------------------
# Python AI engine (FastAPI + OR-Tools). Only anonymized payloads are sent.
# ---------------------------------------------------------------------------
AI_ENGINE_URL="http://localhost:8000"
AI_ENGINE_API_KEY="replace-with-the-shared-service-api-key"
AI_ENGINE_TIMEOUT_MS="15000"

# ---------------------------------------------------------------------------
# Rate limiting (protects the attendance endpoint during morning peak).
# Leave REDIS_URL empty to fall back to in-memory throttling (single instance).
# ---------------------------------------------------------------------------
THROTTLE_TTL_SECONDS="60"
THROTTLE_LIMIT="120"
REDIS_URL=""
